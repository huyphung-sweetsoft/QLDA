<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="resizer" type="ImageResizer.ResizerSection" requirePermission="false" />
		<section name="SubSonicService" type="SubSonic.SubSonicSection, SubSonic" requirePermission="false" />
	</configSections>

	<connectionStrings>
		<remove name="SweetSoft.QLDA.BackOffice" />
		<add name="SweetSoft.QLDA.BackOffice"
			 connectionString="Data Source=LAPTOP-7H27D0NS\SQLEXPRESS;Initial Catalog=SweetSoft_QLDA;Persist Security Info=True;User ID=Dung;Password=mutekilv1"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<resizer>
		<sizelimits imageWidth="0" imageHeight="0" totalWidth="3600" totalHeight="3600" totalBehavior="throwexception" />
	</resizer>

	<appSettings>
		<add key="SystemName" value="PM Quản Lý Dự Án" />
		<add key="EnableExceptionEmail" value="false" />
		<add key="EnableExceptionLogFile" value="false" />
		<add key="ExceptionLogFilePath" value="C:\Logs\exceptions.log" />
		<add key="IsDevelopment" value="true" />
		<add key="PageInspector:ServerCodeMappingSupport" value="Disabled" />
		<add key="DefaultLanguage" value="2" />
		<add key="AccessKey" value="QLDA" />
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="true" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="CookieKeyPanel" value="_QLDA_PANEL_DEV_" />
		<add key="CookieKeyClient" value="_QLDA_CLIENT_DEV_" />
		<add key="SessionAppContext" value="_QLDA_SESSION_APP_CONTEXT_PANEL_DEV_" />
		<add key="IsUsedDefaultPassword" value="true" />
		<add key="DefaultPassword" value="123456" />
		<add key="EPPlus:ExcelPackage.LicenseContext" value="NonCommercial" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<add key="Upload.MaxFileSize" value="1024" />
		<add key="Upload.AllowedExtensions" value=".jpg,.jpge,.png,.pdf,.doc,.docx,.xls,.xlsx,.avi,.mp3,.mp4" />
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
		<add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
	</appSettings>

	<SubSonicService defaultProvider="DataAccessProvider">
		<providers>
			<clear />
			<add name="DataAccessProvider"
				 type="SubSonic.SqlDataProvider, SubSonic"
				 connectionStringName="SweetSoft.QLDA.BackOffice"
				 generatedNamespace="SweetSoft.QLDA.DataAccess"
				 generateLazyLoads="true" />
		</providers>
	</SubSonicService>

	<system.web>
		<globalization culture="vi-VN" uiCulture="vi-VN" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" requestValidationMode="2.0" maxRequestLength="1048576" executionTimeout="3600" enableVersionHeader="false" />
		<httpCookies httpOnlyCookies="true" requireSSL="false" />

		<authentication mode="Forms">
			<forms loginUrl="~/Login"
				   defaultUrl="~/"
				   name=".ASPXFORMSAUTH"
				   timeout="10080"
				   enableCrossAppRedirects="true"
				   ticketCompatibilityMode="Framework40"
				   domain="qlda.local"
				   protection="Encryption"
				   requireSSL="false" />
		</authentication>

		<roleManager enabled="true" defaultProvider="SweetSoftRoleProvider">
			<providers>
				<clear />
				<add connectionStringName="SweetSoft.QLDA.BackOffice" applicationName="SweetSoft.QLDA.BackOffice" name="SweetSoftRoleProvider" type="System.Web.Security.SqlRoleProvider" />
			</providers>
		</roleManager>

		<membership defaultProvider="SweetSoftMembershipProvider" userIsOnlineTimeWindow="20" hashAlgorithmType="SHA256">
			<providers>
				<clear />
				<add name="SweetSoftMembershipProvider" applicationName="SweetSoft.QLDA.BackOffice" type="System.Web.Security.SqlMembershipProvider" connectionStringName="SweetSoft.QLDA.BackOffice" enablePasswordRetrieval="true" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="true" passwordFormat="Encrypted" maxInvalidPasswordAttempts="9" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0" passwordAttemptWindow="10" />
			</providers>
		</membership>

		<authorization>
			<deny users="?" />
		</authorization>

		<pages controlRenderingCompatibilityVersion="4.0" viewStateEncryptionMode="Always" enableEventValidation="true" validateRequest="true">
			<controls>
				<add tagPrefix="CKEditor" assembly="CKEditor.NET" namespace="CKEditor.NET" />
				<add tagPrefix="SweetSoft" namespace="SweetSoft.QLDA.Controls" assembly="SweetSoft.QLDA.Controls" />
				<add tagPrefix="SweetSoft" src="~/Controls/Breadcrumb/CtrlBreadcrumb.ascx" tagName="Navigation" />
				<add tagPrefix="SweetSoft" src="~/Controls/AutoComplete/ExtraAutoComplete.ascx" tagName="ExtraAutoComplete" />
				<add tagPrefix="SweetSoft" src="~/Controls/GridviewPaging.ascx" tagName="Paging" />
			</controls>
		</pages>

		<machineKey validationKey="41EDCA53EE6C85DEAF35CDC5F12FD323A296030A4175EB4E946DFEEE0C0CC007BA29A8A59B48281A939475EB450406EC805510745ED487A83104582F52998933"
					decryptionKey="063534281FFA966C07907DE19CB177308F8BCF35567598EE9B26D85A20D46E29"
					validation="SHA1"
					decryption="AES" />
		<customErrors mode="Off" />
	</system.web>

	<system.webServer>
		<urlCompression doStaticCompression="true" doDynamicCompression="true" />
		<httpCompression>
			<dynamicTypes>
				<add mimeType="text/*" enabled="true" />
				<add mimeType="application/javascript" enabled="true" />
				<add mimeType="application/json" enabled="true" />
				<add mimeType="application/xml" enabled="true" />
			</dynamicTypes>
			<staticTypes>
				<add mimeType="text/*" enabled="true" />
				<add mimeType="application/javascript" enabled="true" />
				<add mimeType="application/json" enabled="true" />
				<add mimeType="application/xml" enabled="true" />
			</staticTypes>
		</httpCompression>

		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>

		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
				<remove name="X-AspNet-Version" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="X-XSS-Protection" value="1; mode=block" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
			</customHeaders>
		</httpProtocol>

		<security>
			<requestFiltering allowDoubleEscaping="true">
				<requestLimits maxAllowedContentLength="4294967295" />
				<verbs>
					<add verb="PUT" allowed="false" />
					<add verb="DELETE" allowed="false" />
				</verbs>
				<denyUrlSequences>
					<add sequence="/*" />
					<add sequence="*/" />
					<add sequence="' OR '" />
				</denyUrlSequences>
			</requestFiltering>
		</security>

		<caching enabled="true" enableKernelCache="true" maxCacheSize="102400" maxResponseSize="512000">
			<profiles>
				<add extension=".css" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".ttf" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".woff2" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".js" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".gif" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".jpg" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".jpeg" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".png" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".webp" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
				<add extension=".mp4" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
			</profiles>
		</caching>

		<staticContent>
			<clientCache cacheControlMaxAge="2.00:00:00" cacheControlMode="UseMaxAge" />
			<mimeMap fileExtension=".webp" mimeType="image/webp" />
		</staticContent>

		<rewrite>
			<rules>
				<rule name="Redirect root to landing" stopProcessing="true">
					<match url="^$" />
					<action type="Redirect" url="/trang-chu" redirectType="Permanent" />
				</rule>
				<rule name="403" stopProcessing="true">
					<match url="^403\/?$" />
					<action type="Rewrite" url="/AccessDenied.aspx" />
				</rule>
				<rule name="404" stopProcessing="true">
					<match url="^404\/?$" />
					<action type="Rewrite" url="/NotFound.aspx" />
				</rule>
				<rule name="AdminPanelUserList" stopProcessing="true">
					<match url="^Users(\/)?$" />
					<action type="Rewrite" url="/fUsers/UserList.aspx" />
				</rule>
				<rule name="AdminPanelUserDetailEmp" stopProcessing="true">
					<match url="^User\/([^\/]+)?$" />
					<action type="Rewrite" url="/fUsers/NhanVienDetail.aspx?Id={R:1}" />
				</rule>
				<rule name="AdminPanelUserGroupDetail" stopProcessing="true">
					<match url="^Role\/([^\/]+)?$" />
					<action type="Rewrite" url="/fUsers/RoleDetail.aspx?Id={R:1}" />
				</rule>
				<rule name="AddAdminPanelUserGroups" stopProcessing="true">
					<match url="^Role/Add\/?$" />
					<action type="Rewrite" url="/fUsers/RoleDetail.aspx" />
				</rule>
				<rule name="AdminPanelUserGroupsList" stopProcessing="true">
					<match url="^Roles(\/)?$" />
					<action type="Rewrite" url="/fUsers/RoleList.aspx" />
				</rule>
				<rule name="AdminPanelSystemLogs" stopProcessing="true">
					<match url="^audit-logs(\/)?$" />
					<action type="Rewrite" url="/fSettings/AuditTrails.aspx" />
				</rule>
				<rule name="AdminPanelSystemSetting" stopProcessing="true">
					<match url="^Settings(\/)?$" />
					<action type="Rewrite" url="/fSettings/Settings.aspx" />
				</rule>
				<rule name="AdminPanelFileManagers" stopProcessing="true">
					<match url="^Files(\/)?$" />
					<action type="Rewrite" url="/fFiles/FileListing.aspx" />
				</rule>
				<rule name="AdminPanelEmailTemplateAdd" stopProcessing="true">
					<match url="^email-template/Add\/([^\/]+)?$" />
					<action type="Rewrite" url="/fEmailTemplate/EmailTemplateDetail.aspx" />
				</rule>
				<rule name="AdminPanelEmailTemplateDetail" stopProcessing="true">
					<match url="^email-template\/([^\/]+)?$" />
					<action type="Rewrite" url="/fEmailTemplate/EmailTemplateDetail.aspx?Id={R:1}" />
				</rule>
				<rule name="AdminPanelEmailTemplateList" stopProcessing="true">
					<match url="^email-templates(\/)?$" />
					<action type="Rewrite" url="/fEmailTemplate/EmailTemplates.aspx" />
				</rule>
				<rule name="AdminPanelFileManagerBrowse" stopProcessing="true">
					<match url="^file-management.html" />
					<action type="Rewrite" url="/_RFMng/Default.aspx" />
				</rule>
				<rule name="AdminPanelProfile" stopProcessing="true">
					<match url="^Profile(\/)?$" />
					<action type="Rewrite" url="/Profile.aspx" />
				</rule>
				<rule name="AdminPanelForgotPassword" stopProcessing="true">
					<match url="^forgot-password(\/)?$" />
					<action type="Rewrite" url="/ForgotPassword.aspx" />
				</rule>
				<rule name="AdminPanelResetPassword" stopProcessing="true">
					<match url="^reset-password(\/)?$" />
					<action type="Rewrite" url="/ResetPassword.aspx" />
				</rule>
				<rule name="AdminPanelLogin" stopProcessing="true">
					<match url="^Login(\/)?$" />
					<action type="Rewrite" url="/Login.aspx" />
				</rule>
				<rule name="AdminPanelLockScreen" stopProcessing="true">
					<match url="^lock-screen(\/)?$" />
					<action type="Rewrite" url="/LockScreen.aspx" />
				</rule>
				<rule name="AdminPanelHome" stopProcessing="true">
					<match url="^Home(\/)?$" />
					<action type="Rewrite" url="/Default.aspx" />
				</rule>
				<rule name="AdminPanelAdmin" stopProcessing="true">
					<match url="^AdminPanel(\/)?$" />
					<action type="Rewrite" url="/Default.aspx" />
				</rule>
				<rule name="Home Page" stopProcessing="true">
					<match url="^trang-chu(\/)?$" />
					<action type="Rewrite" url="/Default.aspx" />
				</rule>
				<rule name="Employees Rewrite" stopProcessing="true">
					<match url="^Employees/?$" ignoreCase="true" />
					<action type="Rewrite" url="fNhanVien/ListNhanVien.aspx" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>

	<system.web.extensions>
		<scripting>
			<webServices>
				<jsonSerialization maxJsonLength="1000000" />
			</webServices>
		</scripting>
	</system.web.extensions>

	<!-- Các mục Location cho phép truy cập không cần Login -->
	<location path="Login.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="Login">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="ForgotPassword.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="forgot-password">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="ResetPassword.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="reset-password">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="Controls/Captcha.ashx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="QRCoder" publicKeyToken="c4ed5b9ae8358a28" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-1.6.0.0" newVersion="1.6.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>