        </script>

        <script>
            var scrollToTarget = function (target, containerEl) {
                // Moved up here for readability:
                var isElement = target && target.nodeType === 1,
                    isNumber = Object.prototype.toString.call(target) === '[object Number]';

                if (isElement) {
                    containerEl.scrollTop = target.offsetTop;
                } else if (isNumber) {
                    containerEl.scrollTop = target;
                } else if (target === 'bottom') {
                    containerEl.scrollTop = containerEl.scrollHeight - containerEl.offsetHeight;
                } else if (target === 'top') {
                    containerEl.scrollTop = 0;
                }
            };
            $(document).ready(function () {
                $('body').removeClass('loadingPage');
            })
            function provinceQuery(params) {
                const id = parseInt($('[data-selector="ddlCountry"]').val());
                var obj = {
                    keyword: params.term || "",
                    countryId: id || 'd8842bf3-7071-44d3-80eb-92b31a133bcc',
                    page: params.page || 1,
                    page_limit: 10
                };
                return JSON.stringify(obj);
            }

            function wardQuery(params) {
                const id = $('[data-selector="ddlProvince"]').val();
                var obj = {
                    keyword: params.term || "",
                    districtId: id || '00000000-0000-0000-0000-000000000000',
                    page: params.page || 1,
                    page_limit: 10
                };
                return JSON.stringify(obj);
            }
            CMSMasterJs.ChangeTarget = () => {
                $('[data-selector="ddlTargetId"]').select2("val", "");
            }
            $(document).on('select2:open', () => {
                document.querySelector('.select2-search__field').focus();
            });
        </script>
        <script>
            function AllUser() {
                return '/WebService.asmx/GetUsers';
            }
            function AllCustomer() {
                return '/WebService.asmx/AllCustomer';
            }
            function AllVehicles() {
                return '/api/v1/AllVehicles';
            }
            function AllDrivers() {
                return '/api/v1/AllDrivers';
            }
        </script>
        <script>
            function updateTime() {
                const now = new Date();

                const day = String(now.getDate()).padStart(2, '0');
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const year = now.getFullYear();

                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');

                const formatted = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;

                document.getElementById('realtimeClock').textContent = formatted;
            }
            updateTime();
            setInterval(updateTime, 1000);
        </script>
        <script>
            // Notification center: giữ nguyên 4 WebService API và polling mỗi 30 giây.
            (function () {
                var _items = [];
                var _byId = Object.create(null);
                var _currentPage = 0;
                var _hasMore = false;
                var _loading = false;
                var _initialized = false;
                var _unreadCount = 0;
                var _statusFilter = 'all';
                var _typeFilter = 'all';
                var _dateFilter = 'all';
                var _viewMode = 'compact'; // Chế độ mặc định là popup nhỏ cạnh chuông.
                var _autoDatePages = 0;
                var MAX_AUTO_DATE_PAGES = 6;
                var _preview = null;
                var _previewTarget = null;
                var _requestToken = 0;
                var _listElement = null; // ASP.NET UpdatePanel có thể thay DOM của chuông.

                var iconMap = {
                    'CONG_VIEC': { icon: 'bx bx-task', css: 'qlda-noti-icon-task', label: 'Công việc' },
                    'DU_AN': { icon: 'bx bx-briefcase', css: 'qlda-noti-icon-project', label: 'Dự án' },
                    'LICH_HOP': { icon: 'bx bx-calendar', css: 'qlda-noti-icon-meeting', label: 'Lịch họp' },
                    'VAN_DE': { icon: 'bx bx-error-circle', css: 'qlda-noti-icon-issue', label: 'Vấn đề' },
                    'TAI_LIEU': { icon: 'bx bx-file', css: 'qlda-noti-icon-document', label: 'Tài liệu' },
                    'HE_THONG': { icon: 'bx bx-bell', css: 'qlda-noti-icon-system', label: 'Hệ thống' }
                };

                function asText(value) {
                    return value === null || value === undefined ? '' : String(value);
                }
                function esc(value) {
                    return asText(value).replace(/&/g, '&amp;').replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                }
                function getMeta(type) {
                    return iconMap[asText(type).toUpperCase()] || { icon: 'bx bx-bell', css: 'qlda-noti-icon-system', label: 'Khác' };
                }
                function parseDate(value) {
                    if (!value) return null;
                    if (value instanceof Date) return isNaN(value.getTime()) ? null : value;
                    var s = asText(value).trim();
                    var dotNet = /\/Date\((-?\d+)(?:[+-]\d+)?\)\//.exec(s);
                    if (dotNet) {
                        var msDate = new Date(Number(dotNet[1]));
                        return isNaN(msDate.getTime()) ? null : msDate;
                    }
                    var vn = /^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[\sT]+(\d{1,2}):(\d{2})(?::(\d{2}))?)?/.exec(s);
                    if (vn) {
                        var d = new Date(+vn[3], +vn[2] - 1, +vn[1], +(vn[4] || 0), +(vn[5] || 0), +(vn[6] || 0));
                        return d.getFullYear() === +vn[3] && d.getMonth() === (+vn[2] - 1) && d.getDate() === +vn[1] ? d : null;
                    }
                    var isoDate = new Date(s);
                    return isNaN(isoDate.getTime()) ? null : isoDate;
                }
                function displayDate(n) {
                    var raw = n.ngayTao;
                    if (typeof raw === 'string' && /^\d{1,2}\/\d{1,2}\/\d{4}/.test(raw)) return raw;
                    var date = parseDate(raw);
                    if (!date) return asText(raw) || 'Không rõ thời gian';
                    function pad(v) { return String(v).padStart(2, '0'); }
                    return pad(date.getDate()) + '/' + pad(date.getMonth() + 1) + '/' + date.getFullYear() +
                        ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
                }
                function dateGroup(n) {
                    var date = parseDate(n.ngayTao);
                    if (!date) return { key: 'unknown', title: 'Chưa rõ thời gian' };
                    var today = new Date();
                    today.setHours(0, 0, 0, 0);
                    var itemDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
                    var diff = Math.round((today.getTime() - itemDay.getTime()) / 86400000);
                    if (diff <= 0) return { key: 'today', title: 'Hôm nay' };
                    if (diff === 1) return { key: 'yesterday', title: 'Hôm qua' };
                    if (diff < 7) return { key: 'week', title: '7 ngày gần đây' };
                    return { key: 'older', title: 'Trước đó' };
                }
                function safeLink(value) {
                    var url = asText(value).trim();
                    if (!url || /^javascript:/i.test(url) || url === '#') return '#';
                    try {
                        var parsed = new URL(url, window.location.href);
                        return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.href : '#';
                    } catch (e) { return '#'; }
                }
                function compareNewest(a, b) {
                    var da = parseDate(a.ngayTao), db = parseDate(b.ngayTao);
                    return (db ? db.getTime() : 0) - (da ? da.getTime() : 0);
                }
                function replaceItems(items) {
                    _items = [];
                    _byId = Object.create(null);
                    mergeItems(items);
                }
                function mergeItems(items) {
                    var changed = false;
                    (items || []).forEach(function (n) {
                        if (!n || n.id === undefined || n.id === null) return;
                        var key = asText(n.id);
                        if (_byId[key]) {
                            // Chỉ vẽ lại khi thông báo thay đổi, tránh giật khi polling.
                            var stored = _byId[key];
                            Object.keys(n).forEach(function (field) {
                                if (stored[field] !== n[field]) {
                                    stored[field] = n[field];
                                    changed = true;
                                }
                            });
                        } else {
                            _byId[key] = Object.assign({}, n);
                            _items.push(_byId[key]);
                            changed = true;
                        }
                    });
                    if (changed) _items.sort(compareNewest);
                    return changed;
                }
                function updateBadge(count) {
                    if (typeof count === 'number' && isFinite(count)) _unreadCount = Math.max(0, count);
                    var badge = document.getElementById('badgeUnread');
                    var markAll = document.getElementById('btnMarkAllRead');
                    var subtitle = document.getElementById('notificationSubtitle');
                    var toggle = document.getElementById('bellToggle');
                    if (badge) {
                        badge.textContent = _unreadCount > 99 ? '99+' : String(_unreadCount);
                        badge.style.display = _unreadCount ? '' : 'none';
                    }
                    if (subtitle) subtitle.textContent = _unreadCount ? (_unreadCount + ' thông báo chưa đọc') : 'Bạn đã xem hết các thông báo mới';
                    if (markAll && !markAll.disabled) markAll.style.display = _unreadCount ? '' : 'none';
                    if (toggle) toggle.setAttribute('aria-label', _unreadCount ? 'Mở thông báo, ' + _unreadCount + ' chưa đọc' : 'Mở thông báo');
                }
                function isUnread(n) { return n.daDoc === false || n.daDoc === 0 || n.daDoc === 'false' || n.daDoc === 'False'; }
                // Tuần bắt đầu từ thứ Hai; mọi mốc thời gian theo múi giờ trình duyệt.
                function dateFilterStart() {
                    var now = new Date();
                    if (_dateFilter === 'week') {
                        var mondayOffset = (now.getDay() + 6) % 7;
                        return new Date(now.getFullYear(), now.getMonth(), now.getDate() - mondayOffset);
                    }
                    if (_dateFilter === 'month') return new Date(now.getFullYear(), now.getMonth(), 1);
                    return null;
                }
                function getVisibleItems() {
                    var start = dateFilterStart();
                    var now = new Date();
                    return _items.filter(function (n) {
                        if (_statusFilter === 'unread' && !isUnread(n)) return false;
                        if (start) {
                            var created = parseDate(n.ngayTao);
                            if (!created || created < start || created > now) return false;
                        }
                        if (_typeFilter === 'all') return true;
                        var type = asText(n.loaiThongBao).toUpperCase();
                        return _typeFilter === 'other' ? !iconMap[type] : type === _typeFilter;
                    });
                }
                function needsMoreDatePages() {
                    if (_dateFilter === 'all' || !_hasMore || !_currentPage) return false;
                    var start = dateFilterStart();
                    var oldest = null;
                    _items.forEach(function (n) {
                        var created = parseDate(n.ngayTao);
                        if (created && (!oldest || created < oldest)) oldest = created;
                    });
                    // API có phân trang theo thời gian mới nhất. Khi đã tải tới thông báo
                    // trước mốc lọc thì không cần tự gọi tiếp các trang cũ hơn.
                    return !oldest || oldest >= start;
                }
                function autoLoadDateRange() {
                    if (_loading || _autoDatePages >= MAX_AUTO_DATE_PAGES || !needsMoreDatePages()) return;
                    _autoDatePages++;
                    loadNotifications(_currentPage + 1);
                }
                function buildItem(n) {
                    var meta = getMeta(n.loaiThongBao);
                    var unread = isUnread(n);
                    var link = safeLink(n.duongDanLienKet);
                    var id = esc(n.id);
                    return '<div class="notification-item' + (unread ? ' is-unread' : '') + '" data-id="' + id + '">' +
                        '<a class="qlda-noti-link" href="' + esc(link) + '" aria-label="' + esc(n.tieuDe || 'Thông báo') + '">' +
                        '<span class="notification-icon ' + meta.css + '"><i class="' + meta.icon + '" aria-hidden="true"></i></span>' +
                        '<span class="qlda-noti-copy">' +
                        '<span class="qlda-noti-topline"><span class="qlda-noti-category">' + esc(meta.label) + '</span>' +
                        (unread ? '<span class="qlda-noti-unread-dot" aria-label="Chưa đọc"></span>' : '') + '</span>' +
                        '<span class="qlda-noti-item-title">' + esc(n.tieuDe || 'Thông báo') + '</span>' +
                        (getContent(n) ? '<span class="qlda-noti-snippet">' + esc(getContent(n)) + '</span>' : '') +
                        '<span class="qlda-noti-time"><i class="bx bx-time-five" aria-hidden="true"></i>' + esc(displayDate(n)) + '</span>' +
                        '</span>' +
                        '</a>' +
                        '<button type="button" class="qlda-noti-detail" data-id="' + id + '" title="Xem thông tin chi tiết" aria-label="Xem chi tiết thông báo">' +
                        '<i class="bx bx-info-circle" aria-hidden="true"></i></button>' +
                        '</div>';
                }
                function emptyHtml() {
                    var filtered = _typeFilter !== 'all' || _statusFilter !== 'all' || _dateFilter !== 'all';
                    return '<div class="qlda-noti-empty"><div class="qlda-noti-empty-icon"><i class="bx ' +
                        (filtered ? 'bx-filter-alt' : 'bx-bell-off') + '" aria-hidden="true"></i></div>' +
                        '<strong>' + (filtered ? 'Chưa tìm thấy thông báo phù hợp' : 'Chưa có thông báo nào') + '</strong>' +
                        '<span>' + (filtered ? 'Bạn có thể đổi bộ lọc hoặc tải thêm thông báo.' : 'Các cập nhật mới sẽ xuất hiện tại đây.') + '</span></div>';
                }
                function draw() {
                    updateStatusToggle();
                    var list = document.getElementById('notificationList');
                    if (!list || !_initialized || _loading && _currentPage === 0) return;
                    hidePreview();
                    var priorScroll = list.scrollTop;
                    var visible = getVisibleItems();
                    if (!visible.length) {
                        list.innerHTML = emptyHtml();
                    } else {
                        var html = '';
                        var lastGroup = '';
                        var counts = {};
                        visible.forEach(function (n) {
                            var g = dateGroup(n);
                            counts[g.key] = (counts[g.key] || 0) + 1;
                        });
                        visible.forEach(function (n) {
                            var group = dateGroup(n);
                            if (group.key !== lastGroup) {
                                html += '<div class="qlda-noti-group-title"><span>' + group.title + '</span><span>' + counts[group.key] + ' thông báo</span></div>';
                                lastGroup = group.key;
                            }
                            html += buildItem(n);
                        });
                        list.innerHTML = html;
                    }
                    list.scrollTop = priorScroll;
                    // Nếu WebService trả dữ liệu trong lúc popup đang mở, các hàng mới vẫn nhận hiệu ứng.
                    var openPanel = document.querySelector('#bellDropdownWrapper .notification.qlda-noti-opening');
                    if (openPanel) prepareNotificationWaterfall();
                    var footer = document.getElementById('notificationFooter');
                    var note = document.getElementById('notificationFilterNote');
                    if (footer) footer.style.display = _hasMore ? '' : 'none';
                    if (note) note.style.display = _hasMore && (_statusFilter !== 'all' || _typeFilter !== 'all' || _dateFilter !== 'all') ? '' : 'none';
                }
                function showLoading() {
                    var list = document.getElementById('notificationList');
                    if (!list) return;
                    var html = '';
                    for (var i = 0; i < 3; i++) {
                        html += '<div class="qlda-noti-skeleton" aria-hidden="true"><div class="qlda-noti-skeleton-icon"></div>' +
                            '<div class="qlda-noti-skeleton-content"><span class="qlda-noti-skeleton-line"></span><span class="qlda-noti-skeleton-line"></span></div></div>';
                    }
                    list.innerHTML = html;
                }
                function loadNotifications(page) {
                    if (_loading) return;
                    _loading = true;
                    var token = ++_requestToken;
                    var receivedPage = false;
                    var spinner = document.getElementById('btnLoadMoreSpinner');
                    var more = document.getElementById('btnLoadMore');
                    if (page === 1 && _currentPage === 0) showLoading();
                    if (spinner) spinner.style.display = '';
                    if (more) more.disabled = true;
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/GetNotifications',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ page: page }), dataType: 'json'
                    }).done(function (res) {
                        if (token !== _requestToken) return;
                        if (!res || !res.d || !res.d.success) {
                            if (_currentPage === 0) renderError('Không thể tải danh sách thông báo.');
                            return;
                        }
                        var result = res.d;
                        receivedPage = true;
                        if (page === 1) replaceItems(result.data);
                        else mergeItems(result.data);
                        _hasMore = !!result.hasMore;
                        _currentPage = page;
                        draw();
                    }).fail(function () {
                        if (_currentPage === 0) renderError('Không thể kết nối để tải thông báo.');
                    }).always(function () {
                        _loading = false;
                        if (spinner) spinner.style.display = 'none';
                        if (more) more.disabled = false;
                        if (_currentPage > 0) draw();
                        if (receivedPage) autoLoadDateRange();
                    });
                }
                function renderError(message) {
                    var list = document.getElementById('notificationList');
                    if (list) list.innerHTML = '<div class="qlda-noti-empty"><div class="qlda-noti-empty-icon"><i class="bx bx-wifi-off"></i></div>' +
                        '<strong>' + esc(message) + '</strong><span>Đóng rồi mở lại chuông để thử tải lại.</span></div>';
                    _initialized = false;
                }
                function pollNotifications() {
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/GetLatestNotifications',
                        contentType: 'application/json; charset=utf-8', dataType: 'json'
                    }).done(function (res) {
                        if (!res || !res.d || !res.d.success) return;
                        updateBadge(Number(res.d.unreadCount) || 0);
                        if (_initialized && _currentPage > 0 && !_loading && mergeItems(res.d.data)) {
                            draw();
                        }
                    });
                }
                function getContent(n) {
                    var candidates = [n.noiDung, n.noiDungThongBao, n.moTa, n.moTaThongBao, n.content, n.message, n.thongDiep];
                    for (var i = 0; i < candidates.length; i++) {
                        if (candidates[i] !== null && candidates[i] !== undefined && asText(candidates[i]).trim()) return asText(candidates[i]);
                    }
                    return '';
                }
                function hidePreview() {
                    if (_preview && _preview.parentNode) _preview.parentNode.removeChild(_preview);
                    _preview = null;
                    _previewTarget = null;
                }
                function showPreview(target) {
                    var item = target && target.closest ? target.closest('.notification-item') : null;
                    if (!item) return;
                    var n = _byId[item.getAttribute('data-id')];
                    if (!n) return;
                    if (_previewTarget === item && _preview) return;
                    hidePreview();
                    var description = getContent(n);
                    var href = safeLink(n.duongDanLienKet);
                    var preview = document.createElement('div');
                    preview.className = 'qlda-noti-preview';
                    preview.setAttribute('role', 'tooltip');
                    preview.innerHTML =
                        '<div class="qlda-noti-preview-head"><span class="qlda-noti-preview-type">' + esc(getMeta(n.loaiThongBao).label) + '</span>' +
                        '<span class="qlda-noti-preview-status' + (isUnread(n) ? '' : ' is-read') + '">' + (isUnread(n) ? 'Chưa đọc' : 'Đã đọc') + '</span></div>' +
                        '<div class="qlda-noti-preview-title">' + esc(n.tieuDe || 'Thông báo') + '</div>' +
                        (description ? '<div class="qlda-noti-preview-content">' + esc(description) + '</div>' :
                            '<div class="qlda-noti-preview-content qlda-noti-preview-muted">Thông báo này chưa có mô tả chi tiết trong dữ liệu trả về.</div>') +
                        '<div class="qlda-noti-preview-foot"><span><i class="bx bx-calendar"></i>' + esc(displayDate(n)) + '</span>' +
                        (href !== '#' ? '<span><i class="bx bx-link-external"></i>Nhấn thông báo để xem liên kết</span>' : '') + '</div>';
                    document.body.appendChild(preview);
                    _preview = preview;
                    _previewTarget = item;
                    var rect = item.getBoundingClientRect();
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    var panelRect = panel ? panel.getBoundingClientRect() : rect;
                    var width = preview.offsetWidth;
                    var height = preview.offsetHeight;
                    var left;
                    if (panelRect.left >= width + 16) left = panelRect.left - width - 9;
                    else if (window.innerWidth - panelRect.right >= width + 16) left = panelRect.right + 9;
                    else left = Math.min(Math.max(11, rect.left), Math.max(11, window.innerWidth - width - 11));
                    var top = rect.top;
                    if (panelRect.left < width + 16 && window.innerWidth - panelRect.right < width + 16) {
                        top = rect.bottom + 6;
                        if (top + height > window.innerHeight - 11) top = rect.top - height - 6;
                    }
                    top = Math.max(11, Math.min(top, window.innerHeight - height - 11));
                    preview.style.left = Math.round(left) + 'px';
                    preview.style.top = Math.round(top) + 'px';
                }
                function onItemClick(el, evt) {
                    if (evt) evt.preventDefault();
                    var item = el.closest('.notification-item');
                    if (!item) return;
                    var n = _byId[item.getAttribute('data-id')];
                    var link = safeLink(el.getAttribute('href'));
                    hidePreview();
                    function navigate() { if (link !== '#') window.location.assign(link); }
                    if (!n || !isUnread(n)) { navigate(); return; }
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/MarkNotificationAsRead',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ id: n.id }), dataType: 'json', timeout: 4500
                    }).done(function (res) {
                        if (res && res.d && res.d.success === false) return;
                        n.daDoc = true;
                        updateBadge(Math.max(0, _unreadCount - 1));
                        draw();
                    }).always(navigate);
                }
                // Giữ API global để các đoạn mã khác đang dùng NotificationBell vẫn hoạt động.
                window.NotificationBell = window.NotificationBell || {};
                window.NotificationBell.onItemClick = onItemClick;

                function updateStatusToggle() {
                    var btn = document.getElementById('btnToggleUnread');
                    var label = document.getElementById('notificationStatusToggleText');
                    var icon = document.getElementById('notificationStatusToggleIcon');
                    if (!btn) return;
                    var unreadOnly = _statusFilter === 'unread';
                    var actionLabel = unreadOnly ? 'Tất cả' : 'Chưa đọc';
                    if (label) label.textContent = actionLabel;
                    if (icon) icon.className = unreadOnly ? 'bx bx-list-ul' : 'bx bx-filter-alt';
                    btn.classList.remove('is-active', 'mode-all', 'mode-unread');
                    btn.classList.add(unreadOnly ? 'mode-all' : 'mode-unread');
                    btn.setAttribute('aria-pressed', unreadOnly ? 'true' : 'false');
                    btn.setAttribute('aria-label', unreadOnly ? 'Hiện tất cả thông báo' : 'Chỉ xem thông báo chưa đọc');
                    btn.title = unreadOnly ? 'Hiện tất cả thông báo' : 'Chỉ xem thông báo chưa đọc';
                }
                $(document).on('click', '#btnToggleUnread', function () {
                    _statusFilter = _statusFilter === 'unread' ? 'all' : 'unread';
                    updateStatusToggle();
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    draw();
                });
                $(document).on('change', '#notificationTypeFilter', function () {
                    _typeFilter = this.value;
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    draw();
                });
                $(document).on('change', '#notificationDateFilter', function () {
                    _dateFilter = this.value;
                    _autoDatePages = 0;
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    draw();
                    autoLoadDateRange();
                });
                $(document).on('click', '#btnMarkAllRead', function () {
                    var btn = this;
                    btn.disabled = true;
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/MarkAllNotificationsAsRead',
                        contentType: 'application/json; charset=utf-8', dataType: 'json'
                    }).done(function (res) {
                        if (res && res.d && res.d.success === false) return;
                        _items.forEach(function (n) { n.daDoc = true; });
                        updateBadge(0);
                        draw();
                    }).always(function () {
                        btn.disabled = false;
                        updateBadge(_unreadCount);
                    });
                });
                $(document).on('click', '#btnLoadMore', function () {
                    if (!_loading && _hasMore) loadNotifications(_currentPage + 1);
                });
                $(document).on('click', '#notificationList .qlda-noti-link', function (evt) {
                    window.NotificationBell.onItemClick(this, evt);
                });
                $(document).on('mouseenter focusin', '#notificationList .notification-item', function () {
                    showPreview(this);
                });
                $(document).on('mouseleave focusout', '#notificationList .notification-item', function (e) {
                    if (e.type === 'focusout' && this.contains(e.relatedTarget)) return;
                    if (_previewTarget === this) hidePreview();
                });
                $(document).on('click', '#notificationList .qlda-noti-detail', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    showPreview(this);
                });
                $(document).on('scroll', '#notificationList', hidePreview);
                $(window).on('resize.qldaNotification', function () { hidePreview(); positionNotificationDropdown(); });
                $(document).on('keydown.qldaNotification', function (e) {
                    if (e.key === 'Escape') hidePreview();
                });
                $(document).on('click.qldaNotification', function (e) {
                    if (_preview && !$(e.target).closest('#notificationList .notification-item').length) hidePreview();
                });
                function closeNotificationViewMenu() {
                    var menu = document.getElementById('notificationViewMenu');
                    var button = document.getElementById('btnNotificationView');
                    if (menu) menu.hidden = true;
                    if (button) button.setAttribute('aria-expanded', 'false');
                }
                function syncNotificationBackdrop() {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    var backdrop = document.getElementById('notificationViewBackdrop');
                    if (backdrop) backdrop.classList.toggle('is-visible', !!panel && panel.classList.contains('show') && _viewMode === 'expanded');
                }
                function setNotificationViewMode(mode) {
                    _viewMode = mode === 'expanded' ? 'expanded' : 'compact';
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (panel) {
                        panel.classList.toggle('qlda-noti-expanded', _viewMode === 'expanded');
                        panel.setAttribute('aria-label', _viewMode === 'expanded' ? 'Thông báo, chế độ xem rộng' : 'Thông báo, chế độ thu gọn');
                    }
                    var icon = document.getElementById('notificationViewIcon');
                    var picker = document.getElementById('btnNotificationView');
                    if (icon) icon.className = _viewMode === 'expanded' ? 'bx bx-collapse-alt' : 'bx bx-layout';
                    if (picker) picker.title = _viewMode === 'expanded' ? 'Chế độ xem rộng - bấm để thay đổi' : 'Chế độ thu gọn - bấm để thay đổi';
                    $('#notificationViewMenu .qlda-noti-view-option').each(function () {
                        var selected = this.getAttribute('data-view-mode') === _viewMode;
                        this.classList.toggle('is-selected', selected);
                        this.setAttribute('aria-checked', selected ? 'true' : 'false');
                    });
                    closeNotificationViewMenu();
                    hidePreview();
                    positionNotificationDropdown();
                    syncNotificationBackdrop();
                }
                $(document).on('click', '#btnNotificationView', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    var menu = document.getElementById('notificationViewMenu');
                    if (!menu) return;
                    var open = menu.hidden;
                    menu.hidden = !open;
                    this.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                $(document).on('click', '#notificationViewMenu .qlda-noti-view-option', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    setNotificationViewMode(this.getAttribute('data-view-mode'));
                    var button = document.getElementById('btnNotificationView');
                    if (button) button.focus();
                });
                $(document).on('click', function (event) {
                    if (!$(event.target).closest('#notificationViewPicker').length) closeNotificationViewMenu();
                });
                $(document).on('keydown', '#notificationViewPicker', function (event) {
                    if (event.key === 'Escape' && document.getElementById('notificationViewMenu') && !document.getElementById('notificationViewMenu').hidden) {
                        event.stopPropagation();
                        closeNotificationViewMenu();
                        var button = document.getElementById('btnNotificationView');
                        if (button) button.focus();
                    }
                });
                function closeExpandedNotification() {
                    var toggle = document.getElementById('bellToggle');
                    if (!toggle) return;
                    var dropdown = window.bootstrap && window.bootstrap.Dropdown ? window.bootstrap.Dropdown.getOrCreateInstance(toggle) : null;
                    if (dropdown) dropdown.hide();
                    else if (typeof $(toggle).dropdown === 'function') $(toggle).dropdown('hide');
                }
                $(document).on('click', '#notificationViewBackdrop, #btnCloseNotificationExpanded', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    closeExpandedNotification();
                });
                function positionNotificationDropdown() {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    var toggle = document.getElementById('bellToggle');
                    if (!panel || !toggle) return;
                    if (panel.classList.contains('qlda-noti-expanded')) return; // CSS canh chính giữa màn hình.
                    var toggleRect = toggle.getBoundingClientRect();
                    var bellBottom = toggleRect.bottom;
                    panel.style.setProperty('--qlda-noti-top', Math.round(Math.max(8, Math.min(bellBottom + 10, window.innerHeight - 90))) + 'px');
                    var rightInset;
                    if (window.innerWidth <= 575) {
                        rightInset = 8;
                    } else {
                        var container = document.querySelector('.main-content .page-content .container-fluid');
                        if (!container) container = document.querySelector('.main-content');
                        if (!container) container = document.querySelector('.layout-content');
                        if (!container) container = document.querySelector('.contentHeader .container-fluid');
                        rightInset = container ? (window.innerWidth - container.getBoundingClientRect().right) : 0;
                    }
                    rightInset = Math.round(Math.max(0, Math.min(rightInset, Math.max(0, window.innerWidth - 140))));
                    panel.style.setProperty('--qlda-noti-edge-right', rightInset + 'px');
                    var panelWidth = panel.offsetWidth || parseFloat(window.getComputedStyle(panel).width) || 365;
                    var panelRightEdge = window.innerWidth - rightInset;
                    var bellCenterX = toggleRect.left + (toggleRect.width / 2);
                    var pointerRight = panelRightEdge - bellCenterX - 10;
                    pointerRight = Math.round(Math.max(18, Math.min(pointerRight, Math.max(18, panelWidth - 42))));
                    panel.style.setProperty('--qlda-noti-pointer-right', pointerRight + 'px');
                }
                // Chỉ animate các hàng thực sự nhìn thấy, tối đa 6: không làm nặng danh sách dài.
                function prepareNotificationWaterfall() {
                    var list = document.getElementById('notificationList');
                    if (!list) return;
                    var bounds = list.getBoundingClientRect();
                    var elements = Array.prototype.slice.call(list.children);
                    var rows = [];
                    elements.forEach(function (el) {
                        el.classList.remove('qlda-noti-waterfall-step');
                        el.style.removeProperty('--qlda-noti-in-delay');
                        el.style.removeProperty('--qlda-noti-text-delay');
                        el.style.removeProperty('--qlda-noti-out-delay');
                        var rect = el.getBoundingClientRect();
                        if (rows.length < 6 && rect.height > 0 && rect.top < bounds.bottom && rect.bottom > bounds.top)
                            rows.push(el);
                    });
                    rows.forEach(function (el, index) {
                        el.style.setProperty('--qlda-noti-in-delay', (90 + index * 44) + 'ms');
                        el.style.setProperty('--qlda-noti-text-delay', (215 + index * 44) + 'ms');
                        el.style.setProperty('--qlda-noti-out-delay', (145 + (rows.length - index - 1) * 32) + 'ms');
                        el.classList.add('qlda-noti-waterfall-step');
                    });
                }
                var _notificationOpeningTimer = null;
                var _notificationClosing = false;
                var _allowNotificationHide = false;
                var _notificationCloseTimer = null;
                function finishNotificationHide() {
                    var toggle = document.getElementById('bellToggle');
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    _notificationCloseTimer = null;
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = null;
                    _allowNotificationHide = true;
                    try {
                        if (toggle && window.bootstrap && window.bootstrap.Dropdown) {
                            var dropdown = window.bootstrap.Dropdown.getInstance(toggle);
                            if (!dropdown && window.bootstrap.Dropdown.getOrCreateInstance) {
                                dropdown = window.bootstrap.Dropdown.getOrCreateInstance(toggle);
                            }
                            if (dropdown) dropdown.hide();
                        } else if (toggle && typeof $(toggle).dropdown === 'function') {
                            $(toggle).dropdown('hide');
                        }
                    } finally {
                        _allowNotificationHide = false;
                        _notificationClosing = false;
                        if (panel) panel.classList.remove('qlda-noti-closing', 'qlda-noti-opening');
                    }
                }
                $(document).on('show.bs.dropdown', '#bellDropdownWrapper', function () {
                    if (_notificationCloseTimer) clearTimeout(_notificationCloseTimer);
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = null;
                    _notificationCloseTimer = null;
                    _notificationClosing = false;
                    _allowNotificationHide = false;
                    var panel = this.querySelector('.notification');
                    if (panel) panel.classList.remove('qlda-noti-closing', 'qlda-noti-open', 'qlda-noti-opening');
                    setNotificationViewMode(_viewMode);
                    positionNotificationDropdown();
                    var list = document.getElementById('notificationList');
                    if (!_initialized || _listElement !== list) {
                        _listElement = list;
                        _initialized = true;
                        _currentPage = 0;
                        _autoDatePages = 0;
                        var dateSelect = document.getElementById('notificationDateFilter');
                        var typeSelect = document.getElementById('notificationTypeFilter');
                        _dateFilter = dateSelect ? dateSelect.value : 'all';
                        _typeFilter = typeSelect ? typeSelect.value : 'all';
                        _statusFilter = 'all';
                        updateStatusToggle();
                        loadNotifications(1);
                    } else {
                        updateStatusToggle();
                    }
                });
                $(document).on('shown.bs.dropdown', '#bellDropdownWrapper', function () {
                    positionNotificationDropdown();
                    syncNotificationBackdrop();
                    var panel = this.querySelector('.notification');
                    if (!panel || _notificationClosing) return;
                    prepareNotificationWaterfall();
                    panel.classList.add('qlda-noti-opening');
                    // Hết hiệu ứng thì bỏ lớp animation, để hover và filter hoạt động bình thường.
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = setTimeout(function () {
                        panel.classList.remove('qlda-noti-opening');
                        _notificationOpeningTimer = null;
                    }, 670);
                });
                $(document).on('hide.bs.dropdown', '#bellDropdownWrapper', function (event) {
                    hidePreview();
                    closeNotificationViewMenu();
                    var panel = this.querySelector('.notification');
                    if (_allowNotificationHide || !panel || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
                    event.preventDefault();
                    if (_notificationClosing) return;
                    _notificationClosing = true;
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = null;
                    panel.classList.remove('qlda-noti-opening');
                    prepareNotificationWaterfall();
                    panel.classList.add('qlda-noti-closing');
                    // Chờ chữ biến mất, các hàng tan theo thứ tự ngược rồi mới ẩn khung.
                    _notificationCloseTimer = setTimeout(finishNotificationHide, 650);
                });

                $(document).on('hidden.bs.dropdown', '#bellDropdownWrapper', function () {
                    closeNotificationViewMenu();
                    syncNotificationBackdrop();
                });

                pollNotifications();
                setInterval(pollNotifications, 30000);
            })();
        </script>

        <script type="text/javascript">
            (function () {
                var gridFitFrame = 0;
                var gridFitObserver = null;
                var gridFitNav = null;
                var gridFitMutationObserver = null;

                function getVisibleRect(element) {
                    if (!element || !element.getClientRects().length) return null;
                    var rect = element.getBoundingClientRect();
                    if (rect.width <= 0 || rect.height < 0) return null;
                    return rect;
                }

                function findPagingRoot(body) {
                    if (!body) return null;
                    var paging = body.querySelector('[id*="ctrlGridviewPaging"]');
                    if (paging && paging.getClientRects().length) return paging;
                    var pagination = body.querySelector('.pagination');
                    if (!pagination) return null;
                    return pagination.closest('[id*="Paging"], .d-flex, .row') || pagination;
                }

                function findGridViewport(table, listBody) {
                    if (!table || !listBody) return null;
                    var tableRect = table.getBoundingClientRect();
                    var candidate = table.parentElement;
                    while (candidate && candidate !== listBody) {
                        var style = window.getComputedStyle(candidate);
                        var overflowY = style.overflowY || style.overflow;
                        var hasVerticalOverflow = /auto|scroll|hidden|clip/i.test(overflowY || '');
                        var rect = candidate.getBoundingClientRect();
                        var hasExtraViewportSpace = rect.height > tableRect.height + 30;
                        var contentActuallyOverflows = candidate.scrollHeight > candidate.clientHeight + 5;
                        if (hasVerticalOverflow && candidate.clientHeight > 100 && (hasExtraViewportSpace || contentActuallyOverflows)) return candidate;
                        candidate = candidate.parentElement;
                    }
                    return null;
                }

                function getAvailableBottom() {
                    var footer = document.querySelector('.footer.wrapperFooter');
                    if (footer) {
                        var footerStyle = window.getComputedStyle(footer);
                        var footerRect = footer.getBoundingClientRect();
                        if ((footerStyle.position === 'fixed' || footerStyle.position === 'sticky') && footerRect.top > 0 && footerRect.top < window.innerHeight) return footerRect.top - 8;
                    }
                    return window.innerHeight - 12;
                }

                function sizeGridViewport(table, listBody, paging, bottom) {
                    var viewport = findGridViewport(table, listBody);
                    if (!viewport) return;
                    var viewportRect = viewport.getBoundingClientRect();
                    var pagingRect = getVisibleRect(paging);
                    var pagingHeight = pagingRect ? Math.max(pagingRect.height, paging.scrollHeight || 0) : 0;
                    var bodyStyle = window.getComputedStyle(listBody);
                    var bodyPaddingBottom = parseFloat(bodyStyle.paddingBottom) || 0;
                    var reservedPagingSpace = pagingHeight + bodyPaddingBottom + 16;
                    var availableHeight = Math.floor(bottom - reservedPagingSpace - viewportRect.top);
                    availableHeight = Math.max(90, availableHeight);
                    var currentHeight = parseFloat(viewport.style.height || '0');
                    viewport.classList.add('qlda-grid-fit-viewport');
                    if (Math.abs(currentHeight - availableHeight) > 1) {
                        viewport.style.setProperty('height', availableHeight + 'px', 'important');
                        viewport.style.setProperty('max-height', availableHeight + 'px', 'important');
                    }
                }

                function applyGridFit() {
                    gridFitFrame = 0;
                    var bottom = getAvailableBottom();
                    var pagingControls = Array.prototype.slice.call(document.querySelectorAll('.main-content [id*="ctrlGridviewPaging"]'));
                    if (!pagingControls.length) pagingControls = Array.prototype.slice.call(document.querySelectorAll('.main-content .card-body .pagination'));
                    var foundViewport = false;
                    pagingControls.forEach(function (pagingControl) {
                        if (!pagingControl.getClientRects().length) return;
                        var listBody = pagingControl.closest('.card-body');
                        if (!listBody || !listBody.closest('.main-content') || listBody.closest('.modal, .offcanvas')) return;
                        var paging = pagingControl;
                        if (paging.classList.contains('pagination')) {
                            paging = paging.closest('[id*="Paging"], .d-flex, .row') || paging;
                        }
                        var tables = Array.prototype.slice.call(listBody.querySelectorAll('table')).filter(function (table) {
                            return table.getClientRects().length && !table.closest('.pagination, .modal, .offcanvas');
                        });
                        if (!tables.length) return;
                        var table = tables[0];
                        var viewport = findGridViewport(table, listBody);
                        if (!viewport) return;
                        sizeGridViewport(table, listBody, paging, bottom);
                        foundViewport = true;
                    });
                    document.body.classList.toggle('qlda-grid-fit-page', foundViewport);
                }

                function scheduleGridFit() {
                    if (gridFitFrame) cancelAnimationFrame(gridFitFrame);
                    gridFitFrame = requestAnimationFrame(applyGridFit);
                }

                function attachGridFitObservers() {
                    var nav = document.querySelector('.project-feature-tabs');
                    if (nav !== gridFitNav) {
                        if (gridFitObserver) gridFitObserver.disconnect();
                        gridFitObserver = null;
                        gridFitNav = nav;
                        if (nav && window.ResizeObserver) {
                            gridFitObserver = new ResizeObserver(scheduleGridFit);
                            gridFitObserver.observe(nav);
                        }
                    }
                    scheduleGridFit();
                }

                function initGridFit() {
                    attachGridFitObservers();
                    window.setTimeout(scheduleGridFit, 80);
                    window.setTimeout(scheduleGridFit, 420);
                }

                if (window.jQuery) {
                    jQuery(function () {
                        initGridFit();
                        jQuery(window).off('resize.qldaGridFit orientationchange.qldaGridFit').on('resize.qldaGridFit orientationchange.qldaGridFit', scheduleGridFit);
                        jQuery(document).off('transitionend.qldaGridFit', '.project-feature-tabs').on('transitionend.qldaGridFit', '.project-feature-tabs', scheduleGridFit);
                        if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(initGridFit);
                        }
                        if (window.Sys && Sys.Application) Sys.Application.add_load(initGridFit);
                        if (window.MutationObserver) {
                            gridFitMutationObserver = new MutationObserver(function (mutations) {
                                for (var i = 0; i < mutations.length; i++) {
                                    if (mutations[i].target && mutations[i].target.closest && mutations[i].target.closest('.project-feature-tabs')) {
                                        attachGridFitObservers();
                                        break;
                                    }
                                }
                            });
                            var tabNode = document.querySelector('.project-feature-tabs');
                            if (tabNode) gridFitMutationObserver.observe(tabNode, { attributes: true, attributeFilter: ['class', 'style'] });
                        }
                    });
                }
            })();
        </script>
    </form>
</body>
</html>

