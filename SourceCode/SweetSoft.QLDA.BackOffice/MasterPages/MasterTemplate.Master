                                                            </a>
                                                        </li>
                                                        <li>
                                                            <asp:LinkButton runat="server" ID="lbtLockScreen" data-selector="lbtLockScreen" OnClick="lbtLockScreen_Click" CssClass="dropdown-item flex-center gap-2 ps-0 pt-1 pb-1 text-dark">
                            <i class="mdi mdi-lock font-size-16 align-middle me-1"></i><%= GetResourceText(BackEndResourceKeys.LOCK_SCREEN) %>
                                                            </asp:LinkButton>
                                                        </li>
                                                        <li>
                                                            <hr class="dropdown-divider">
                                                        </li>
                                                        <li>
                                                            <asp:LinkButton runat="server" ID="lbtLogOut" OnClick="lbtLogOut_Click" CssClass="btn btn-danger flex-center gap-2">
                            <i class="mdi mdi-logout font-size-16 align-middle"></i><%= GetResourceText(BackEndResourceKeys.LOGOUT) %>
                                                            </asp:LinkButton>
                                                        </li>
                                                    </ul>
                                                </div>
