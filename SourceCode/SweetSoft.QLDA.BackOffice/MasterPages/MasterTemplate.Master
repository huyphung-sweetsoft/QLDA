                                                                 <a href="javascript:void(0)" id="btnMarkAllRead"
                                                                    class="small text-primary text-decoration-none"
                                                                    style="display:none">Đọc tất cả</a>
                                                             </div>
                                                             <%-- Danh sách --%>
                                                             <div class="notification-body" id="notificationList">
                                                                 <div class="text-center text-muted py-4 small" id="notificationEmpty">
                                                                     <i class="bx bx-bell-off font-size-24 d-block mb-1"></i>
                                                                     Không có thông báo nào
                                                                 </div>
                                                             </div>
                                                             <%-- Footer: Xem thêm --%>
                                                             <div class="border-top text-center py-2" id="notificationFooter" style="display:none">
                                                                 <a href="javascript:void(0)" id="btnLoadMore"
                                                                    class="small text-primary text-decoration-none">
                                                                     <span id="btnLoadMoreText">Xem thêm</span>
                                                                     <span id="btnLoadMoreSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none"></span>
                                                                 </a>
                                                             </div>
                                                         </div>
                                                     </div>

                                                    <div class="avatar__image-box flex-center gap-2 cursor-pointer" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <div class="avatar__image">
