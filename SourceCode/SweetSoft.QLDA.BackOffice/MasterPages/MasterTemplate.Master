                                                    </div>
                                                    <ul class="dropdown-menu p-2">
                                                        <li>
                                                            <h3 runat="server" id="tagName" class="mb-0 fw-bold fs-5 py-2"></h3>
                                                        </li>
                                                        <li>
                                                            <hr class="dropdown-divider">
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item flex-center gap-2 ps-0 pt-1 pb-1 text-dark" href="<%= GetRelativeClientPath("/Profile") %>">
                                                                <i class='bx bx-user-pin font-size-16 align-middle me-1'></i><%= GetResourceText(BackEndResourceKeys.PROFILE) %>
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <button type="button" class="dropdown-item flex-center gap-2 ps-0 pt-1 pb-1 text-dark" data-open-today-schedule title="Xem lịch trình hôm nay của bạn, ấn phím Q để mở nhanh" aria-keyshortcuts="Q" style="width:100%;border:0;background:transparent;text-align:left;">
                                                                <i class="bx bx-calendar-check font-size-16 align-middle me-1" aria-hidden="true"></i> Lịch trình hôm nay
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <asp:LinkButton runat="server" ID="lbtLockScreen" data-selector="lbtLockScreen" OnClick="lbtLockScreen_Click" CssClass="dropdown-item flex-center gap-2 ps-0 pt-1 pb-1 text-dark">
                            <i class="mdi mdi-lock font-size-16 align-middle me-1"></i><%= GetResourceText(BackEndResourceKeys.LOCK_SCREEN) %>
                                                            </asp:LinkButton>
                                                        </li>
                                                        <li>
                                                            <hr class="dropdown-divider">
                                                        </li>
                                                        <li>
                                                            <asp:LinkButton runat="server" ID="lbtLogOut" OnClick="lbtLogOut_Click" CssClass="btn btn-danger flex-center gap-2">
                            <i class="mdi mdi-logout font-size-16 align-middle"></i><%= GetResourceText(BackEndResourceKeys.LOGOUT) %>
                                                            </asp:LinkButton>
                                                        </li>
                                                    </ul>
                                                 </div>
                                                </div>
                                            </div>

                                        </ContentTemplate>
