                                    <span class="text-primary"><b>Ngày:</b> <span id="realtimeClock"></span></span>
                                </span>
                                <span class="text pe-4 performance-loading">
                                    <%--<i class="font-size-12">The page finished loading in <span class="timing-loading">0.52s</span></i>--%>
                                    <%=GetResourceText(BackEndResourceKeys.VERSION) %>: <span runat="server" id="lbVersion"></span>
                                </span>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
        <div class="loading-page-animation">
            <div class="loading-container">
                <div class="loading-text">
                    <span>Preparing</span>
                    <span>data</span>
                    <span>.</span>
                    <span>.</span>
                    <span>.</span>
                </div>
            </div>
        </div>
        <!-- Right bar overlay-->
        <div class="rightbar-overlay"></div>
        <div id="modal-notify" class="modal fade" tabindex="-1" data-bs-scroll="true">
            <asp:UpdatePanel runat="server" ID="pnlDialog" UpdateMode="Always">
                <ContentTemplate>
                    <div class="modal-dialog modal-dialog-centered text-center">
                        <div class="modal-content">
                            <div runat="server" id="modalHeader" class="modal-header">
                                <h5 class="modal-title" id="myModalLabel" runat="server"></h5>
                                <a href="javascript:;" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></a>
                            </div>
                            <div class="modal-body">
                                <asp:Literal ID="lbMessage" runat="server"></asp:Literal>
                            </div>
                            <div class="modal-footer p-1">
                                <SweetSoft:ExtraButton runat="server" ID="btnAccept" CssClass="btn-primary waves-effect waves-light" OnClientClick="return CMSMasterJs.HideModalMessage();" OnClick="btnAccept_Click"></SweetSoft:ExtraButton>
                                <SweetSoft:ExtraButton runat="server" ID="btnCancel" CssClass="btn-secondary waves-effect" ButtonIcon="Close"
                                    OnClick="btnCancel_Click" OnClientClick="CMSMasterJs.CloseMessageBox('#modal-notify');">Close</SweetSoft:ExtraButton>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </asp:UpdatePanel>
        </div>
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
            <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header">
                    <img src="/Styles/images/bell-ring.png" alt="" class="me-2" height="18">
                    <strong class="me-auto"><%= GetResourceText(BackEndResourceKeys.NOTIFICATION) %></strong>
                    <small class="text-muted">just done</small>
                    <button type="button" class="btn-close" data-bs-dismiss="toast"
                        aria-label="Close">
                    </button>
                </div>
                <div class="toast-body">
                    <span class="js-toast-message"></span>
                </div>
            </div>
        </div>

        <div id="file-box-viewer">
            <a id="downloadLink" href="javascript:;" download class="hidden btn-file-download"><i class="fas fa-download"></i></a>
            <span onclick="$('.body-preview').empty(); $('#file-box-viewer').hide();" class="close">&times;</span>
            <div class="body-preview">
            </div>
        </div>

        <input type="hidden" runat="server" id="hdfTabKey" data-selector="hdfTabKey" />
        <a runat="server" id="btnLoadTab" data-selector="btnLoadTab" onserverclick="btnLoadTab_ServerClick"></a>
        <a runat="server" id="btnRefreshPermission" data-selector="btnRefreshPermission" onserverclick="btnRefreshPermission_ServerClick"></a>
        <asp:ContentPlaceHolder ID="cpModalMain" runat="server">
        </asp:ContentPlaceHolder>

        <div class="loader-content">
            <div class="loader">
                <div class="justify-content-center jimu-primary-loading"></div>
            </div>
            <span class="server-message"><%= GetResourceText(BackEndResourceKeys.SYSTEM_IS_PROCESSING_YOUR_REQUEST) %></span>
        </div>
        <%--Render from server--%>
        <asp:ContentPlaceHolder runat="server" ID="cpVendorScript"></asp:ContentPlaceHolder>

        <asp:ContentPlaceHolder ID="cpBottomScript" runat="server"></asp:ContentPlaceHolder>
        <%--<script src="/styles/js/app.js"></script>--%>
        <script>
            $(".wrapBtnCtrMenuHeader .btnCtrMenu").on("click", function (e) {
                $("body").toggleClass("showMenu wrapHidden");
                e.preventDefault();
            });
            $(".wrapperBtncloseMobile").on("click", function (e) {
                $("body").removeClass("showMenu wrapHidden");

                if ($(".showContact").length) {
                    $("body").removeClass("showContact wrapHidden");
                }

                e.preventDefault();
            });
            //$(document).on("click", ".Rootmenu .itemMenuHeader.menuSub", function () {
            //    if ($('.menuSetting').hasClass('showSub')) {
            //        $('.menuSetting .show-menu').toggle();
            //        $('.menuSetting').removeClass('showSub')
            //    }
            //});
        </script>
        <script type="text/javascript">
            var isEnabledLoading = true;
            //Sys.Application.add_init(function () {
            //    var prm = Sys.WebForms.PageRequestManager.getInstance();

            //    prm.add_initializeRequest(function (sender, args) {
            //        console.log({ isEnabledLoading })
            //        if (!isEnabledLoading) return;
            //        const loader = document.querySelector('.loader-content');
            //        if (loader) loader.style.display = 'flex';
            //    });

            //    prm.add_endRequest(function (sender, args) {
            //        const loader = document.querySelector('.loader-content');
            //        if (loader) {
            //            setTimeout(() => {
            //                loader.style.display = 'none';
            //            }, 50);
            //        }
            //    });
            //});

            $(document).on('click', '.nav-item a[data-bs-toggle="tab"]', function () {
                var $dataBtn = $(this).attr('data-selector');
                if ($dataBtn != undefined) {
                    $('[data-selector-group-btn]').hide();
                    $(`[data-selector-group-btn="${$dataBtn}"]`).show();
                }
            });
        </script>

        <script>
            var scrollToTarget = function (target, containerEl) {
                // Moved up here for readability:
                var isElement = target && target.nodeType === 1,
                    isNumber = Object.prototype.toString.call(target) === '[object Number]';

                if (isElement) {
                    containerEl.scrollTop = target.offsetTop;
                } else if (isNumber) {
                    containerEl.scrollTop = target;
                } else if (target === 'bottom') {
                    containerEl.scrollTop = containerEl.scrollHeight - containerEl.offsetHeight;
                } else if (target === 'top') {
                    containerEl.scrollTop = 0;
                }
            };
            $(document).ready(function () {
                $('body').removeClass('loadingPage');
            })
            function provinceQuery(params) {
                const id = parseInt($('[data-selector="ddlCountry"]').val());
                var obj = {
                    keyword: params.term || "",
                    countryId: id || 'd8842bf3-7071-44d3-80eb-92b31a133bcc',
                    page: params.page || 1,
                    page_limit: 10
                };
                return JSON.stringify(obj);
            }

            function wardQuery(params) {
                const id = $('[data-selector="ddlProvince"]').val();
                var obj = {
                    keyword: params.term || "",
                    districtId: id || '00000000-0000-0000-0000-000000000000',
                    page: params.page || 1,
                    page_limit: 10
                };
                return JSON.stringify(obj);
            }
            CMSMasterJs.ChangeTarget = () => {
                $('[data-selector="ddlTargetId"]').select2("val", "");
            }
            $(document).on('select2:open', () => {
                document.querySelector('.select2-search__field').focus();
            });
        </script>
        <script>
            function AllUser() {
                return '/WebService.asmx/GetUsers';
            }
            function AllCustomer() {
                return '/WebService.asmx/AllCustomer';
            }
            function AllVehicles() {
                return '/api/v1/AllVehicles';
            }
            function AllDrivers() {
                return '/api/v1/AllDrivers';
            }
        </script>
        <script>
            function updateTime() {
                const now = new Date();

                const day = String(now.getDate()).padStart(2, '0');
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const year = now.getFullYear();

                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');

                const formatted = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;

                document.getElementById('realtimeClock').textContent = formatted;
            }
            updateTime();
            setInterval(updateTime, 1000);
        </script>
        <script>
            // ================================================================
            // Notification Bell — Polling + Lazy Load
            // ================================================================
            (function () {
                var _currentPage = 1;
                var _hasMore     = false;
                var _loading     = false;
                var _initialized = false;

                // ---- Icon helpers ----
                var iconMap = {
                    'CONG_VIEC' : { icon: 'bx bx-task',         bg: 'bg-primary-subtle',  text: 'text-primary'  },
                    'DU_AN'     : { icon: 'bx bx-briefcase',    bg: 'bg-success-subtle',  text: 'text-success'  },
                    'LICH_HOP'  : { icon: 'bx bx-calendar',    bg: 'bg-warning-subtle',  text: 'text-warning'  },
                    'VAN_DE'    : { icon: 'bx bx-error-circle', bg: 'bg-danger-subtle',   text: 'text-danger'   },
                    'TAI_LIEU'  : { icon: 'bx bx-file',        bg: 'bg-info-subtle',     text: 'text-info'     },
                    'HE_THONG'  : { icon: 'bx bx-bell',        bg: 'bg-secondary-subtle',text: 'text-secondary'}
                };

                function getIconMeta(loai) {
                    return iconMap[loai] || iconMap['HE_THONG'];
                }

                // ---- Render một notification item ----
                function buildItem(n) {
                    var meta    = getIconMeta(n.loaiThongBao);
                    var unread  = !n.daDoc ? 'fw-semibold' : '';
                    var bgUnread= !n.daDoc ? 'style="background:#f0f4ff"' : '';
                    var link    = n.duongDanLienKet || 'javascript:void(0)';

                    return '<a href="' + link + '" ' +
                                'class="notification-item d-flex gap-2 px-3 py-2 text-decoration-none text-dark" ' +
                                bgUnread + ' ' +
                                'data-id="' + n.id + '" ' +
                                'onclick="NotificationBell.onItemClick(this, event)">' +
                               '<div class="notification-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 ' + meta.bg + '">' +
                                   '<i class="' + meta.icon + ' ' + meta.text + ' font-size-18"></i>' +
                               '</div>' +
                               '<div class="flex-grow-1 overflow-hidden">' +
                                   '<p class="mb-0 ' + unread + ' text-truncate fs-14">' + n.tieuDe + '</p>' +
                                   '<small class="text-muted">' + n.ngayTao + '</small>' +
                               '</div>' +
                           '</a>';
                }

                // ---- Cập nhật badge ----
                function updateBadge(count) {
                    var badge = document.getElementById('badgeUnread');
                    if (!badge) return;
                    if (count > 0) {
                        badge.textContent = count > 99 ? '99+' : count;
                        badge.style.display = '';
                    } else {
                        badge.style.display = 'none';
                    }
                }

                // ---- Gọi API đếm badge & lấy thông báo mới (polling 30s) ----
                function pollNotifications() {
                    $.ajax({
                        type       : 'POST',
                        url        : '/WebService.asmx/GetLatestNotifications',
                        contentType: 'application/json; charset=utf-8',
                        dataType   : 'json',
                        success    : function (res) {
                            if (!res || !res.d || !res.d.success) return;

                            var result = res.d;

                            // 1. Cập nhật badge
                            updateBadge(result.unreadCount);

                            var markAll = document.getElementById('btnMarkAllRead');
                            if (markAll) markAll.style.display = result.unreadCount > 0 ? '' : 'none';

                            // 2. Cập nhật danh sách thông báo
                            if (result.data && result.data.length > 0) {
                                var list = document.getElementById('notificationList');
                                if (!list) return;

                                result.data.forEach(function (n) {
                                    var exists = document.querySelector('#notificationList .notification-item[data-id="' + n.id + '"]');
                                    if (!exists) {
                                        list.insertAdjacentHTML('afterbegin', buildItem(n));
                                    }
                                });

                                var empty = document.getElementById('notificationEmpty');
                                if (empty) empty.style.display = 'none';
                            }
                        }
                    });
                }

                // ---- Tải danh sách thông báo ----
                function loadNotifications(page) {
                    if (_loading) return;
                    _loading = true;

                    var spinner = document.getElementById('btnLoadMoreSpinner');
                    if (spinner) spinner.style.display = '';

                    $.ajax({
                        type       : 'POST',
                        url        : '/WebService.asmx/GetNotifications',
                        contentType: 'application/json; charset=utf-8',
                        data       : JSON.stringify({ page: page }),
                        dataType   : 'json',
                        success    : function (res) {
                            if (!res || !res.d || !res.d.success) return;

                            var result = res.d;
                            var list   = document.getElementById('notificationList');
                            var empty  = document.getElementById('notificationEmpty');
                            var footer = document.getElementById('notificationFooter');

                            if (page === 1) {
                                list.innerHTML = '';
                            }

                            if (result.data && result.data.length > 0) {
                                if (empty) empty.style.display = 'none';
                                result.data.forEach(function (n) {
                                    list.insertAdjacentHTML('beforeend', buildItem(n));
                                });
                            } else if (page === 1) {
                                if (empty) empty.style.display = '';
                            }

                            _hasMore     = result.hasMore;
                            _currentPage = page;
                            if (footer) footer.style.display = _hasMore ? '' : 'none';
                        },
                        complete: function () {
                            _loading = false;
                            if (spinner) spinner.style.display = 'none';
                        }
                    });
                }

                // ---- Xử lý click vào item (đánh dấu đã đọc) ----
                window.NotificationBell = {
                    onItemClick: function (el, evt) {
                        var id   = el.getAttribute('data-id');
                        var href = el.getAttribute('href');

                        // Đánh dấu đã đọc
                        $.ajax({
                            type       : 'POST',
                            url        : '/WebService.asmx/MarkNotificationAsRead',
                            contentType: 'application/json; charset=utf-8',
                            data       : JSON.stringify({ id: id }),
                            dataType   : 'json'
                        });

                        // Bỏ highlight chưa đọc
                        el.removeAttribute('style');
                        var title = el.querySelector('p');
                        if (title) title.classList.remove('fw-semibold');

                        // Giảm badge
                        var badge = document.getElementById('badgeUnread');
                        if (badge && badge.style.display !== 'none') {
                            var cnt = parseInt(badge.textContent) || 0;
                            cnt = Math.max(0, cnt - 1);
                            updateBadge(cnt);
                        }
                    }
                };

                // ---- Đọc tất cả ----
                $(document).on('click', '#btnMarkAllRead', function () {
                    $.ajax({
                        type       : 'POST',
                        url        : '/WebService.asmx/MarkAllNotificationsAsRead',
                        contentType: 'application/json; charset=utf-8',
                        dataType   : 'json',
                        success    : function () {
                            // Bỏ toàn bộ highlight
                            $('#notificationList .notification-item').each(function () {
                                $(this).removeAttr('style');
                                $(this).find('p').removeClass('fw-semibold');
                            });
                            updateBadge(0);
                            $('#btnMarkAllRead').hide();
                        }
                    });
                });

                // ---- Xem thêm ----
                $(document).on('click', '#btnLoadMore', function () {
                    loadNotifications(_currentPage + 1);
                });

                // ---- Lần đầu mở dropdown: load trang 1 ----
                $(document).on('show.bs.dropdown', '#bellDropdownWrapper', function () {
                    if (!_initialized) {
                        _initialized = true;
                        loadNotifications(1);
                    }
                });

                // ---- Polling 30s ----
                pollNotifications();
                setInterval(pollNotifications, 30000);

            })();
        </script>
    </form>
</body>
</html>

