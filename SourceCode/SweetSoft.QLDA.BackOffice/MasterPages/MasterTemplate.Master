    <%--CSS--%>
    <link href="/Styles/css/fonts.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/bootstrap.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/icon.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/Boxicon.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/toastr.css" rel="stylesheet" type="text/css" />
<link href="~/Styles/css/floating-work-timer.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="/Styles/css/app.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/custom-style.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/plugins/validationEngine/validationEngine.jquery.css" rel="stylesheet" type="text/css" />
    <%--INIT JS--%>
