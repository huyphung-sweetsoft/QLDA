            //    });
            //});

            $(document).on('click', '.nav-item a[data-bs-toggle="tab"]', function () {
                var $dataBtn = $(this).attr('data-selector');
                if ($dataBtn != undefined) {
                    $('[data-selector-group-btn]').hide();
                    $(`[data-selector-group-btn="${$dataBtn}"]`).show();
                }
            });
        </script>

        <script>
            var scrollToTarget = function (target, containerEl) {
                // Moved up here for readability:
                var isElement = target && target.nodeType === 1,
                    isNumber = Object.prototype.toString.call(target) === '[object Number]';

                if (isElement) {
                    containerEl.scrollTop = target.offsetTop;
                } else if (isNumber) {
                    containerEl.scrollTop = target;
                } else if (target === 'bottom') {
                    containerEl.scrollTop = containerEl.scrollHeight - containerEl.offsetHeight;
                } else if (target === 'top') {
                    containerEl.scrollTop = 0;
                }
            };
            $(document).ready(function () {
                $('body').removeClass('loadingPage');
            })
            function provinceQuery(params) {
                const id = parseInt($('[data-selector="ddlCountry"]').val());
                var obj = {
                    keyword: params.term || "",
                    countryId: id || 'd8842bf3-7071-44d3-80eb-92b31a133bcc',
                    page: params.page || 1,
                    page_limit: 10
                };
                return JSON.stringify(obj);
            }

            function wardQuery(params) {
                const id = $('[data-selector="ddlProvince"]').val();
                var obj = {
                    keyword: params.term || "",
                    districtId: id || '00000000-0000-0000-0000-000000000000',
                    page: params.page || 1,
                    page_limit: 10
                };
                return JSON.stringify(obj);
            }
            CMSMasterJs.ChangeTarget = () => {
                $('[data-selector="ddlTargetId"]').select2("val", "");
            }
            $(document).on('select2:open', () => {
                document.querySelector('.select2-search__field').focus();
            });
        </script>
        <script>
            function AllUser() {
                return '/WebService.asmx/GetUsers';
            }
            function AllCustomer() {
                return '/WebService.asmx/AllCustomer';
            }
            function AllVehicles() {
                return '/api/v1/AllVehicles';
            }
            function AllDrivers() {
                return '/api/v1/AllDrivers';
            }
        </script>
        <script>
            function updateTime() {
                const now = new Date();

                const day = String(now.getDate()).padStart(2, '0');
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const year = now.getFullYear();

                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');

                const formatted = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;

                document.getElementById('realtimeClock').textContent = formatted;
            }
            updateTime();
            setInterval(updateTime, 1000);
        </script>
        <script>
            // Notification center: mỗi lần mở lấy trang đầu (10 dòng); chỉ nút Xem thêm mới lấy trang kế tiếp.
            // Polling 30 giây chỉ đếm chưa đọc, không tự nạp dữ liệu danh sách.
            (function () {
                var _items = [];
                var _byId = Object.create(null);
                var _currentPage = 0;
                var _hasMore = false;
                var _loading = false;
                var _initialized = false;
                var _unreadCount = 0;
                var _hasUnreadCount = false;
                var _lastBellWrapper = null;
                // Giữ chính phần tử chuông hiện có, kể cả khi UpdatePanel thay vùng tài khoản.
                var _persistentBell = document.getElementById('bellDropdownWrapper');
                var _bellRestorePending = false;
                var _statusFilter = 'all';
                var _typeFilter = 'all';
                var _dateFilter = 'all';
                var _viewMode = 'compact'; // Chế độ mặc định là popup nhỏ cạnh chuông.
                var _preview = null;
                var _previewTarget = null;
                var _requestToken = 0;
                var _listRequest = null; // jqXHR cua trang thong bao dang tai; dung de huy request cu.
                var _listElement = null; // ASP.NET UpdatePanel có thể thay DOM của chuông.
                var _notificationRealtimeEnabled = <%= SweetSoft.QLDA.BackOffice.Realtime.QldaRealtimeSettings.NotificationsEnabled ? "true" : "false" %>;
                var _realtimeRefreshTimer = null;
                var _pollInFlight = false, _pollAgain = false;

                var iconMap = {
                    'CONG_VIEC': { icon: 'bx bx-task', css: 'qlda-noti-icon-task', label: 'Công việc' },
                    'DU_AN': { icon: 'bx bx-briefcase', css: 'qlda-noti-icon-project', label: 'Dự án' },
                    'LICH_HOP': { icon: 'bx bx-calendar', css: 'qlda-noti-icon-meeting', label: 'Lịch họp' },
                    'VAN_DE': { icon: 'bx bx-error-circle', css: 'qlda-noti-icon-issue', label: 'Vấn đề' },
                    'TAI_LIEU': { icon: 'bx bx-file', css: 'qlda-noti-icon-document', label: 'Tài liệu' },
                    'HE_THONG': { icon: 'bx bx-bell', css: 'qlda-noti-icon-system', label: 'Hệ thống' }
                };

                function asText(value) {
                    return value === null || value === undefined ? '' : String(value);
                }
                function esc(value) {
                    return asText(value).replace(/&/g, '&amp;').replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                }
                function getMeta(type) {
                    return iconMap[asText(type).toUpperCase()] || { icon: 'bx bx-bell', css: 'qlda-noti-icon-system', label: 'Khác' };
                }
                function parseDate(value) {
                    if (!value) return null;
                    if (value instanceof Date) return isNaN(value.getTime()) ? null : value;
                    var s = asText(value).trim();
                    var dotNet = /\/Date\((-?\d+)(?:[+-]\d+)?\)\//.exec(s);
                    if (dotNet) {
                        var msDate = new Date(Number(dotNet[1]));
                        return isNaN(msDate.getTime()) ? null : msDate;
                    }
                    var vn = /^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[\sT]+(\d{1,2}):(\d{2})(?::(\d{2}))?)?/.exec(s);
                    if (vn) {
                        var d = new Date(+vn[3], +vn[2] - 1, +vn[1], +(vn[4] || 0), +(vn[5] || 0), +(vn[6] || 0));
                        return d.getFullYear() === +vn[3] && d.getMonth() === (+vn[2] - 1) && d.getDate() === +vn[1] ? d : null;
                    }
                    var isoDate = new Date(s);
                    return isNaN(isoDate.getTime()) ? null : isoDate;
                }
                function displayDate(n) {
                    var raw = n.ngayTao;
                    if (typeof raw === 'string' && /^\d{1,2}\/\d{1,2}\/\d{4}/.test(raw)) return raw;
                    var date = parseDate(raw);
                    if (!date) return asText(raw) || 'Không rõ thời gian';
                    function pad(v) { return String(v).padStart(2, '0'); }
                    return pad(date.getDate()) + '/' + pad(date.getMonth() + 1) + '/' + date.getFullYear() +
                        ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
                }
                function dateGroup(n) {
                    var date = parseDate(n.ngayTao);
                    if (!date) return { key: 'unknown', title: 'Chưa rõ thời gian' };
                    var today = new Date();
                    today.setHours(0, 0, 0, 0);
                    var itemDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
                    var diff = Math.round((today.getTime() - itemDay.getTime()) / 86400000);
                    if (diff <= 0) return { key: 'today', title: 'Hôm nay' };
                    if (diff === 1) return { key: 'yesterday', title: 'Hôm qua' };
                    if (diff < 7) return { key: 'week', title: '7 ngày gần đây' };
                    return { key: 'older', title: 'Trước đó' };
                }
                function safeLink(value) {
                    var url = asText(value).trim();
                    if (!url || /^javascript:/i.test(url) || url === '#') return '#';
                    try {
                        var parsed = new URL(url, window.location.href);
                        return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.href : '#';
                    } catch (e) { return '#'; }
                }
                function compareNewest(a, b) {
                    var da = parseDate(a.ngayTao), db = parseDate(b.ngayTao);
                    return (db ? db.getTime() : 0) - (da ? da.getTime() : 0);
                }
                function replaceItems(items) {
                    _items = [];
                    _byId = Object.create(null);
                    mergeItems(items);
                }
                function mergeItems(items) {
                    var changed = false;
                    (items || []).forEach(function (n) {
                        if (!n || n.id === undefined || n.id === null) return;
                        var key = asText(n.id);
                        if (_byId[key]) {
                            // Chỉ vẽ lại khi thông báo thay đổi, tránh giật khi polling.
                            var stored = _byId[key];
                            Object.keys(n).forEach(function (field) {
                                if (stored[field] !== n[field]) {
                                    stored[field] = n[field];
                                    changed = true;
                                }
                            });
                        } else {
                            _byId[key] = Object.assign({}, n);
                            _items.push(_byId[key]);
                            changed = true;
                        }
                    });
                    if (changed) _items.sort(compareNewest);
                    return changed;
                }
                function updateBadge(count, items) {
                    if (typeof count === 'number' && isFinite(count)) {
                        _unreadCount = Math.max(0, count);
                        _hasUnreadCount = true;
                    }
                    var badge = document.getElementById('badgeUnread');
                    var markAll = document.getElementById('btnMarkAllRead');
                    var subtitle = document.getElementById('notificationSubtitle');
                    var toggle = document.getElementById('bellToggle');
                    if (badge) {
                        badge.textContent = _unreadCount > 99 ? '99+' : String(_unreadCount);
                        badge.style.display = _unreadCount ? '' : 'none';
                    }
                    if (subtitle) subtitle.textContent = _unreadCount ? (_unreadCount + ' thông báo chưa đọc') : 'Bạn đã xem hết các thông báo mới';
                    if (markAll && !markAll.disabled) markAll.style.display = _unreadCount ? '' : 'none';
                    if (toggle) toggle.setAttribute('aria-label', _unreadCount ? 'Mở thông báo, ' + _unreadCount + ' chưa đọc' : 'Mở thông báo');
                    if (window.QldaNotifyAssistant) window.QldaNotifyAssistant.update(_unreadCount, Array.isArray(items) ? items : null);
                }
                function isUnread(n) { return n.daDoc === false || n.daDoc === 0 || n.daDoc === 'false' || n.daDoc === 'False'; }
                // Tuần bắt đầu từ thứ Hai; mọi mốc thời gian theo múi giờ trình duyệt.
                function dateFilterStart() {
                    var now = new Date();
                    if (_dateFilter === 'week') {
                        var mondayOffset = (now.getDay() + 6) % 7;
                        return new Date(now.getFullYear(), now.getMonth(), now.getDate() - mondayOffset);
                    }
                    if (_dateFilter === 'month') return new Date(now.getFullYear(), now.getMonth(), 1);
                    return null;
                }
                function getVisibleItems() {
                    var start = dateFilterStart();
                    var now = new Date();
                    return _items.filter(function (n) {
                        if (_statusFilter === 'unread' && !isUnread(n)) return false;
                        if (start) {
                            var created = parseDate(n.ngayTao);
                            if (!created || created < start || created > now) return false;
                        }
                        if (_typeFilter === 'all') return true;
                        var type = asText(n.loaiThongBao).toUpperCase();
                        return _typeFilter === 'other' ? !iconMap[type] : type === _typeFilter;
                    });
                }
                function buildItem(n) {
                    var meta = getMeta(n.loaiThongBao);
                    var unread = isUnread(n);
                    var link = safeLink(n.duongDanLienKet);
                    var id = esc(n.id);
                    return '<div class="notification-item' + (unread ? ' is-unread' : '') + '" data-id="' + id + '">' +
                        '<a class="qlda-noti-link" href="' + esc(link) + '" aria-label="' + esc(n.tieuDe || 'Thông báo') + '">' +
                        '<span class="notification-icon ' + meta.css + '"><i class="' + meta.icon + '" aria-hidden="true"></i></span>' +
                        '<span class="qlda-noti-copy">' +
                        '<span class="qlda-noti-topline"><span class="qlda-noti-category">' + esc(meta.label) + '</span>' +
                        (unread ? '<span class="qlda-noti-unread-dot" aria-label="Chưa đọc"></span>' : '') + '</span>' +
                        '<span class="qlda-noti-item-title">' + esc(n.tieuDe || 'Thông báo') + '</span>' +
                        (getContent(n) ? '<span class="qlda-noti-snippet">' + esc(getContent(n)) + '</span>' : '') +
                        '<span class="qlda-noti-time"><i class="bx bx-time-five" aria-hidden="true"></i>' + esc(displayDate(n)) + '</span>' +
                        '</span>' +
                        '</a>' +
                        '<button type="button" class="qlda-noti-detail" data-id="' + id + '" title="Xem thông tin chi tiết" aria-label="Xem chi tiết thông báo">' +
                        '<i class="bx bx-info-circle" aria-hidden="true"></i></button>' +
                        '</div>';
                }
                function emptyHtml() {
                    var filtered = _typeFilter !== 'all' || _statusFilter !== 'all' || _dateFilter !== 'all';
                    return '<div class="qlda-noti-empty"><div class="qlda-noti-empty-icon"><i class="bx ' +
                        (filtered ? 'bx-filter-alt' : 'bx-bell-off') + '" aria-hidden="true"></i></div>' +
                        '<strong>' + (filtered ? 'Chưa tìm thấy thông báo phù hợp' : 'Chưa có thông báo nào') + '</strong>' +
                        '<span>' + (filtered ? 'Bạn có thể đổi bộ lọc hoặc tải thêm thông báo.' : 'Các cập nhật mới sẽ xuất hiện tại đây.') + '</span></div>';
                }
                function draw() {
                    updateStatusToggle();
                    var list = document.getElementById('notificationList');
                    if (!list || !_initialized || _loading && _currentPage === 0) return;
                    hidePreview();
                    var priorScroll = list.scrollTop;
                    var visible = getVisibleItems();
                    if (!visible.length) {
                        list.innerHTML = emptyHtml();
                    } else {
                        var html = '';
                        var lastGroup = '';
                        var counts = {};
                        visible.forEach(function (n) {
                            var g = dateGroup(n);
                            counts[g.key] = (counts[g.key] || 0) + 1;
                        });
                        visible.forEach(function (n) {
                            var group = dateGroup(n);
                            if (group.key !== lastGroup) {
                                html += '<div class="qlda-noti-group-title"><span>' + group.title + '</span><span>' + counts[group.key] + ' thông báo</span></div>';
                                lastGroup = group.key;
                            }
                            html += buildItem(n);
                        });
                        list.innerHTML = html;
                    }
                    list.scrollTop = priorScroll;
                    // Nếu WebService trả dữ liệu trong lúc popup đang mở, các hàng mới vẫn nhận hiệu ứng.
                    var openPanel = document.querySelector('#bellDropdownWrapper .notification.qlda-noti-opening');
                    if (openPanel) prepareNotificationWaterfall();
                    var footer = document.getElementById('notificationFooter');
                    var note = document.getElementById('notificationFilterNote');
                    if (footer) footer.style.display = _hasMore ? '' : 'none';
                    if (note) note.style.display = _hasMore && (_statusFilter !== 'all' || _typeFilter !== 'all' || _dateFilter !== 'all') ? '' : 'none';
                }
                function showLoading() {
                    var list = document.getElementById('notificationList');
                    if (!list) return;
                    var html = '';
                    for (var i = 0; i < 3; i++) {
                        html += '<div class="qlda-noti-skeleton" aria-hidden="true"><div class="qlda-noti-skeleton-icon"></div>' +
                            '<div class="qlda-noti-skeleton-content"><span class="qlda-noti-skeleton-line"></span><span class="qlda-noti-skeleton-line"></span></div></div>';
                    }
                    list.innerHTML = html;
                }
                function loadNotifications(page) {
                    // Một request = một trang dữ liệu (10 thông báo); không nạp tiếp tự động.
                    if (_loading || page < 1 || page !== _currentPage + 1) return;
                    _loading = true;
                    var token = ++_requestToken;
                    var spinner = document.getElementById('btnLoadMoreSpinner');
                    var more = document.getElementById('btnLoadMore');
                    if (page === 1) showLoading();
                    if (spinner) spinner.style.display = '';
                    if (more) more.disabled = true;
                    _listRequest = $.ajax({
                        type: 'POST', url: '/WebService.asmx/GetNotifications',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ page: page }), dataType: 'json'
                    }).done(function (res) {
                        if (token !== _requestToken) return;
                        if (!res || !res.d || !res.d.success) {
                            if (_currentPage === 0) renderError('Không thể tải danh sách thông báo.');
                            return;
                        }
                        var result = res.d;
                        if (page === 1) {
                            replaceItems(result.data);
                            // Chuông đã có nội dung: đồng bộ Hybrid luôn, không gọi API thêm.
                            if (window.QldaNotifyAssistant && Array.isArray(result.data))
                                window.QldaNotifyAssistant.update(_unreadCount, result.data);
                        } else mergeItems(result.data);
                        _hasMore = !!result.hasMore;
                        _currentPage = page;
                        draw();
                    }).fail(function (xhr, status) {
                        if (token !== _requestToken || status === 'abort') return;
                        if (_currentPage === 0) renderError('Không thể kết nối để tải thông báo.');
                    }).always(function () {
                        if (token !== _requestToken) return;
                        _listRequest = null;
                        _loading = false;
                        if (spinner) spinner.style.display = 'none';
                        if (more) more.disabled = false;
                        if (_currentPage > 0) draw();
                    });
                }
                function reloadFirstNotificationPage() {
                    // Mỗi lần mở chuông đều khởi đầu từ trang 1, không giữ các trang đã xem
                    // và không cho phản hồi của request cũ chen vào trang vừa mở.
                    ++_requestToken;
                    if (_listRequest && _listRequest.readyState !== 4) _listRequest.abort();
                    _listRequest = null;
                    _loading = false;
                    _initialized = true;
                    _currentPage = 0;
                    _hasMore = false;
                    _items = [];
                    _byId = Object.create(null);
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    var footer = document.getElementById('notificationFooter');
                    if (footer) footer.style.display = 'none';
                    updateStatusToggle();
                    loadNotifications(1);
                }
                function renderError(message) {
                    var list = document.getElementById('notificationList');
                    if (list) list.innerHTML = '<div class="qlda-noti-empty"><div class="qlda-noti-empty-icon"><i class="bx bx-wifi-off"></i></div>' +
                        '<strong>' + esc(message) + '</strong><span>Đóng rồi mở lại chuông để thử tải lại.</span></div>';
                    _initialized = false;
                }
                var _hybridPreviewRequest = null;
                function loadHybridPreview() {
                    if (_hybridPreviewRequest || _unreadCount <= 0 || !window.QldaNotifyAssistant) return;
                    // GetUnreadCount có thể chỉ trả về số; lấy riêng trang 1 (10 bản ghi)
                    // để Hybrid có title, content, link và id ngay cả khi chuông chưa mở.
                    _hybridPreviewRequest = $.ajax({
                        type: 'POST',
                        url: '/WebService.asmx/GetNotifications',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ page: 1 }), dataType: 'json',
                        timeout: 10000
                    }).done(function (res) {
                        if (res && res.d && res.d.success && Array.isArray(res.d.data) &&
                            window.QldaNotifyAssistant)
                            window.QldaNotifyAssistant.update(_unreadCount, res.d.data);
                    }).fail(function (xhr, status) {
                        if (status !== 'abort') console.warn('[QLDA] Hybrid: không thể tải preview thông báo.', status);
                    }).always(function () { _hybridPreviewRequest = null; });
                }
                function pollNotifications(isPeriodicRefresh) {
                    if (_pollInFlight) { _pollAgain = true; return; }
                    _pollInFlight = true;
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/GetUnreadCount',
                        contentType: 'application/json; charset=utf-8', dataType: 'json'
                    }).done(function (res) {
                        if (!res || !res.d || !res.d.success) return;
                        // WebService.asmx/GetUnreadCount trả về {success:true,count:N}.
                        // Chỉ giữ unreadCount làm tương thích nếu có phiên bản API khác;
                        // KHÔNG biến một thuộc tính thiếu/sai định dạng thành số 0.
                        var rawCount = res.d.count !== undefined && res.d.count !== null
                            ? res.d.count : res.d.unreadCount;
                        if (rawCount === undefined || rawCount === null || rawCount === '') {
                            console.warn('[QLDA] GetUnreadCount thiếu thuộc tính count:', res.d);
                            return;
                        }
                        var count = Number(rawCount);
                        if (!isFinite(count) || count < 0) {
                            console.warn('[QLDA] GetUnreadCount trả count không hợp lệ:', rawCount);
                            return;
                        }
                        count = Math.floor(count);
                        // Nháy mắt đúng khi chuông hoàn tất lần poll 30 giây;
                        // không nháy với các request realtime, modal hoặc UpdatePanel.
                        if (isPeriodicRefresh === true && window.QldaNotifyAssistant &&
                            typeof window.QldaNotifyAssistant.blink === 'function')
                            window.QldaNotifyAssistant.blink();
                        // Không chuyển bản ghi rút gọn (chỉ ID/trạng thái) thành preview.
                        var previewReady = Array.isArray(res.d.data) && res.d.data.some(function (n) {
                            return n && n.id !== undefined && n.id !== null &&
                                isUnread(n) && (n.tieuDe || n.tieuDeThongBao);
                        });
                        updateBadge(count, previewReady ? res.d.data : null);
                        if (count > 0 && !previewReady) loadHybridPreview();
                        if (_initialized && _currentPage > 0 && !_loading && mergeItems(res.d.data)) {
                            draw();
                        }
                    }).always(function () {
                        _pollInFlight = false;
                        if (_pollAgain) {
                            _pollAgain = false;
                            pollNotifications();
                        }
                    });
                }
                function scheduleRealtimeNotificationRefresh() {
                    // Nen duy nhat signal "co thay doi"; du lieu that lay qua WebService.
                    if (_realtimeRefreshTimer != null) clearTimeout(_realtimeRefreshTimer);
                    _realtimeRefreshTimer = setTimeout(function () {
                        _realtimeRefreshTimer = null;
                        pollNotifications();
                    }, 160);
                }
                function connectNotificationRealtime() {
                    if (!_notificationRealtimeEnabled || !window.QldaRealtime ||
                        typeof window.QldaRealtime.on !== 'function') return;
                    window.QldaRealtime.on(function (event) {
                        if (!event) return;
                        if (event.kind === 'notifications-changed' ||
                            event.kind === 'connection-restored') {
                            scheduleRealtimeNotificationRefresh();
                        }
                    });
                    var connecting = window.QldaRealtime.start('<%= ResolveUrl("~/qlda-realtime") %>');
                    if (connecting && typeof connecting.fail === 'function') {
                        connecting.fail(function () {
                            // Mat ket noi => chuong van poll 30 giay. Khong can alert.
                        });
                    }
                }
                function getContent(n) {
                    var candidates = [n.noiDung, n.noiDungThongBao, n.moTa, n.moTaThongBao, n.content, n.message, n.thongDiep];
                    for (var i = 0; i < candidates.length; i++) {
                        if (candidates[i] !== null && candidates[i] !== undefined && asText(candidates[i]).trim()) return asText(candidates[i]);
                    }
                    return '';
                }
                function hidePreview() {
                    if (_preview && _preview.parentNode) _preview.parentNode.removeChild(_preview);
                    _preview = null;
                    _previewTarget = null;
                }
                function showPreview(target) {
                    var item = target && target.closest ? target.closest('.notification-item') : null;
                    if (!item) return;
                    var n = _byId[item.getAttribute('data-id')];
                    if (!n) return;
                    if (_previewTarget === item && _preview) return;
                    hidePreview();
                    var description = getContent(n);
                    var href = safeLink(n.duongDanLienKet);
                    var preview = document.createElement('div');
                    preview.className = 'qlda-noti-preview';
                    preview.setAttribute('role', 'tooltip');
                    preview.innerHTML =
                        '<div class="qlda-noti-preview-head"><span class="qlda-noti-preview-type">' + esc(getMeta(n.loaiThongBao).label) + '</span>' +
                        '<span class="qlda-noti-preview-status' + (isUnread(n) ? '' : ' is-read') + '">' + (isUnread(n) ? 'Chưa đọc' : 'Đã đọc') + '</span></div>' +
                        '<div class="qlda-noti-preview-title">' + esc(n.tieuDe || 'Thông báo') + '</div>' +
                        (description ? '<div class="qlda-noti-preview-content">' + esc(description) + '</div>' :
                            '<div class="qlda-noti-preview-content qlda-noti-preview-muted">Thông báo này chưa có mô tả chi tiết trong dữ liệu trả về.</div>') +
                        '<div class="qlda-noti-preview-foot"><span><i class="bx bx-calendar"></i>' + esc(displayDate(n)) + '</span>' +
                        (href !== '#' ? '<span><i class="bx bx-link-external"></i>Nhấn thông báo để xem liên kết</span>' : '') + '</div>';
                    document.body.appendChild(preview);
                    _preview = preview;
                    _previewTarget = item;
                    var rect = item.getBoundingClientRect();
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    var panelRect = panel ? panel.getBoundingClientRect() : rect;
                    var width = preview.offsetWidth;
                    var height = preview.offsetHeight;
                    var left;
                    if (panelRect.left >= width + 16) left = panelRect.left - width - 9;
                    else if (window.innerWidth - panelRect.right >= width + 16) left = panelRect.right + 9;
                    else left = Math.min(Math.max(11, rect.left), Math.max(11, window.innerWidth - width - 11));
                    var top = rect.top;
                    if (panelRect.left < width + 16 && window.innerWidth - panelRect.right < width + 16) {
                        top = rect.bottom + 6;
                        if (top + height > window.innerHeight - 11) top = rect.top - height - 6;
                    }
                    top = Math.max(11, Math.min(top, window.innerHeight - height - 11));
                    preview.style.left = Math.round(left) + 'px';
                    preview.style.top = Math.round(top) + 'px';
                }
                // Một lối xử lý duy nhất cho click item trong danh sách và click preview Hybrid.
                function activateNotification(n, rawLink, openBellWhenNoLink) {
                    var link = safeLink(rawLink || (n && n.duongDanLienKet));
                    hidePreview();
                    function navigate() {
                        if (link !== '#') { if (window.QLDAPageNavigation) window.QLDAPageNavigation.start(false); window.location.assign(link); }
                        else if (openBellWhenNoLink && window.NotificationBell && window.NotificationBell.openPanel)
                            window.NotificationBell.openPanel();
                    }
                    if (!n || !isUnread(n)) { navigate(); return; }
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/MarkNotificationAsRead',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ id: n.id }), dataType: 'json', timeout: 4500
                    }).done(function (res) {
                        if (res && res.d && res.d.success === false) return;
                        n.daDoc = true;
                        if (_byId[String(n.id)]) _byId[String(n.id)].daDoc = true;
                        updateBadge(Math.max(0, _unreadCount - 1));
                        draw();
                    }).always(navigate);
                }
                function onItemClick(el, evt) {
                    if (evt) evt.preventDefault();
                    var item = el.closest('.notification-item');
                    if (!item) return;
                    activateNotification(_byId[item.getAttribute('data-id')], el.getAttribute('href'), false);
                }
                window.NotificationBell = window.NotificationBell || {};
                window.NotificationBell.onItemClick = onItemClick;
                window.NotificationBell.openFromAssistant = function (notification) {
                    activateNotification(notification, notification && notification.duongDanLienKet, true);
                };
                window.NotificationBell.displayDate = displayDate;
                window.NotificationBell.compareNewest = compareNewest;
                window.NotificationBell.getUnreadCount = function () { return _unreadCount; };
                window.NotificationBell.refreshHybridPreview = loadHybridPreview;

                function updateStatusToggle() {
                    var btn = document.getElementById('btnToggleUnread');
                    var label = document.getElementById('notificationStatusToggleText');
                    var icon = document.getElementById('notificationStatusToggleIcon');
                    if (!btn) return;
                    var unreadOnly = _statusFilter === 'unread';
                    var actionLabel = unreadOnly ? 'Tất cả' : 'Chưa đọc';
                    if (label) label.textContent = actionLabel;
                    if (icon) icon.className = unreadOnly ? 'bx bx-list-ul' : 'bx bx-filter-alt';
                    btn.classList.remove('is-active', 'mode-all', 'mode-unread');
                    btn.classList.add(unreadOnly ? 'mode-all' : 'mode-unread');
                    btn.setAttribute('aria-pressed', unreadOnly ? 'true' : 'false');
                    btn.setAttribute('aria-label', unreadOnly ? 'Hiện tất cả thông báo' : 'Chỉ xem thông báo chưa đọc');
                    btn.title = unreadOnly ? 'Hiện tất cả thông báo' : 'Chỉ xem thông báo chưa đọc';
                }
                $(document).on('click', '#btnToggleUnread', function () {
                    _statusFilter = _statusFilter === 'unread' ? 'all' : 'unread';
                    updateStatusToggle();
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    draw();
                });
                $(document).on('change', '#notificationTypeFilter', function () {
                    _typeFilter = this.value;
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    draw();
                });
                $(document).on('change', '#notificationDateFilter', function () {
                    _dateFilter = this.value;
                    var list = document.getElementById('notificationList');
                    if (list) list.scrollTop = 0;
                    draw();
                });
                $(document).on('click', '#btnMarkAllRead', function () {
                    var btn = this;
                    btn.disabled = true;
                    $.ajax({
                        type: 'POST', url: '/WebService.asmx/MarkAllNotificationsAsRead',
                        contentType: 'application/json; charset=utf-8', dataType: 'json'
                    }).done(function (res) {
                        if (res && res.d && res.d.success === false) return;
                        _items.forEach(function (n) { n.daDoc = true; });
                        updateBadge(0);
                        draw();
                    }).always(function () {
                        btn.disabled = false;
                        updateBadge(_unreadCount);
                    });
                });
                $(document).on('click', '#btnLoadMore', function () {
                    if (!_loading && _hasMore) loadNotifications(_currentPage + 1);
                });
                $(document).on('click', '#notificationList .qlda-noti-link', function (evt) {
                    window.NotificationBell.onItemClick(this, evt);
                });
                $(document).on('mouseenter focusin', '#notificationList .notification-item', function () {
                    showPreview(this);
                });
                $(document).on('mouseleave focusout', '#notificationList .notification-item', function (e) {
                    if (e.type === 'focusout' && this.contains(e.relatedTarget)) return;
                    if (_previewTarget === this) hidePreview();
                });
                $(document).on('click', '#notificationList .qlda-noti-detail', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    showPreview(this);
                });
                $(document).on('scroll', '#notificationList', hidePreview);
                $(window).on('resize.qldaNotification', function () { hidePreview(); positionNotificationDropdown(); });
                $(document).on('keydown.qldaNotification', function (e) {
                    if (e.key === 'Escape') hidePreview();
                });
                $(document).on('click.qldaNotification', function (e) {
                    if (_preview && !$(e.target).closest('#notificationList .notification-item').length) hidePreview();
                });
                function closeNotificationViewMenu() {
                    var menu = document.getElementById('notificationViewMenu');
                    var button = document.getElementById('btnNotificationView');
                    if (menu) menu.hidden = true;
                    if (button) button.setAttribute('aria-expanded', 'false');
                }
                function syncNotificationBackdrop() {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    var backdrop = document.getElementById('notificationViewBackdrop');
                    if (!backdrop) return;
                    var expandedAndVisible = !!panel && panel.classList.contains('show') &&
                        panel.classList.contains('qlda-noti-expanded');
                    backdrop.classList.toggle('is-visible', expandedAndVisible);
                }
                function setNotificationViewMode(mode) {
                    _viewMode = mode === 'expanded' ? 'expanded' : 'compact';
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (panel) {
                        panel.classList.toggle('qlda-noti-expanded', _viewMode === 'expanded');
                        panel.setAttribute('aria-label', _viewMode === 'expanded' ? 'Thông báo, chế độ xem rộng' : 'Thông báo, chế độ thu gọn');
                    }
                    var icon = document.getElementById('notificationViewIcon');
                    var picker = document.getElementById('btnNotificationView');
                    if (icon) icon.className = _viewMode === 'expanded' ? 'bx bx-collapse-alt' : 'bx bx-layout';
                    if (picker) picker.title = _viewMode === 'expanded' ? 'Đang xem rộng · nhấn F để thu gọn' : 'Đang thu gọn · nhấn F để xem rộng';
                    $('#notificationViewMenu .qlda-noti-view-option').each(function () {
                        var selected = this.getAttribute('data-view-mode') === _viewMode;
                        this.classList.toggle('is-selected', selected);
                        this.setAttribute('aria-checked', selected ? 'true' : 'false');
                    });
                    closeNotificationViewMenu();
                    hidePreview();
                    positionNotificationDropdown();
                    syncNotificationBackdrop();
                }
                // Phím F: chuyển nhanh giữa Xem rộng / Thu gọn khi bảng thông báo đang mở.
                // Không chiếm phím trong input, textarea, select, vùng soạn thảo hay tổ hợp Ctrl/Alt/Meta.
                $(document).off('keydown.qldaNotificationSize').on('keydown.qldaNotificationSize', function (event) {
                    var key = event.key || (event.which === 70 ? 'f' : '');
                    if (String(key).toLowerCase() !== 'f' || event.ctrlKey || event.altKey || event.metaKey || event.repeat || event.isComposing) return;
                    var target = event.target;
                    if (target && ($(target).closest('input, textarea, select, [contenteditable], [role="textbox"], .CodeMirror, .monaco-editor').length || target.isContentEditable)) return;
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (!panel || !panel.classList.contains('show') || _notificationClosing) return;
                    event.preventDefault();
                    event.stopPropagation();
                    setNotificationViewMode(_viewMode === 'expanded' ? 'compact' : 'expanded');
                });
                $(document).on('click', '#btnNotificationView', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    var menu = document.getElementById('notificationViewMenu');
                    if (!menu) return;
                    var open = menu.hidden;
                    menu.hidden = !open;
                    this.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                $(document).on('click', '#notificationViewMenu .qlda-noti-view-option', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    setNotificationViewMode(this.getAttribute('data-view-mode'));
                    var button = document.getElementById('btnNotificationView');
                    if (button) button.focus();
                });
                $(document).on('click', function (event) {
                    if (!$(event.target).closest('#notificationViewPicker').length) closeNotificationViewMenu();
                });
                $(document).on('keydown', '#notificationViewPicker', function (event) {
                    if (event.key === 'Escape' && document.getElementById('notificationViewMenu') && !document.getElementById('notificationViewMenu').hidden) {
                        event.stopPropagation();
                        closeNotificationViewMenu();
                        var button = document.getElementById('btnNotificationView');
                        if (button) button.focus();
                    }
                });
                function closeExpandedNotification() {
                    closeNotificationPanel();
                }
                $(document).on('click', '#notificationViewBackdrop, #btnCloseNotificationExpanded', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    closeExpandedNotification();
                });
                function positionNotificationDropdown() {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    var toggle = document.getElementById('bellToggle');
                    if (!panel || !toggle) return;
                    if (panel.classList.contains('qlda-noti-expanded')) return; // CSS canh chính giữa màn hình.
                    var toggleRect = toggle.getBoundingClientRect();
                    var bellBottom = toggleRect.bottom;
                    panel.style.setProperty('--qlda-noti-top', Math.round(Math.max(8, Math.min(bellBottom + 10, window.innerHeight - 90))) + 'px');
                    var rightInset;
                    if (window.innerWidth <= 575) {
                        rightInset = 8;
                    } else {
                        var container = document.querySelector('.main-content .page-content .container-fluid');
                        if (!container) container = document.querySelector('.main-content');
                        if (!container) container = document.querySelector('.layout-content');
                        if (!container) container = document.querySelector('.contentHeader .container-fluid');
                        rightInset = container ? (window.innerWidth - container.getBoundingClientRect().right) : 0;
                    }
                    rightInset = Math.round(Math.max(0, Math.min(rightInset, Math.max(0, window.innerWidth - 140))));
                    panel.style.setProperty('--qlda-noti-edge-right', rightInset + 'px');
                    var panelWidth = panel.offsetWidth || parseFloat(window.getComputedStyle(panel).width) || 365;
                    var panelRightEdge = window.innerWidth - rightInset;
                    var bellCenterX = toggleRect.left + (toggleRect.width / 2);
                    var pointerRight = panelRightEdge - bellCenterX - 10;
                    pointerRight = Math.round(Math.max(18, Math.min(pointerRight, Math.max(18, panelWidth - 42))));
                    panel.style.setProperty('--qlda-noti-pointer-right', pointerRight + 'px');
                }
                // Chỉ animate các hàng thực sự nhìn thấy, tối đa 6: không làm nặng danh sách dài.
                function prepareNotificationWaterfall() {
                    var list = document.getElementById('notificationList');
                    if (!list) return;
                    var bounds = list.getBoundingClientRect();
                    var elements = Array.prototype.slice.call(list.children);
                    var rows = [];
                    elements.forEach(function (el) {
                        el.classList.remove('qlda-noti-waterfall-step');
                        el.style.removeProperty('--qlda-noti-in-delay');
                        el.style.removeProperty('--qlda-noti-text-delay');
                        el.style.removeProperty('--qlda-noti-out-delay');
                        var rect = el.getBoundingClientRect();
                        if (rows.length < 6 && rect.height > 0 && rect.top < bounds.bottom && rect.bottom > bounds.top)
                            rows.push(el);
                    });
                    rows.forEach(function (el, index) {
                        el.style.setProperty('--qlda-noti-in-delay', (90 + index * 44) + 'ms');
                        el.style.setProperty('--qlda-noti-text-delay', (215 + index * 44) + 'ms');
                        el.style.setProperty('--qlda-noti-out-delay', (145 + (rows.length - index - 1) * 32) + 'ms');
                        el.classList.add('qlda-noti-waterfall-step');
                    });
                }
                var _notificationOpeningTimer = null;
                var _notificationClosing = false;
                var _notificationManualMode = false;
                // Dung chung mot API cho chuong header va nhan vat Hybrid.
                // Bootstrap co the khong khoi tao do tai script/UpdatePanel; khi do dung fallback.
                function getNotificationDropdown() {
                    var toggle = document.getElementById('bellToggle');
                    if (!toggle || !window.bootstrap || !window.bootstrap.Dropdown) return null;
                    var ctor = window.bootstrap.Dropdown;
                    return typeof ctor.getOrCreateInstance === 'function'
                        ? ctor.getOrCreateInstance(toggle)
                        : (typeof ctor.getInstance === 'function' && ctor.getInstance(toggle)) || new ctor(toggle);
                }
                function manualNotificationShow() {
                    var wrapper = document.getElementById('bellDropdownWrapper');
                    var toggle = document.getElementById('bellToggle');
                    var panel = wrapper && wrapper.querySelector('.notification');
                    if (!wrapper || !toggle || !panel || panel.classList.contains('show')) return;
                    $(wrapper).trigger('show.bs.dropdown');
                    toggle.classList.add('show');
                    panel.classList.add('show');
                    toggle.setAttribute('aria-expanded', 'true');
                    _notificationManualMode = true;
                    $(wrapper).trigger('shown.bs.dropdown');
                }
                function manualNotificationHide() {
                    var wrapper = document.getElementById('bellDropdownWrapper');
                    var toggle = document.getElementById('bellToggle');
                    var panel = wrapper && wrapper.querySelector('.notification');
                    if (!wrapper || !toggle || !panel) return;
                    panel.classList.remove('show', 'qlda-noti-opening', 'qlda-noti-closing');
                    toggle.classList.remove('show');
                    toggle.setAttribute('aria-expanded', 'false');
                    _notificationManualMode = false;
                    $(wrapper).trigger('hidden.bs.dropdown');
                    syncNotificationBackdrop();
                }
                function openNotificationPanel() {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (!panel || panel.classList.contains('show')) return;
                    try {
                        var dropdown = getNotificationDropdown();
                        if (dropdown) dropdown.show();
                        else if (typeof $('#bellToggle').dropdown === 'function') $('#bellToggle').dropdown('show');
                    } catch (error) {
                        console.warn('[QLDA] Bootstrap dropdown: chuyen sang mo du phong.', error);
                    }
                    if (!panel.classList.contains('show')) manualNotificationShow();
                }
                function closeNotificationPanel() {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (!panel) return;
                    if (panel.classList.contains('show')) {
                        try {
                            var dropdown = getNotificationDropdown();
                            if (dropdown) dropdown.hide();
                            else if (typeof $('#bellToggle').dropdown === 'function') $('#bellToggle').dropdown('hide');
                        } catch (error) {
                            console.warn('[QLDA] Bootstrap dropdown: chuyen sang dong du phong.', error);
                        }
                    }
                    // Neu thu vien khong dong duoc, khong de backdrop / class .show bi ket.
                    if (panel.classList.contains('show')) manualNotificationHide();
                    else syncNotificationBackdrop();
                }
                window.NotificationBell.openPanel = openNotificationPanel;
                window.NotificationBell.closePanel = closeNotificationPanel;
                window.NotificationBell.togglePanel = function () {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (panel && panel.classList.contains('show')) closeNotificationPanel();
                    else openNotificationPanel();
                };
                // Nút chuông và Hybrid dùng cùng open/close API. Gắn ngay trên
                // chính thẻ <a> để không phụ thuộc bubbling của menu/Bootstrap.
                // onclick được giữ khi ASP.NET UpdatePanel thay thế nút chuông.
                window.NotificationBell.handleBellClick = function (event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    window.NotificationBell.togglePanel();
                    return false;
                };
                // Chặn trạng thái kẹt khi Bootstrap được mở bằng API hoặc fallback.
                // Click NGOÀI luôn đóng chuông, bất kể _notificationManualMode.
                // Click trên chính chuông sẽ để handleBellClick tự toggle (tránh đóng-mở kép).
                // Click trong popup (bộ lọc, list, xem thêm...) không bị can thiệp.
                document.addEventListener('click', function (event) {
                    var panel = document.querySelector('#bellDropdownWrapper .notification');
                    if (!panel || !panel.classList.contains('show')) return;
                    var target = event.target;
                    if (!target || !target.closest) return;
                    if (target.closest('#bellToggle')) return;
                    if (target.closest('#bellDropdownWrapper .notification')) return;
                    closeNotificationPanel();
                }, true);
                $(document).on('show.bs.dropdown', '#bellDropdownWrapper', function () {
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = null;
                    _notificationClosing = false;
                    var panel = this.querySelector('.notification');
                    if (panel) panel.classList.remove('qlda-noti-closing', 'qlda-noti-open', 'qlda-noti-opening');
                    try {
                        setNotificationViewMode(_viewMode);
                        positionNotificationDropdown();
                    } catch (error) {
                        // Khong de loi canh vi tri/bo loc ngan Bootstrap mo popup.
                        console.warn('[QLDA] Khong the canh dropdown thong bao:', error);
                    }
                    // Tach fetch du lieu khoi su kien SHOW. AJAX gap loi van mo duoc chuong.
                    // Moi lan mo chi nap trang 1, Xem them moi nap trang tiep theo.
                    setTimeout(function () {
                        try { reloadFirstNotificationPage(); }
                        catch (error) { console.error('[QLDA] Loi nap thong bao:', error); }
                    }, 0);
                });
                $(document).on('shown.bs.dropdown', '#bellDropdownWrapper', function () {
                    positionNotificationDropdown();
                    syncNotificationBackdrop();
                    var panel = this.querySelector('.notification');
                    if (!panel || _notificationClosing) return;
                    prepareNotificationWaterfall();
                    panel.classList.add('qlda-noti-opening');
                    // Hết hiệu ứng thì bỏ lớp animation, để hover và filter hoạt động bình thường.
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = setTimeout(function () {
                        panel.classList.remove('qlda-noti-opening');
                        _notificationOpeningTimer = null;
                    }, 670);
                });
                $(document).on('hide.bs.dropdown', '#bellDropdownWrapper', function () {
                    // Khong preventDefault: Bootstrap phai duoc dong that de co the mo lai.
                    hidePreview();
                    closeNotificationViewMenu();
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = null;
                    _notificationClosing = false;
                    var panel = this.querySelector('.notification');
                    if (panel) panel.classList.remove('qlda-noti-opening', 'qlda-noti-closing');
                    var backdrop = document.getElementById('notificationViewBackdrop');
                    if (backdrop) backdrop.classList.remove('is-visible');
                });

                $(document).on('hidden.bs.dropdown', '#bellDropdownWrapper', function () {
                    _notificationManualMode = false;
                    closeNotificationViewMenu();
                    syncNotificationBackdrop();
                });

                // Gắn chuông vào cùng hàng của menu tài khoản. Dùng container riêng
                // bên cạnh .wrapperRight để Bootstrap dropdown của avatar không chọn nhầm menu chuông.
                // Nếu UpdatePanel render lại menu, giữ node cũ và di chuyển vào wrapper mới.
                function ensureBellInAccountMenu() {
                    if (!_persistentBell) return false;
                    var header = document.querySelector('.wrapHeader .qlda-header-actions');
                    if (!header) return false;
                    var accountRegion = header.querySelector('[id$="pnlInfo"] .qlda-header-stable-user');
                    if (!accountRegion) return false;
                    if (_persistentBell.parentNode === accountRegion) return false;
                    // Không mở popup trong lúc chuyển DOM; reset dropdown cũ nếu cần.
                    var existingPanel = _persistentBell.querySelector('.notification');
                    if (existingPanel && existingPanel.classList.contains('show')) closeNotificationPanel();
                    accountRegion.insertBefore(_persistentBell, accountRegion.firstChild);
                    return true;
                }
                function restoreBellAfterPartialPostback() {
                    var moved = ensureBellInAccountMenu();
                    var wrapper = document.getElementById('bellDropdownWrapper');
                    if (!wrapper) return;
                    var replaced = wrapper !== _lastBellWrapper;
                    _lastBellWrapper = wrapper;
                    if (!replaced && !moved) return;
                    hidePreview();
                    _notificationManualMode = false;
                    _notificationClosing = false;
                    if (_notificationOpeningTimer) clearTimeout(_notificationOpeningTimer);
                    _notificationOpeningTimer = null;
                    var panel = wrapper.querySelector('.notification');
                    var toggle = wrapper.querySelector('#bellToggle');
                    if (panel) panel.classList.remove('show', 'qlda-noti-opening', 'qlda-noti-closing');
                    if (toggle) {
                        toggle.classList.remove('show');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                    syncNotificationBackdrop();
                    if (_hasUnreadCount) updateBadge(_unreadCount);
                    // Đồng bộ count từ server khi DOM bị thay; không reset khi chỉ đóng popup.
                    if (moved || replaced) pollNotifications();
                }
                if (window.Sys && Sys.Application)
                    Sys.Application.add_load(restoreBellAfterPartialPostback);
                if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                    var prmBell = Sys.WebForms.PageRequestManager.getInstance();
                    if (prmBell) prmBell.add_endRequest(restoreBellAfterPartialPostback);
                }
                // ExtraModal/UpdatePanel không phải lúc nào cũng kích hoạt endRequest
                // ở script này. Theo dõi DOM HEADER (không theo dõi toàn trang) để
                // phục hồi node chuông ngay sau khi menu tài khoản bị thay.
                var headerForBell = document.querySelector('.wrapHeader');
                if (headerForBell && window.MutationObserver) {
                    var bellObserver = new MutationObserver(function () {
                        if (_bellRestorePending) return;
                        var mount = document.querySelector('.wrapHeader .qlda-header-actions [id$="pnlInfo"] .qlda-header-stable-user');
                        if (!mount || (_persistentBell && _persistentBell.parentNode === mount)) return;
                        _bellRestorePending = true;
                        // Microtask đủ để chờ hoàn thành đợt thay DOM hiện tại.
                        Promise.resolve().then(function () {
                            _bellRestorePending = false;
                            restoreBellAfterPartialPostback();
                        });
                    });
                    bellObserver.observe(headerForBell, { childList: true, subtree: true });
                }
                // Đóng bảng trước khi modal khác mở; sau khi modal đóng, đảm bảo
                // backdrop và badge chuông không bị kẹt do cập nhật WebForms.
                $(document).on('show.bs.modal', function (event) {
                    if (!event.target || !event.target.closest || !event.target.closest('#bellDropdownWrapper'))
                        closeNotificationPanel();
                });
                $(document).on('hidden.bs.modal', function () {
                    restoreBellAfterPartialPostback();
                    syncNotificationBackdrop();
                });
                // Xoa backdrop con sot tu lan mo truoc neu DOM duoc ASP.NET cap nhat.
                syncNotificationBackdrop();
                restoreBellAfterPartialPostback();
                connectNotificationRealtime();
                setInterval(function () { pollNotifications(true); }, 30000);
            })();
        </script>

        <script type="text/javascript">
            (function () {
                var gridFitFrame = 0;
                var gridFitObserver = null;
                var gridFitNav = null;
                var gridFitMutationObserver = null;

                function getVisibleRect(element) {
                    if (!element || !element.getClientRects().length) return null;
                    var rect = element.getBoundingClientRect();
                    if (rect.width <= 0 || rect.height < 0) return null;
                    return rect;
                }

                function findPagingRoot(body) {
                    if (!body) return null;
                    var paging = body.querySelector('[id*="ctrlGridviewPaging"]');
                    if (paging && paging.getClientRects().length) return paging;
                    var pagination = body.querySelector('.pagination');
                    if (!pagination) return null;
                    return pagination.closest('[id*="Paging"], .d-flex, .row') || pagination;
                }

                function findGridViewport(table, listBody) {
                    if (!table || !listBody) return null;
                    var tableRect = table.getBoundingClientRect();
                    var candidate = table.parentElement;
                    while (candidate && candidate !== listBody) {
                        var style = window.getComputedStyle(candidate);
                        var overflowY = style.overflowY || style.overflow;
                        var hasVerticalOverflow = /auto|scroll|hidden|clip/i.test(overflowY || '');
                        var rect = candidate.getBoundingClientRect();
                        var hasExtraViewportSpace = rect.height > tableRect.height + 30;
                        var contentActuallyOverflows = candidate.scrollHeight > candidate.clientHeight + 5;
                        if (hasVerticalOverflow && candidate.clientHeight > 100 && (hasExtraViewportSpace || contentActuallyOverflows)) return candidate;
                        candidate = candidate.parentElement;
                    }
                    return null;
                }

                function getAvailableBottom() {
                    var footer = document.querySelector('.footer.wrapperFooter');
                    if (footer) {
                        var footerStyle = window.getComputedStyle(footer);
                        var footerRect = footer.getBoundingClientRect();
                        if ((footerStyle.position === 'fixed' || footerStyle.position === 'sticky') && footerRect.top > 0 && footerRect.top < window.innerHeight) return footerRect.top - 8;
                    }
                    return window.innerHeight - 12;
                }

                function sizeGridViewport(table, listBody, paging, bottom) {
                    var viewport = findGridViewport(table, listBody);
                    if (!viewport) return;
                    var viewportRect = viewport.getBoundingClientRect();
                    var pagingRect = getVisibleRect(paging);
                    var pagingHeight = pagingRect ? Math.max(pagingRect.height, paging.scrollHeight || 0) : 0;
                    var bodyStyle = window.getComputedStyle(listBody);
                    var bodyPaddingBottom = parseFloat(bodyStyle.paddingBottom) || 0;
                    var reservedPagingSpace = pagingHeight + bodyPaddingBottom + 16;
                    var availableHeight = Math.floor(bottom - reservedPagingSpace - viewportRect.top);
                    availableHeight = Math.max(90, availableHeight);
                    var currentHeight = parseFloat(viewport.style.height || '0');
                    viewport.classList.add('qlda-grid-fit-viewport');
                    if (Math.abs(currentHeight - availableHeight) > 1) {
                        viewport.style.setProperty('height', availableHeight + 'px', 'important');
                        viewport.style.setProperty('max-height', availableHeight + 'px', 'important');
                    }
                }

                function applyGridFit() {
                    gridFitFrame = 0;
                    var bottom = getAvailableBottom();
                    var pagingControls = Array.prototype.slice.call(document.querySelectorAll('.main-content [id*="ctrlGridviewPaging"]'));
                    if (!pagingControls.length) pagingControls = Array.prototype.slice.call(document.querySelectorAll('.main-content .card-body .pagination'));
                    var foundViewport = false;
                    pagingControls.forEach(function (pagingControl) {
                        if (!pagingControl.getClientRects().length) return;
                        var listBody = pagingControl.closest('.card-body');
                        if (!listBody || !listBody.closest('.main-content') || listBody.closest('.modal, .offcanvas')) return;
                        var paging = pagingControl;
                        if (paging.classList.contains('pagination')) {
                            paging = paging.closest('[id*="Paging"], .d-flex, .row') || paging;
                        }
                        var tables = Array.prototype.slice.call(listBody.querySelectorAll('table')).filter(function (table) {
                            return table.getClientRects().length && !table.closest('.pagination, .modal, .offcanvas');
                        });
                        if (!tables.length) return;
                        var table = tables[0];
                        var viewport = findGridViewport(table, listBody);
                        if (!viewport) return;
                        sizeGridViewport(table, listBody, paging, bottom);
                        foundViewport = true;
                    });
                    document.body.classList.toggle('qlda-grid-fit-page', foundViewport);
                }

                function scheduleGridFit() {
                    if (gridFitFrame) cancelAnimationFrame(gridFitFrame);
                    gridFitFrame = requestAnimationFrame(applyGridFit);
                }

                function attachGridFitObservers() {
                    var nav = document.querySelector('.project-feature-tabs');
                    if (nav !== gridFitNav) {
                        if (gridFitObserver) gridFitObserver.disconnect();
                        gridFitObserver = null;
                        gridFitNav = nav;
                        if (nav && window.ResizeObserver) {
                            gridFitObserver = new ResizeObserver(scheduleGridFit);
                            gridFitObserver.observe(nav);
                        }
                    }
                    scheduleGridFit();
                }

                function initGridFit() {
                    attachGridFitObservers();
                    window.setTimeout(scheduleGridFit, 80);
                    window.setTimeout(scheduleGridFit, 420);
                }

                if (window.jQuery) {
                    jQuery(function () {
                        initGridFit();
                        jQuery(window).off('resize.qldaGridFit orientationchange.qldaGridFit').on('resize.qldaGridFit orientationchange.qldaGridFit', scheduleGridFit);
                        jQuery(document).off('transitionend.qldaGridFit', '.project-feature-tabs').on('transitionend.qldaGridFit', '.project-feature-tabs', scheduleGridFit);
                        if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(initGridFit);
                        }
                        if (window.Sys && Sys.Application) Sys.Application.add_load(initGridFit);
                        if (window.MutationObserver) {
                            gridFitMutationObserver = new MutationObserver(function (mutations) {
                                for (var i = 0; i < mutations.length; i++) {
                                    if (mutations[i].target && mutations[i].target.closest && mutations[i].target.closest('.project-feature-tabs')) {
                                        attachGridFitObservers();
                                        break;
                                    }
                                }
                            });
                            var tabNode = document.querySelector('.project-feature-tabs');
                            if (tabNode) gridFitMutationObserver.observe(tabNode, { attributes: true, attributeFilter: ['class', 'style'] });
                        }
                    });
                }
            })();
        </script>

        <script type="text/javascript">
            // Hybrid: dùng chung dữ liệu/thao tác với chuông; chỉ announce khi phát hiện ID mới.
            (function () {
                var host = document.getElementById('qldaNotifyAssistant');
                if (!host || window.QldaNotifyAssistant) return;
                var bubble = host.querySelector('.qna-bubble');
                var trigger = host.querySelector('.qna-trigger');
                var title = document.getElementById('qnaTitle');
                var description = document.getElementById('qnaDescription');
                var countLabel = document.getElementById('qnaCount');
                var typeLabel = document.getElementById('qnaType');
                var stateLabel = document.getElementById('qnaState');
                var timeLabel = document.querySelector('#qnaTime span');
                var currentCount = 0, activeItem = null, newestItem = null;
                var announceTimer = null, announcingId = null, initializedIds = false;
                var soundContext = null; // Web Audio: một âm báo nhẹ/ID, chỉ sau user gesture.
                var pending = [], pendingSet = Object.create(null);
                var accountKey = '<%= SweetContext.Current.UserId.ToString("N") %>';
                var enabledKey = 'SweetSoftQLDA.NotiAssistant.HybridEnabled.v2.' + accountKey;
                var announcedKey = 'SweetSoftQLDA.NotiAssistant.announcedIds.v2.' + accountKey;
                var seenKey = 'SweetSoftQLDA.NotiAssistant.knownIds.v1.' + accountKey;

                function readLocal(key, fallback) {
                    try { var value = localStorage.getItem(key); return value === null ? fallback : value; }
                    catch (e) { return fallback; }
                }
                function writeLocal(key, value) { try { localStorage.setItem(key, value); } catch (e) { } }
                function parseIds(value) {
                    try { var data = JSON.parse(value); return Array.isArray(data) ? data.slice(-300).map(String) : []; }
                    catch (e) { return []; }
                }
                var enabled = readLocal(enabledKey, '1') !== '0';
                var hasPriorBaseline = readLocal(seenKey, null) !== null;
                var seenIds = parseIds(readLocal(seenKey, '[]'));
                var announcedIds = parseIds(readLocal(announcedKey, '[]'));
                var seenSet = Object.create(null), announcedSet = Object.create(null);
                seenIds.forEach(function (id) { seenSet[id] = true; });
                announcedIds.forEach(function (id) { announcedSet[id] = true; });

                function addId(id, ids, set, key) {
                    id = String(id);
                    if (set[id]) return;
                    set[id] = true;
                    ids.push(id);
                    if (ids.length > 300) {
                        var removed = ids.shift();
                        delete set[removed];
                    }
                    writeLocal(key, JSON.stringify(ids));
                }
                function pick() {
                    for (var i = 0; i < arguments.length; i++) {
                        if (arguments[i] !== null && arguments[i] !== undefined) {
                            var value = String(arguments[i]).trim();
                            if (value) return value;
                        }
                    }
                    return '';
                }
                function unread(n) {
                    return !!n && (n.daDoc === false || n.daDoc === 0 ||
                        n.daDoc === 'false' || n.daDoc === 'False');
                }
                function typeText(n) {
                    var code = pick(n && n.loaiThongBao).toUpperCase();
                    var labels = {
                        'LICH_HOP': 'Lịch họp', 'CONG_VIEC': 'Công việc',
                        'DU_AN': 'Dự án', 'VAN_DE': 'Vấn đề',
                        'TAI_LIEU': 'Tài liệu', 'HE_THONG': 'Hệ thống'
                    };
                    return labels[code] || pick(n && n.tenLoaiThongBao, n && n.loaiThongBaoText, 'Thông báo');
                }
                function contentText(n) {
                    return pick(n && n.noiDung, n && n.noiDungThongBao, n && n.moTa,
                        n && n.moTaThongBao, n && n.content, n && n.message,
                        n && n.thongDiep);
                }
                function recent(n, maxAge) {
                    // Chỉ ngoại lệ cho lần chạy đầu: cho phép announce thông báo tạo <= 5 phút.
                    if (!n || !n.ngayTao) return false;
                    var raw = String(n.ngayTao);
                    var match = /\/Date\((-?\d+)(?:[+-]\d+)?\)\//.exec(raw);
                    var date = match ? new Date(Number(match[1])) : null;
                    if (!date) {
                        var vn = /^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[\sT]+(\d{1,2}):(\d{2}))?/.exec(raw);
                        if (vn) date = new Date(+vn[3], +vn[2] - 1, +vn[1], +(vn[4] || 0), +(vn[5] || 0));
                        else date = new Date(raw);
                    }
                    var delta = Date.now() - date.getTime();
                    return isFinite(delta) && delta >= -30000 && delta <= (maxAge || 300000);
                }
                function setBubble(n, isNew) {
                    // Không announce: hover chỉ xem tổng chưa đọc, không hiện thông báo cũ.
                    n = isNew ? n : null;
                    activeItem = n || null;
                    if (typeLabel) typeLabel.textContent = n ? typeText(n) : 'Thông báo';
                    if (stateLabel) stateLabel.textContent = isNew ? 'Chưa đọc' : 'Trợ lý';
                    if (title) title.textContent = n
                        ? pick(n.tieuDe, n.tieuDeThongBao, 'Thông báo mới')
                        : (currentCount ? 'Bạn có ' + currentCount + ' thông báo chưa đọc' : 'Bạn đã xem hết thông báo');
                    if (description) description.textContent = n
                        ? (contentText(n) || 'Nhấn để xem nội dung thông báo.')
                        : (currentCount ? 'Nhấn robot hoặc nút mở thông báo để xem danh sách.' : 'Hiện không có thông báo chưa đọc.');
                    if (timeLabel) timeLabel.textContent = n && window.NotificationBell && window.NotificationBell.displayDate
                        ? window.NotificationBell.displayDate(n) : 'Di chuột để xem tổng số chưa đọc';
                    if (trigger) trigger.setAttribute('aria-label', currentCount
                        ? 'Mở danh sách ' + currentCount + ' thông báo chưa đọc' : 'Mở trung tâm thông báo');
                }
                function syncToggle() {
                    var toggle = document.getElementById('btnHybridAssistantToggle');
                    if (!toggle) return;
                    toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
                    toggle.setAttribute('aria-label', enabled ? 'Tắt trợ lý Hybrid' : 'Bật trợ lý Hybrid');
                    toggle.title = enabled ? 'Tắt trợ lý Hybrid' : 'Bật trợ lý Hybrid';
                    var label = toggle.querySelector('.qna-hybrid-switch-text');
                    if (label) label.textContent = enabled ? 'Bật' : 'Tắt';
                }
                function noteCount() {
                    if (countLabel) {
                        countLabel.textContent = currentCount > 99 ? '99+' : String(currentCount);
                        countLabel.hidden = !currentCount;
                    }
                    host.classList.toggle('qna-no-unread', currentCount === 0);
                }
                function stopAnnouncement() {
                    if (announceTimer) clearTimeout(announceTimer);
                    announceTimer = null;
                    announcingId = null;
                    host.classList.remove('is-announcing');
                }
                function bellOpen() {
                    return !!document.querySelector('#bellDropdownWrapper .notification.show');
                }
                function motionAllowed() {
                    return enabled && !host.hidden && !document.hidden &&
                        !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
                }
                // Gỡ class rồi ép reflow để lần poll tiếp theo luôn phát lại được animation.
                function playMotion(className) {
                    if (!motionAllowed()) return;
                    host.classList.remove(className);
                    void host.offsetWidth;
                    host.classList.add(className);
                }
                function blink() { playMotion('qna-blinking'); }
                function jump() { playMotion('qna-jumping'); }
                // Đồng bộ chớp mắt với sóng đầu tiên, không phát lặp theo sóng thứ hai.
                // CSS chạy chu kỳ 7 giây; mỗi chu kỳ chỉ một lần blink.
                if (trigger) trigger.addEventListener('animationiteration', function (event) {
                    if (event.animationName === 'qna-ripple-first')
                        setTimeout(blink, 320);
                });
                // Khớp nhịp sóng đầu lúc tải trang; không đổi chớp mắt khi poll 30 giây.
                setTimeout(blink, 320);
                // Dọn class sau khi animation hoàn thành; giảm chi phí rendering.
                host.addEventListener('animationend', function (event) {
                    if (event.animationName === 'qna-hybrid-blink') host.classList.remove('qna-blinking');
                    if (event.animationName === 'qna-hybrid-hop') host.classList.remove('qna-jumping');
                });
                function unlockNotificationAudio() {
                    if (!enabled) return;
                    try {
                        var AudioClass = window.AudioContext || window.webkitAudioContext;
                        if (!AudioClass) return;
                        if (!soundContext) soundContext = new AudioClass();
                        if (soundContext.state === 'suspended') {
                            var resume = soundContext.resume();
                            if (resume && typeof resume.catch === 'function') resume.catch(function () { });
                        }
                    } catch (e) { /* Không chặn thông báo khi trình duyệt không cho phát tiếng. */ }
                }
                // Phát đúng 1 lần khi bắt đầu thẻ chi tiết của một ID mới.
                function playNotificationSound() {
                    if (!enabled || !soundContext || soundContext.state !== 'running') return;
                    try {
                        var now = soundContext.currentTime;
                        [0, 0.15].forEach(function (offset, i) {
                            var osc = soundContext.createOscillator();
                            var gain = soundContext.createGain();
                            osc.type = 'sine';
                            osc.frequency.value = i ? 1046.5 : 783.99;
                            gain.gain.setValueAtTime(0.0001, now + offset);
                            gain.gain.exponentialRampToValueAtTime(0.045, now + offset + 0.022);
                            gain.gain.exponentialRampToValueAtTime(0.0001, now + offset + 0.19);
                            osc.connect(gain);
                            gain.connect(soundContext.destination);
                            osc.start(now + offset);
                            osc.stop(now + offset + 0.20);
                        });
                    } catch (e) { /* Nếu phát âm thanh lỗi, preview vẫn phải hiển thị. */ }
                }
                document.addEventListener('pointerdown', unlockNotificationAudio, { capture: true });
                document.addEventListener('keydown', unlockNotificationAudio, { capture: true });
                function announceNext() {
                    if (!enabled || announceTimer || bellOpen()) return;
                    while (pending.length) {
                        var item = pending.shift();
                        var id = String(item.id);
                        delete pendingSet[id];
                        if (!unread(item) || announcedSet[id]) continue;
                        addId(id, announcedIds, announcedSet, announcedKey);
                        announcingId = id;
                        setBubble(item, true);
                        host.hidden = false;
                        host.classList.add('is-announcing');
                        jump();
                        playNotificationSound();
                        announceTimer = setTimeout(function () {
                            stopAnnouncement();
                            setBubble(null, false);
                            announceNext();
                        }, 5000);
                        break;
                    }
                }
                function ingest(items) {
                    if (!Array.isArray(items)) return;
                    var firstBatch = !initializedIds;
                    initializedIds = true;
                    // Lần đầu cài đặt chỉ ghi nhận các ID sẵn có (không phát âm báo cũ).
                    // Các lần sau chỉ announce ID mới chưa đọc được tạo gần đây.

                    items.forEach(function (item) {
                        if (!item || item.id === undefined || item.id === null || !unread(item)) return;
                        var id = String(item.id);
                        var unknown = !seenSet[id];
                        if (unknown) addId(id, seenIds, seenSet, seenKey);
                        if (firstBatch && !hasPriorBaseline) {
                            addId(id, announcedIds, announcedSet, announcedKey);
                            return;
                        }
                        var eligible = !announcedSet[id] && unknown &&
                            (!firstBatch || hasPriorBaseline) && recent(item, 300000);
                        if (eligible && !pendingSet[id] && announcingId !== id) {
                            pendingSet[id] = true;
                            pending.push(item);
                        }
                    });
                    hasPriorBaseline = true;
                }
                function update(count, items) {
                    currentCount = Math.max(0, Number(count) || 0);
                    noteCount();
                    host.hidden = !enabled;
                    if (!currentCount) {
                        // Bắt đầu với hộp thư trống cũng phải tạo baseline, để
                        // thông báo đầu tiên đến sau đó được coi là thông báo MỚI.
                        if (!initializedIds) {
                            initializedIds = true;
                            hasPriorBaseline = true;
                            writeLocal(seenKey, JSON.stringify(seenIds));
                        }
                        pending = [];
                        pendingSet = Object.create(null);
                        stopAnnouncement();
                        newestItem = null;
                        setBubble(null, false);
                        return;
                    }
                    if (Array.isArray(items)) {
                        var ordered = items.slice();
                        if (window.NotificationBell && window.NotificationBell.compareNewest)
                            ordered.sort(window.NotificationBell.compareNewest);
                        ingest(ordered);
                        newestItem = ordered.find(unread) || null;
                    }
                    if (!announceTimer) setBubble(null, false);
                    announceNext();
                }
                function setEnabled(value) {
                    enabled = !!value;
                    writeLocal(enabledKey, enabled ? '1' : '0');
                    host.hidden = !enabled;
                    if (!enabled) {
                        stopAnnouncement();
                        host.classList.remove('qna-blinking', 'qna-jumping');
                    }
                    else {
                        setBubble(null, false);
                        announceNext();
                    }
                    syncToggle();
                }
                function openBell() {
                    stopAnnouncement();
                    setBubble(null, false);
                    if (window.NotificationBell && typeof window.NotificationBell.openPanel === 'function')
                        window.NotificationBell.openPanel();
                }
                function openPreview() {
                    // Chỉ thông báo mới trong 30 giây mới có hành động đi thẳng link.
                    // Hover bình thường chỉ hiện số lượng, click mở danh sách chuông.
                    var selected = announceTimer ? activeItem : null;
                    stopAnnouncement();
                    setBubble(null, false);
                    if (selected && window.NotificationBell && typeof window.NotificationBell.openFromAssistant === 'function')
                        window.NotificationBell.openFromAssistant(selected);
                    else openBell();
                }
                host.querySelector('.qna-hide-hybrid').addEventListener('click', function (e) {
                    e.preventDefault(); e.stopPropagation(); setEnabled(false);
                });
                host.querySelector('.qna-view').addEventListener('click', function (e) {
                    e.preventDefault(); e.stopPropagation(); openPreview();
                });
                if (bubble) bubble.addEventListener('click', function (e) {
                    if (e.target && e.target.closest && e.target.closest('.qna-view')) return;
                    e.preventDefault(); e.stopPropagation(); openPreview();
                });
                trigger.addEventListener('click', function (e) {
                    e.preventDefault(); e.stopPropagation(); openBell();
                });
                // Header có thể bị thay DOM bởi WebForms UpdatePanel.
                document.addEventListener('click', function (e) {
                    var toggle = e.target && e.target.closest ? e.target.closest('#btnHybridAssistantToggle') : null;
                    if (toggle) { e.preventDefault(); e.stopPropagation(); setEnabled(!enabled); }
                });
                if (window.jQuery) window.jQuery(document).on('hidden.bs.dropdown', '#bellDropdownWrapper', announceNext);
                if (window.Sys && Sys.Application) Sys.Application.add_load(syncToggle);
                // Nếu request count hoàn tất trước khi Hybrid khởi tạo, đồng bộ lại một lần.
                host.hidden = !enabled;
                noteCount();
                setBubble(null, false);
                syncToggle();
                window.QldaNotifyAssistant = {
                    update: update, blink: blink, dismiss: stopAnnouncement, openBell: openBell,
                    setEnabled: setEnabled, isEnabled: function () { return enabled; }
                };
                if (window.NotificationBell && window.NotificationBell.getUnreadCount) {
                    currentCount = window.NotificationBell.getUnreadCount();
                    noteCount();
                    if (currentCount > 0 && window.NotificationBell.refreshHybridPreview)
                        window.NotificationBell.refreshHybridPreview();
                }
            })();
        </script>

        <%-- QLDA: delayed modal-open feedback. Chi xac nhan mo modal do nguoi dung chu dong, khong xu ly AJAX ngam. --%>
        <script type="text/javascript">
            (function () {
                'use strict';
                if (window.QLDAModalLoading) return;

                var overlay = document.getElementById('qldaModalOpenFeedback');
                if (!overlay) return;

                var state = { active: false, requestStarted: false, opener: null, modalWasOpen: [], showTimer: null, idleTimer: null, finishTimer: null, hideTimer: null, guardTimer: null, observer: null, checkQueued: false };

                function clearTimer(key) {
                    if (state[key]) window.clearTimeout(state[key]);
                    state[key] = null;
                }

                function visibleModal(el) {
                    if (!el || !el.getClientRects || !el.getClientRects().length) return false;
                    if (el.getAttribute('aria-hidden') === 'true') return false;
                    var style = window.getComputedStyle ? window.getComputedStyle(el) : null;
                    return !style || (style.display !== 'none' && style.visibility !== 'hidden');
                }

                function collectVisibleModals() {
                    var all = document.querySelectorAll('.modal');
                    var visible = [];
                    for (var i = 0; i < all.length; i++) if (visibleModal(all[i])) visible.push(all[i]);
                    return visible;
                }

                function anyNewModalVisible() {
                    var list = collectVisibleModals();
                    for (var i = 0; i < list.length; i++) {
                        if (state.modalWasOpen.indexOf(list[i]) === -1) return true;
                    }
                    return false;
                }

                function showOverlay() {
                    if (!state.active || !state.requestStarted || anyNewModalVisible()) return;
                    clearTimer('hideTimer');
                    overlay.hidden = false;
                    window.requestAnimationFrame(function () {
                        if (state.active && state.requestStarted) overlay.classList.add('is-visible');
                    });
                }

                function finish() {
                    state.active = false;
                    state.requestStarted = false;
                    state.opener = null;
                    clearTimer('showTimer');
                    clearTimer('idleTimer');
                    clearTimer('finishTimer');
                    clearTimer('guardTimer');
                    if (state.observer) { state.observer.disconnect(); state.observer = null; }
                    overlay.classList.remove('is-visible');
                    clearTimer('hideTimer');
                    state.hideTimer = window.setTimeout(function () {
                        if (!state.active) overlay.hidden = true;
                        state.hideTimer = null;
                    }, 200);
                }

                function checkOpened() {
                    state.checkQueued = false;
                    if (state.active && anyNewModalVisible()) finish();
                }

                function scheduleCheck() {
                    if (!state.active || state.checkQueued) return;
                    state.checkQueued = true;
                    window.requestAnimationFrame(checkOpened);
                }

                function observeModalOpening() {
                    if (!window.MutationObserver || state.observer) return;
                    state.observer = new MutationObserver(scheduleCheck);
                    state.observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'style', 'aria-hidden'] });
                }

                function arm(trigger) {
                    if (state.active) return;
                    clearTimer('hideTimer');
                    state.active = true;
                    state.requestStarted = false;
                    state.opener = trigger || null;
                    state.modalWasOpen = collectVisibleModals();
                    observeModalOpening();
                    state.showTimer = window.setTimeout(function () { state.showTimer = null; showOverlay(); }, 180);
                    // Neu khong co postback/AJAX (VD link bi validation chan), khong hien loader treo.
                    state.idleTimer = window.setTimeout(function () {
                        if (state.active && !state.requestStarted) finish();
                    }, 850);
                    // Guard can thiet khi server mat ket noi hoac request khong hoan tat.
                    state.guardTimer = window.setTimeout(finish, 20000);
                }

                function markRequest() {
                    if (!state.active) return;
                    state.requestStarted = true;
                    clearTimer('idleTimer');
                    if (anyNewModalVisible()) finish();
                    else if (!state.showTimer) showOverlay();
                }

                function normalize(text) {
                    return String(text || '').replace(/\s+/g, ' ').toLowerCase().trim();
                }

                function isModalOpenTrigger(el) {
                    if (!el || !el.getAttribute || !el.closest) return false;
                    if (el.closest('#bellDropdownWrapper, .qna-widget, #qldaModalOpenFeedback, [data-qlda-modal-ignore]')) return false;
                    if (el.hasAttribute('data-qlda-modal-open')) return el.getAttribute('data-qlda-modal-open') !== 'false';
                    if (el.getAttribute('data-bs-toggle') === 'modal' || el.getAttribute('data-toggle') === 'modal') return true;
                    // Nut da nam trong modal khac: chi nhan neu chu dich duoc danh dau ro rang.
                    if (el.closest('.modal')) return false;
                    var id = normalize(el.id || '').split(/[_$:]/).pop();
                    if (/^(?:lbt|btn|link|cmd)(?:add|new|create|open|show|edit|detail|view|assign|applytemplate|swapphase|starttask|viewtask|viewcost|viewmeet|viewissue|addchild|choose|chon|xem|sua|them|tao|duyet)/i.test(id)) return true;
                    if (/^(?:lbttaskname|lbtassign|lbtviewschedule|lbtstatusstart|lbtstatusfastcomplete|lbtstatusfastreview)$/i.test(id)) return true;
                    var label = normalize([el.title, el.getAttribute('aria-label'), el.getAttribute('data-original-title'), el.getAttribute('data-bs-original-title')].join(' '));
                    if (/\b(?:xem chi tiết|chi tiết công việc|thêm mới|tạo mới|chỉnh sửa|áp dụng mẫu|bắt đầu thực hiện|phân công nhân sự|xem lịch dự kiến|mở popup|mở cửa sổ|xem hồ sơ|xem cuộc họp)\b/i.test(label)) return true;
                    var text = normalize(el.textContent || el.value);
                    if (/^(?:thêm mới|tạo mới|áp dụng mẫu|xem chi tiết|chỉnh sửa|thêm công việc|thêm cuộc họp|mở chi tiết)(?:\s|$)/i.test(text)) return true;
                    return false;
                }

                // Theo doi click trong capture phase de bat kip truoc __doPostBack cua WebForms.
                document.addEventListener('click', function (event) {
                    if (!event.target || !event.target.closest || event.defaultPrevented) return;
                    var trigger = event.target.closest('a, button, input[type="submit"], input[type="button"]');
                    if (!trigger || trigger.disabled || trigger.getAttribute('aria-disabled') === 'true') return;
                    if (isModalOpenTrigger(trigger)) arm(trigger);
                }, true);

                // Native form submit: cho animation chay khi browser dang cho page load.
                document.addEventListener('submit', function (event) {
                    if (!state.active) return;
                    markRequest();
                }, true);

                // Modal cua Bootstrap: dong overlay ngay khi modal bat dau xuat hien.
                document.addEventListener('show.bs.modal', function () { if (state.active) finish(); }, true);
                document.addEventListener('shown.bs.modal', function () { if (state.active) finish(); }, true);
                if (window.jQuery) {
                    window.jQuery(document).on('show.bs.modal.qldaModalLoad shown.bs.modal.qldaModalLoad', '.modal', function () {
                        if (state.active) finish();
                    });
                }

                // WebForms UpdatePanel: chi theo doi request co nut opener khop, bo qua timer thong bao/realtime.
                function attachPageRequestManager() {
                    if (!window.Sys || !Sys.WebForms || !Sys.WebForms.PageRequestManager) return;
                    var prm = Sys.WebForms.PageRequestManager.getInstance();
                    if (!prm || prm.__qldaModalLoadingHooked) return;
                    prm.__qldaModalLoadingHooked = true;
                    prm.add_beginRequest(function (sender, args) {
                        var source = args && args.get_postBackElement ? args.get_postBackElement() : null;
                        if (!state.active && isModalOpenTrigger(source)) arm(source);
                        // AJAX nen cua chuong/dong ho khong duoc nham voi yeu cau dang mo popup.
                        if (state.active && (!state.opener || source === state.opener || (source && state.opener && state.opener.contains && state.opener.contains(source)))) markRequest();
                    });
                    prm.add_endRequest(function (sender, args) {
                        if (!state.active || !state.requestStarted) return;
                        if (args && args.get_error && args.get_error()) { finish(); return; }
                        scheduleCheck();
                        // EndRequest den sau server, startup script mo popup co the chay ngay sau do.
                        clearTimer('finishTimer');
                        state.finishTimer = window.setTimeout(finish, 280);
                    });
                }

                attachPageRequestManager();
                if (window.Sys && Sys.Application) Sys.Application.add_load(attachPageRequestManager);
                window.addEventListener('pagehide', finish);
                window.addEventListener('beforeunload', finish);

                // API cho popup dung fetch/AJAX rieng: goi begin() luc bat dau va end() khi hoan tat.
                // Co the danh dau nut bat ky bang data-qlda-modal-open="true" neu ten nut khong ro.
                window.QLDAModalLoading = {
                    begin: function () { arm(); markRequest(); },
                    end: finish,
                    expect: arm,
                    active: function () { return state.active; }
                };
            })();
        </script>
        <%-- QLDA: navigation feedback. Noi bo cung trang, AJAX, popup, downloads khong duoc kich hoat. --%>
        <script type="text/javascript">
            (function () {
                'use strict';
                if (window.QLDAPageNavigation) return;
                var overlay = document.getElementById('qldaPageNavigateFeedback');
                if (!overlay) return;
                var state = { active: false, unloading: false, pageLeaving: false, confirmationPending: false, reason: '', showTimer: null, guardTimer: null, cancelGuardTimer: null, focusGuardTimer: null, downloadIgnoreUntil: 0 };
                var SHOW_DELAY = 180;

                function clearTimer(name) { if (state[name]) window.clearTimeout(state[name]); state[name] = null; }
                function show() {
                    if (!state.active || !document.body) return;
                    overlay.hidden = false;
                    // Forced layout makes the CSS fade transition deterministic across browsers.
                    void overlay.offsetWidth;
                    overlay.classList.add('is-visible');
                }
                function stop() {
                    state.active = false;
                    state.unloading = false;
                    state.pageLeaving = false;
                    state.confirmationPending = false;
                    state.reason = '';
                    clearTimer('showTimer');
                    clearTimer('guardTimer');
                    clearTimer('cancelGuardTimer');
                    clearTimer('focusGuardTimer');
                    overlay.classList.remove('is-visible');
                    overlay.hidden = true;
                }
                function start(immediate, reason) {
                    if (state.active) { if (immediate) { clearTimer('showTimer'); show(); } return; }
                    state.active = true;
                    state.reason = reason || 'manual';
                    clearTimer('showTimer');
                    if (immediate) { show(); }
                    else { state.showTimer = window.setTimeout(function () { state.showTimer = null; show(); }, SHOW_DELAY); }
                    // Aborted navigation / prevented form submit must never leave an uncloseable overlay.
                    state.guardTimer = window.setTimeout(stop, 45000);
                }
                // PDF/export postbacks send a file response: the current page does not navigate.
                // Exclude just the marked download action; normal page transitions remain unchanged.
                function isDownloadPostback() { return state.downloadIgnoreUntil > Date.now(); }
                function markDownloadPostback() { state.downloadIgnoreUntil = Date.now() + 300000; stop(); }
                function clearDownloadPostback() { state.downloadIgnoreUntil = 0; }
                document.addEventListener('keydown', function (event) {
                    // A manual browser refresh must continue to display the regular navigation feedback.
                    if (event.key === 'F5' || ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'r')) clearDownloadPostback();
                }, true);
                function isActualPageLink(link) {
                    if (!link || link.closest('[data-qlda-page-nav-ignore], [data-qlda-modal-open], #qldaModalOpenFeedback')) return false;
                    if (link.hasAttribute('download') || (link.target && link.target.toLowerCase() !== '_self')) return false;
                    if (link.hasAttribute('data-bs-toggle') || link.hasAttribute('data-toggle') || link.hasAttribute('data-bs-dismiss') || link.hasAttribute('data-dismiss')) return false;
                    var href = (link.getAttribute('href') || '').trim();
                    if (!href || href.charAt(0) === '#' || /^(javascript:|mailto:|tel:|data:|blob:)/i.test(href)) return false;
                    var uri;
                    try { uri = new URL(href, window.location.href); } catch (error) { return false; }
                    if (!/^https?:$/.test(uri.protocol) || uri.origin !== window.location.origin) return false;
                    if (/\.(pdf|zip|rar|7z|xlsx?|docx?|pptx?|csv|jpe?g|png|gif|webp|mp4|mp3)$/i.test(uri.pathname)) return false;
                    var current = new URL(window.location.href);
                    return uri.pathname !== current.pathname || uri.search !== current.search;
                }
                document.addEventListener('click', function (event) {
                    if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                    var trigger = event.target && event.target.closest ? event.target.closest('a,button,input[type="submit"],input[type="button"]') : null;
                    if (trigger && trigger.closest('[data-qlda-download-postback="true"]')) { markDownloadPostback(); return; }
                    // Any subsequent click on a different control ends the download exception.
                    if (trigger) clearDownloadPostback();
                    var link = event.target && event.target.closest ? event.target.closest('a[href]') : null;
                    if (!isActualPageLink(link)) return;
                    start(false, 'link');
                    // Bubbling handlers can prevent navigation (tabs, confirmation, menus).
                    window.setTimeout(function () { if (event.defaultPrevented && !state.unloading) stop(); }, 0);
                }, true);

                document.addEventListener('submit', function (event) {
                    if (event.defaultPrevented || isDownloadPostback() || (event.submitter && event.submitter.closest('[data-qlda-download-postback="true"]'))) return;
                    var form = event.target;
                    if (!form || !form.tagName || form.tagName.toLowerCase() !== 'form') return;
                    start(false, 'submit');
                    window.setTimeout(function () { if (event.defaultPrevented && !state.unloading) stop(); }, 0);
                }, true);

                function attachAjaxManager() {
                    if (!window.Sys || !Sys.WebForms || !Sys.WebForms.PageRequestManager) return;
                    var prm = Sys.WebForms.PageRequestManager.getInstance();
                    if (!prm || prm.__qldaPageNavigationHooked) return;
                    prm.__qldaPageNavigationHooked = true;
                    // Partial postbacks are NOT page changes; also covers buttons that submit via WebForms.
                    prm.add_initializeRequest(function () { if (state.reason === 'submit' && !state.unloading) stop(); });
                    prm.add_beginRequest(function () { if (state.reason === 'submit' && !state.unloading) stop(); });
                }
                attachAjaxManager();
                if (window.Sys && Sys.Application) Sys.Application.add_load(attachAjaxManager);

                function hasNativeLeaveConfirmation(event) {
                    // Các trang có dữ liệu chưa lưu có thể yêu cầu trình duyệt hiển thị hộp xác nhận.
                    // returnValue mặc định là true; chuỗi (kể cả chuỗi rỗng) hoặc false biểu thị đã yêu cầu hỏi.
                    return !!(event && (event.defaultPrevented || typeof event.returnValue === 'string' || event.returnValue === false));
                }
                window.addEventListener('beforeunload', function (event) {
                    // Tải PDF/tệp không phải là chuyển trang.
                    if (isDownloadPostback()) { stop(); return; }
                    state.unloading = true;
                    state.pageLeaving = false;
                    state.confirmationPending = hasNativeLeaveConfirmation(event);
                    if (state.confirmationPending) {
                        // Người dùng chưa đồng ý rời trang: không che trang bằng animation.
                        clearTimer('showTimer');
                        overlay.classList.remove('is-visible');
                        overlay.hidden = true;
                    } else {
                        // Không có hộp hỏi: giữ nguyên animation cho điều hướng thực tế.
                        start(true);
                    }
                    // Khi chọn Hủy, trình duyệt KHÔNG phát pagehide/pageshow.
                    // Timer tiếp tục chạy sau khi hộp xác nhận đóng; thu hồi overlay nếu vẫn ở trang cũ.
                    clearTimer('cancelGuardTimer');
                    state.cancelGuardTimer = window.setTimeout(function () {
                        state.cancelGuardTimer = null;
                        if (!state.pageLeaving) stop();
                    }, state.confirmationPending ? 400 : 1000);
                });
                // Trên Chrome, focus thường trở lại cửa sổ sau khi bấm Hủy.
                // Giữ thêm nhịp ngắn để pagehide có thể đánh dấu lượt rời trang đã được chấp thuận.
                window.addEventListener('focus', function () {
                    if (!state.unloading || state.pageLeaving) return;
                    clearTimer('focusGuardTimer');
                    state.focusGuardTimer = window.setTimeout(function () {
                        state.focusGuardTimer = null;
                        if (!state.pageLeaving) stop();
                    }, 100);
                });
                window.addEventListener('pageshow', function () { clearDownloadPostback(); stop(); });
                window.addEventListener('pagehide', function () {
                    state.pageLeaving = true;
                    state.unloading = true;
                    clearTimer('cancelGuardTimer');
                    clearTimer('focusGuardTimer');
                    // Chỉ hiển thị animation sau khi người dùng đã đồng ý rời trang.
                    if (state.confirmationPending) { state.confirmationPending = false; start(true, 'confirmed'); }
                });
                window.QLDAPageNavigation = { start: start, stop: stop, isActive: function () { return state.active; } };
            })();
        </script>
    </form>
</body>
</html>

