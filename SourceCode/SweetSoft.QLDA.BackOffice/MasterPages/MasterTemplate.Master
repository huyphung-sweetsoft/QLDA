                <div id="qnaTime" class="qna-time"><i class="bx bx-calendar" aria-hidden="true"></i><span>Di chuột để xem nhanh thông báo mới nhất</span></div>
                <button type="button" class="qna-view"><i class="bx bx-right-arrow-alt" aria-hidden="true"></i> Mở thông báo</button>
            </div>
            <div class="qna-trigger-wrap">
                <button type="button" class="qna-hide-hybrid" title="Đóng trợ lý · bật lại trong bảng thông báo" aria-label="Đóng trợ lý Hybrid">&times;</button>
                <button type="button" class="qna-trigger" title="Xem thông báo" aria-label="Mở trung tâm thông báo">
                    <span class="qna-mascot-dog"><svg class="qna-dog-svg" viewBox="0 0 100 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><ellipse cx="52" cy="101" rx="29" ry="6" fill="#603a9b" opacity=".12"/><path d="M32 57q-11 4-11 20v11q0 14 15 14h33q15 0 15-14V77q0-17-14-21Z" fill="#a56a40"/><path d="M35 67q-6 10-5 22h45q2-15-6-22Z" fill="#fff0d4"/><g class="qna-dog-paw"><path d="M75 68Q91 52 92 65q4 9-3 15l-11 8Z" fill="#b87b4c" stroke="#92572f" stroke-width="2"/><ellipse cx="91" cy="66" rx="6" ry="7" fill="#b87b4c"/><circle cx="90" cy="64" r="2.2" fill="#e2a883"/></g><path d="M18 19 8 0Q6-5 26 5l11 13" fill="#a56a40" stroke="#92572f" stroke-width="2"/><path d="M68 18 84 1Q94-4 86 20l-5 11" fill="#a56a40" stroke="#92572f" stroke-width="2"/><path d="M20 22q8-18 30-18t32 22q9 21-2 38T50 78q-22 0-33-17T20 22" fill="#bd8353" stroke="#a26b41" stroke-width="2"/><path d="M23 44q-8 13 1 22Q35 83 52 83q21 0 31-15 8-13-1-24Q71 51 63 48q-5 12-13 11-10 0-15-11Z" fill="#fff0d4"/><circle cx="34" cy="40" r="4.6" fill="#3a2744"/><circle cx="67" cy="40" r="4.6" fill="#3a2744"/><circle cx="35.3" cy="38.5" r="1.3" fill="#fff"/><circle cx="68.3" cy="38.5" r="1.3" fill="#fff"/><ellipse cx="51" cy="55" rx="6" ry="4.2" fill="#3a2744"/><path d="M51 59q-1 7-7 7m7-7q1 7 8 7" stroke="#74506a" stroke-width="2.3" fill="none" stroke-linecap="round"/><ellipse cx="28" cy="52" rx="6" ry="3" fill="#e9a3a1" opacity=".7"/><ellipse cx="73" cy="52" rx="6" ry="3" fill="#e9a3a1" opacity=".7"/><path d="M34 85h12m10 0h12" stroke="#92572f" stroke-width="6" stroke-linecap="round"/></svg></span>
                    <span class="qna-mascot-bell"><svg class="qna-bell-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18 26c0-11 6-17 14-17s14 6 14 17v11c0 4 3 7 7 10H11c4-3 7-6 7-10Z" fill="#fff"/><path d="M28 10q4-7 8 0" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/><path d="M26 51q6 11 12 0" fill="#fff"/><path d="M9 21q1-9 7-14M55 21q-1-9-7-14" stroke="#d9c0ff" stroke-width="3" fill="none" stroke-linecap="round"/></svg></span>
                    <span class="qna-mascot-bot"> <svg class="qna-bot-svg" viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M45 19V9" stroke="#a57ad8" stroke-width="4" stroke-linecap="round"/><circle cx="45" cy="7" r="5" fill="#f2bf60"/><rect x="13" y="20" width="64" height="55" rx="21" fill="#eee0ff" stroke="#ad84dd" stroke-width="3"/><rect x="21" y="29" width="48" height="34" rx="14" fill="#6530aa"/><ellipse class="qna-bot-eye" cx="35" cy="46" rx="5" ry="6" fill="#fff"/><ellipse class="qna-bot-eye" cx="55" cy="46" rx="5" ry="6" fill="#fff"/><path d="M38 57q7 7 15 0" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/><circle cx="13" cy="48" r="7" fill="#c29fe9"/><circle cx="77" cy="48" r="7" fill="#c29fe9"/><path d="M29 75v6m32-6v6" stroke="#8650b7" stroke-width="6" stroke-linecap="round"/></svg></span>
                    <span id="qnaCount" class="qna-count" aria-hidden="true">0</span>
                </button>
            </div>
        </aside>


