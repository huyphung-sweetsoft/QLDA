        <div id="modal-notify" class="modal fade" tabindex="-1" data-bs-scroll="true">
            <asp:UpdatePanel runat="server" ID="pnlDialog" UpdateMode="Always">
                <ContentTemplate>
                    <div class="modal-dialog modal-dialog-centered text-center">
                        <div class="modal-content">
                            <div runat="server" id="modalHeader" class="modal-header">
                                <h5 class="modal-title" id="myModalLabel" runat="server"></h5>
                                <a href="javascript:;" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></a>
                            </div>
                            <div class="modal-body">
                                <asp:Literal ID="lbMessage" runat="server"></asp:Literal>
                            </div>
                            <div class="modal-footer p-1">
                                <SweetSoft:ExtraButton runat="server" ID="btnAccept" CssClass="btn-primary waves-effect waves-light" OnClientClick="return CMSMasterJs.HideModalMessage();" OnClick="btnAccept_Click"></SweetSoft:ExtraButton>
                                <SweetSoft:ExtraButton runat="server" ID="btnCancel" CssClass="btn-secondary waves-effect" ButtonIcon="Close"
                                    OnClick="btnCancel_Click" OnClientClick="CMSMasterJs.CloseMessageBox('#modal-notify');">Close</SweetSoft:ExtraButton>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </asp:UpdatePanel>
        </div>
