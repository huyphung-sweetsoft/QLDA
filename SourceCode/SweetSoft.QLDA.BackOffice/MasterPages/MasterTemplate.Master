<!DOCTYPE html>
<!--
This is a starter template page. Use this page to start your new project from
scratch. This page gets rid of all links and provides the needed markup only.
-->
<html lang="<%= SweetContext.Current.CurrentLanguageCode.Substring(0,2) %>">
<head id="Head1" runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>System Management - Control Panel - PM Quản Lý Dự Án</title>
    <link rel="shortcut icon" href="/favicon.ico">
    <asp:PlaceHolder runat="server">
        <script type="text/javascript">
            var timerStart = Date.now();
            var CMSMasterJs = {
                get HostPath() {
                    return window.location.origin;
                }
            };
            CMSMasterJs.InitNotify = () => {
                if (typeof toastr !== 'undefined') {
                    toastr.options = {
                        'closeButton': true,
                        'debug': false,
                        'newestOnTop': false,
                        'progressBar': false,
                        'positionClass': 'toast-bottom-right',
                        'preventDuplicates': false,
                        'showDuration': '1000',
                        'hideDuration': '1000',
                        'timeOut': '5000',
                        'extendedTimeOut': '1000',
                        'showEasing': 'swing',
                        'hideEasing': 'linear',
                        'showMethod': 'fadeIn',
                        'hideMethod': 'fadeOut',
                    }
                }
            }
            CMSMasterJs.InitNotify();
            var $title = '<%= GetResourceText(BackEndResourceKeys.NOTIFICATION)%>';
            (() => {
                let notifyTimeout;

                CMSMasterJs.ShowNotify = ($message, $type) => {
                    if (!$message || typeof (toastr) === 'undefined')
                        return;

                    if (notifyTimeout) clearTimeout(notifyTimeout);

                    notifyTimeout = setTimeout(() => {
                        toastr.clear();
                        switch ($type) {
                            case 'danger':
                            case 'error':
                                toastr.error($message);
                                break;
                            case 'warning':
                                toastr.warning($message);
                                break;
                            case 'success':
                                toastr.success($message);
                                break;
                            default:
                                toastr.info($message);
                                break;
                        }
                    }, 300);
                };
            })();
        </script>
    </asp:PlaceHolder>

