            max-width: 150px;
        }

        .help-block {
            font-style: italic;
            color: #4a1387;
            font-size: 12px;
        }

        .notification {
            width: 400px;
            max-width: 100%;
            box-sizing: border-box;
            padding: 10px;
        }

            .notification .notification-body {
                overflow-y: auto;
                max-height: 60vh;
                height: 100%;
            }

            .notification .notification-close {
                border: 1px solid lightgray;
                padding: 2px 10px;
                border-radius: 6px;
            }

        .dropdown-notification.dropdown-toggle::after {
            content: unset;
        }

        .notification .notification-item:hover {
            background: #f9fafc;
        }

        .notification-item .notification-icon {
            width: 36px;
            height: 36px;
        }

        .fs-14 {
            font-size: 14px;
        }

