            $(document).on('click', '.nav-item a[data-bs-toggle="tab"]', function () {
                var $dataBtn = $(this).attr('data-selector');
                if ($dataBtn != undefined) {
                    $('[data-selector-group-btn]').hide();
                    $(`[data-selector-group-btn="${$dataBtn}"]`).show();
