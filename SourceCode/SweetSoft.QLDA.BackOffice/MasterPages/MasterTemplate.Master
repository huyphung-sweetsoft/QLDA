    <%--Render from server--%>
    <style>
        .html2canvas-container {
            width: 9999px !important;
            height: 9999px !important;
        }

        .logo-lg img {
            max-width: 150px;
        }

        .help-block {
            font-style: italic;
            color: #4a1387;
            font-size: 12px;
        }

        /* Notification center - only scoped to the bell dropdown. */
        #bellDropdownWrapper .dropdown-notification.dropdown-toggle::after { display:none; }
        #bellDropdownWrapper .dropdown-notification { display:inline-flex; align-items:center; justify-content:center; width:32px; height:36px; text-decoration:none; transition:transform .18s ease; }
        #bellDropdownWrapper .dropdown-notification:hover { transform:translateY(-2px); }
        #bellDropdownWrapper .dropdown-notification:focus-visible { outline:2px solid #c9a6ff; outline-offset:3px; border-radius:10px; }
        #bellDropdownWrapper #badgeUnread { padding:4px 6px; min-width:19px; line-height:1.1; box-shadow:0 0 0 2px #4a1387; }
        /* Popup canh theo mép phải vùng Master; giữ phần mũi nối nằm ngoài khung bo góc. */
        #bellDropdownWrapper .notification { position:fixed!important; inset:auto var(--qlda-noti-edge-right,0px) auto auto!important; top:var(--qlda-noti-top,66px)!important; left:auto!important; bottom:auto!important; transform:none!important; width:365px; max-width:calc(100vw - 18px); box-sizing:border-box; padding:0; overflow:visible; border:1px solid #dfc8f2; border-radius:20px; background:#fff; box-shadow:0 18px 55px rgba(40,27,76,.20)!important; color:#252438; z-index:1070; }
        #bellDropdownWrapper .notification::before { content:''; position:absolute; top:-10px; right:var(--qlda-noti-pointer-right,40px); width:20px; height:20px; background:#fbf7ff; border-top:1px solid #dfc8f2; border-left:1px solid #dfc8f2; border-top-left-radius:5px; transform:rotate(45deg); box-shadow:-4px -4px 10px rgba(40,27,76,.06); z-index:0; transition:opacity .18s ease,transform .24s ease; }
        /* Khung popup có kích thước ổn định. Không cuộn chiều cao để tránh giật layout. */
        #bellDropdownWrapper .qlda-noti-surface { position:relative; z-index:1; overflow:hidden; border-radius:19px; background:#fff; }
        #bellDropdownWrapper .qlda-noti-content { min-height:0; }
        /* Màu tím oải hương, hoa cà và hồng rất nhẹ ở bốn góc. */
        #bellDropdownWrapper .qlda-noti-surface::after { content:''; position:absolute; inset:0; z-index:2; border-radius:inherit; pointer-events:none; background:radial-gradient(circle at 0% 0%,rgba(139,79,204,.17),transparent 84px),radial-gradient(circle at 100% 0%,rgba(195,137,236,.14),transparent 85px),radial-gradient(circle at 0% 100%,rgba(155,116,217,.12),transparent 85px),radial-gradient(circle at 100% 100%,rgba(224,143,201,.13),transparent 86px); }
        /* Thác nước: khung mở trước, từng hàng xuất hiện, nội dung chữ đến sau. */
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-surface { animation:qlda-noti-frame-in .20s cubic-bezier(.2,.7,.25,1) both; }
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-header { animation:qlda-noti-head-in .21s ease-out .035s both; }
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-footer { animation:qlda-noti-head-in .20s ease-out .20s both; }
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-waterfall-step { animation:qlda-noti-waterfall-in .24s cubic-bezier(.2,.78,.25,1) both; animation-delay:var(--qlda-noti-in-delay,100ms); }
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-waterfall-step .qlda-noti-copy,
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-waterfall-step .qlda-noti-detail,
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-waterfall-step.qlda-noti-group-title > span,
        #bellDropdownWrapper .notification.show.qlda-noti-opening .qlda-noti-waterfall-step.qlda-noti-empty > * { animation:qlda-noti-text-in .21s ease-out both; animation-delay:var(--qlda-noti-text-delay,220ms); }
        /* Đóng ngược: chữ mờ trước, các hàng lùi lên từ dưới lên trên, khung cuối cùng mới rời đi. */
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-surface { pointer-events:none; animation:qlda-noti-frame-out .16s ease-in .47s both; }
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-header { animation:qlda-noti-head-out .17s ease-in .29s both; }
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-footer { animation:qlda-noti-head-out .15s ease-in .22s both; }
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-waterfall-step { animation:qlda-noti-waterfall-out .19s ease-in both; animation-delay:var(--qlda-noti-out-delay,145ms); }
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-waterfall-step .qlda-noti-copy,
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-waterfall-step .qlda-noti-detail,
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-waterfall-step.qlda-noti-group-title > span,
        #bellDropdownWrapper .notification.show.qlda-noti-closing .qlda-noti-waterfall-step.qlda-noti-empty > * { animation:qlda-noti-text-out .13s ease-in both; }
        #bellDropdownWrapper .notification.qlda-noti-closing::before { opacity:0; transform:translateY(-7px) rotate(45deg); }
        @keyframes qlda-noti-frame-in { from { opacity:0; transform:translateY(-9px) scale(.987); } to { opacity:1; transform:translateY(0) scale(1); } }
        @keyframes qlda-noti-frame-out { from { opacity:1; transform:translateY(0) scale(1); } to { opacity:0; transform:translateY(-7px) scale(.989); } }
        @keyframes qlda-noti-head-in { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }
        @keyframes qlda-noti-head-out { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(-5px); } }
        @keyframes qlda-noti-waterfall-in { from { opacity:0; transform:translateY(-11px); } to { opacity:1; transform:translateY(0); } }
        @keyframes qlda-noti-waterfall-out { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(-11px); } }
        @keyframes qlda-noti-text-in { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:translateY(0); } }
        @keyframes qlda-noti-text-out { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(-3px); } }
        #bellDropdownWrapper .qlda-noti-header { padding:20px 20px 15px; background:linear-gradient(155deg,#faf7ff 0%,#fff 69%); border-bottom:1px solid #eeeaf6; }
        #bellDropdownWrapper .qlda-noti-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:7px; }
        #bellDropdownWrapper .qlda-noti-heading-copy { min-width:0; flex:1; }
        #bellDropdownWrapper .qlda-noti-actions { display:flex; align-items:center; gap:5px; flex-shrink:0; }
        #bellDropdownWrapper .qlda-noti-switch { appearance:none; display:inline-flex; align-items:center; justify-content:center; gap:4px; min-height:35px; border:1px solid #e9dff5; border-radius:9px; background:#f8f3fe; color:#642a9b; font-weight:750; font-size:11.3px; padding:6px 9px; white-space:nowrap; cursor:pointer; transition:background .16s,border-color .16s,color .16s,box-shadow .16s; }
        #bellDropdownWrapper .qlda-noti-switch.mode-unread { border-color:#efcf8d; background:#fff7e7; color:#9a6500; box-shadow:inset 0 0 0 1px rgba(239,207,141,.22); }
        #bellDropdownWrapper .qlda-noti-switch.mode-unread:hover,#bellDropdownWrapper .qlda-noti-switch.mode-unread:focus-visible { background:#fff0cf; border-color:#e1bb62; color:#855100; }
        #bellDropdownWrapper .qlda-noti-switch.mode-all { border-color:#cdd7ff; background:#eef3ff; color:#3150b5; box-shadow:inset 0 0 0 1px rgba(107,140,232,.14); }
        #bellDropdownWrapper .qlda-noti-switch.mode-all:hover,#bellDropdownWrapper .qlda-noti-switch.mode-all:focus-visible { background:#dfe9ff; border-color:#aabcf6; color:#24429d; }
        #bellDropdownWrapper .qlda-noti-switch:focus-visible { outline:2px solid #8545c1; outline-offset:2px; }
        #bellDropdownWrapper .qlda-noti-title { display:inline-block; font-size:21px; line-height:1.3; margin:0; font-weight:850; letter-spacing:-.45px; color:#6324a0; background:linear-gradient(105deg,#4a1387 0%,#7940b5 75%,#9952c5 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
        #bellDropdownWrapper .qlda-noti-subtitle { margin:5px 0 0; font-size:12.5px; color:#777286; }
        #bellDropdownWrapper .qlda-noti-mark { appearance:none; display:inline-flex; align-items:center; justify-content:center; border:1px solid #eadcf8; background:#fff; border-radius:9px; min-height:35px; padding:6px 7px; font-weight:750; color:#6824a0; font-size:11.3px; white-space:nowrap; transition:background .16s,border-color .16s; }
        #bellDropdownWrapper .qlda-noti-mark:hover { background:#f3eaff; border-color:#d4b7f1; }
        #bellDropdownWrapper .qlda-noti-mark:focus-visible,#bellDropdownWrapper .qlda-noti-tab:focus-visible,#bellDropdownWrapper .qlda-noti-more:focus-visible,#bellDropdownWrapper .qlda-noti-detail:focus-visible { outline:2px solid #8545c1; outline-offset:2px; }
        #bellDropdownWrapper .qlda-noti-mark:disabled { opacity:.55; cursor:wait; }
        #bellDropdownWrapper .qlda-noti-tools { display:flex; align-items:stretch; flex-direction:column; gap:8px; margin-top:13px; }
        #bellDropdownWrapper .qlda-noti-filter-row { display:grid; grid-template-columns:39px minmax(0,1fr) minmax(0,1fr); align-items:center; gap:7px; width:100%; }
        /* View chooser: compact quick view or centered spacious reading view. */
        #bellDropdownWrapper .qlda-noti-view-picker { position:relative; min-width:0; }
        #bellDropdownWrapper .qlda-noti-view-button { width:39px; height:39px; display:flex; align-items:center; justify-content:center; padding:0; border:1px solid #dfd1ed; border-radius:10px; background:#f7f1ff; color:#69339f; cursor:pointer; transition:background .16s,border-color .16s,box-shadow .16s; }
        #bellDropdownWrapper .qlda-noti-view-button i { font-size:19px; }
        #bellDropdownWrapper .qlda-noti-view-button:hover,#bellDropdownWrapper .qlda-noti-view-button[aria-expanded="true"] { background:#ece0fd; border-color:#bf9ce6; box-shadow:0 2px 9px rgba(95,43,155,.08); }
        #bellDropdownWrapper .qlda-noti-view-button:focus-visible,#bellDropdownWrapper .qlda-noti-view-option:focus-visible { outline:2px solid #8f53c3; outline-offset:2px; }
        #bellDropdownWrapper .qlda-noti-view-menu { position:absolute; top:calc(100% + 8px); left:0; z-index:12; width:238px; max-width:calc(100vw - 54px); padding:8px; border:1px solid #dfd1f1; border-radius:13px; background:#fff; box-shadow:0 15px 35px rgba(65,26,108,.20); }
        #bellDropdownWrapper .qlda-noti-view-menu[hidden] { display:none!important; }
        #bellDropdownWrapper .qlda-noti-view-menu-title { padding:5px 8px 8px; color:#8b78a2; font-size:10.5px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; }
        #bellDropdownWrapper .qlda-noti-view-option { width:100%; display:flex; align-items:center; gap:10px; padding:10px 9px; text-align:left; border:0; border-radius:9px; background:transparent; color:#3a2b4f; cursor:pointer; transition:background .16s; }
        #bellDropdownWrapper .qlda-noti-view-option:hover,#bellDropdownWrapper .qlda-noti-view-option.is-selected { background:#f4edfe; }
        #bellDropdownWrapper .qlda-noti-view-option > i:first-child { display:flex; align-items:center; justify-content:center; width:29px; height:29px; border-radius:8px; background:#eee5fa; color:#743cad; flex-shrink:0; font-size:17px; }
        #bellDropdownWrapper .qlda-noti-view-option span { display:flex; flex-direction:column; min-width:0; flex:1; }
        #bellDropdownWrapper .qlda-noti-view-option strong { font-size:12.5px; line-height:1.4; }
        #bellDropdownWrapper .qlda-noti-view-option small { color:#9387a2; font-size:10.5px; line-height:1.4; }
        #bellDropdownWrapper .qlda-noti-view-option .qlda-noti-view-check { font-size:17px; color:#6e2dab; opacity:0; }
        #bellDropdownWrapper .qlda-noti-view-option.is-selected .qlda-noti-view-check { opacity:1; }
        #bellDropdownWrapper .qlda-noti-header { position:relative; z-index:4; }
        #bellDropdownWrapper .qlda-noti-type-wrap { position:relative; min-width:0; width:100%; }
        #bellDropdownWrapper .qlda-noti-time-wrap .qlda-noti-filter-icon { font-size:16px; }
        #bellDropdownWrapper .qlda-noti-filter-icon { position:absolute; left:11px; top:50%; transform:translateY(-50%); font-size:15px; color:#7a638d; pointer-events:none; }
        #bellDropdownWrapper .qlda-noti-type { appearance:none; -webkit-appearance:none; display:block; width:100%; height:39px; padding:0 28px 0 33px; border:1px solid #e5deef; border-radius:10px; background:#fff; font-size:12px; font-weight:700; color:#484056; cursor:pointer; }
        #bellDropdownWrapper .qlda-noti-type:focus { outline:2px solid #d9b8f5; border-color:#b98ae1; }
        #bellDropdownWrapper .qlda-noti-chevron { position:absolute; right:9px; top:50%; transform:translateY(-50%); font-size:17px; pointer-events:none; color:#7b688b; }
        #bellDropdownWrapper .notification-body { max-height:min(62vh,550px); overflow-y:auto; overscroll-behavior:contain; background:#fff; scrollbar-width:thin; scrollbar-color:#dad1e7 transparent; }
        #bellDropdownWrapper .notification-body::-webkit-scrollbar { width:6px; }
        #bellDropdownWrapper .notification-body::-webkit-scrollbar-thumb { background:#dcd4e7; border-radius:12px; }
        #bellDropdownWrapper .qlda-noti-group-title { position:sticky; top:0; z-index:1; display:flex; justify-content:space-between; align-items:center; padding:10px 19px 8px; background:#f8f7fb; color:#625b75; border-top:1px solid #f3f0f7; font-size:11.5px; font-weight:800; letter-spacing:.15px; }
        #bellDropdownWrapper .qlda-noti-group-title span:last-child { color:#a29bad; font-weight:700; font-size:11px; }
        #bellDropdownWrapper .notification-item { position:relative; display:flex; align-items:center; gap:4px; padding:0 11px 0 0; border-bottom:1px solid #f3f0f7; background:#fff; transition:background .16s ease,box-shadow .16s ease; }
        #bellDropdownWrapper .notification-item.is-unread { background:#fbf9ff; }
        #bellDropdownWrapper .notification-item:hover,#bellDropdownWrapper .notification-item:focus-within { background:#f5f0fd; box-shadow:inset 3px 0 0 #8243bb; }
        #bellDropdownWrapper .qlda-noti-link { display:flex; align-items:flex-start; gap:12px; min-width:0; flex:1; padding:14px 0 14px 18px; text-decoration:none!important; color:inherit!important; }
        #bellDropdownWrapper .notification-icon { width:42px; height:42px; display:flex; align-items:center; justify-content:center; border-radius:13px; flex-shrink:0; font-size:21px; }
        #bellDropdownWrapper .qlda-noti-icon-task { background:#eee6fc; color:#6426ae; }
        #bellDropdownWrapper .qlda-noti-icon-project { background:#e5f7ed; color:#23905b; }
        #bellDropdownWrapper .qlda-noti-icon-meeting { background:#fff4d9; color:#bb7c0e; }
        #bellDropdownWrapper .qlda-noti-icon-issue { background:#ffe7e8; color:#d04b5b; }
        #bellDropdownWrapper .qlda-noti-icon-document { background:#e2f3fc; color:#247fa9; }
        #bellDropdownWrapper .qlda-noti-icon-system { background:#edf0f5; color:#677589; }
        #bellDropdownWrapper .qlda-noti-copy { flex:1; min-width:0; }
        #bellDropdownWrapper .qlda-noti-topline { display:flex; align-items:center; gap:7px; margin-bottom:5px; }
        #bellDropdownWrapper .qlda-noti-category { display:inline-flex; align-items:center; min-width:0; color:#7853a0; font-weight:800; font-size:10.5px; line-height:1.3; }
        #bellDropdownWrapper .qlda-noti-unread-dot { display:inline-block; width:7px; height:7px; background:#7733b1; border-radius:50%; flex-shrink:0; box-shadow:0 0 0 3px #ede2fa; }
        #bellDropdownWrapper .qlda-noti-item-title { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; font-size:13.7px; font-weight:600; line-height:1.45; color:#40384d; }
        #bellDropdownWrapper .qlda-noti-snippet { display:none; }
        #bellDropdownWrapper .notification-item.is-unread .qlda-noti-item-title { color:#262036; font-weight:800; }
        #bellDropdownWrapper .qlda-noti-time { display:flex; align-items:center; gap:5px; margin-top:6px; color:#918b9a; font-size:11.5px; }
        #bellDropdownWrapper .qlda-noti-time i { font-size:13px; }
        #bellDropdownWrapper .qlda-noti-detail { display:flex; flex:0 0 30px; width:30px; height:30px; justify-content:center; align-items:center; border:0; border-radius:9px; background:transparent; color:#a69db2; font-size:19px; cursor:pointer; transition:color .16s,background .16s; }
        #bellDropdownWrapper .qlda-noti-detail:hover,#bellDropdownWrapper .notification-item:hover .qlda-noti-detail { color:#69339c; background:#ede2f9; }
        #bellDropdownWrapper .qlda-noti-empty { min-height:220px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px; padding:30px 22px; text-align:center; }
        #bellDropdownWrapper .qlda-noti-empty-icon { width:54px; height:54px; display:flex; align-items:center; justify-content:center; background:#f2eafb; border-radius:18px; color:#8244bc; font-size:27px; }
        #bellDropdownWrapper .qlda-noti-empty strong { color:#393047; font-size:14px; }
        #bellDropdownWrapper .qlda-noti-empty span { max-width:290px; color:#90899a; font-size:12.5px; line-height:1.55; }
        #bellDropdownWrapper .qlda-noti-skeleton { display:flex; gap:13px; padding:18px; border-bottom:1px solid #f3f0f7; }
        #bellDropdownWrapper .qlda-noti-skeleton-icon,#bellDropdownWrapper .qlda-noti-skeleton-line { background:linear-gradient(90deg,#f3f0f8 25%,#e8e2f0 50%,#f3f0f8 75%); background-size:200% 100%; animation:qlda-noti-shimmer 1.4s linear infinite; }
        #bellDropdownWrapper .qlda-noti-skeleton-icon { width:40px; height:40px; border-radius:12px; flex-shrink:0; }
        #bellDropdownWrapper .qlda-noti-skeleton-content { flex:1; padding-top:3px; }
        #bellDropdownWrapper .qlda-noti-skeleton-line { display:block; height:9px; width:80%; margin-bottom:10px; border-radius:6px; }
        #bellDropdownWrapper .qlda-noti-skeleton-line:last-child { width:47%; margin:0; }
        #bellDropdownWrapper .qlda-noti-footer { display:flex; flex-direction:column; align-items:stretch; padding:10px 18px 12px; border-top:1px solid #f0eaf6; background:#fff; }
        #bellDropdownWrapper .qlda-noti-more { display:flex; justify-content:center; align-items:center; gap:6px; min-height:36px; width:100%; border:1px solid #e9dcf6; background:#f9f5fe; color:#6f2ca6; border-radius:9px; font-weight:800; font-size:12.5px; transition:background .16s; }
        #bellDropdownWrapper .qlda-noti-more:hover { background:#eee3fb; }
        #bellDropdownWrapper .qlda-noti-more:disabled { opacity:.65; cursor:wait; }
        #bellDropdownWrapper .qlda-noti-filter-note { margin-top:7px; font-size:11px; text-align:center; color:#9a92a4; }
        /* Centered reading mode; stays inside the existing Bootstrap dropdown. */
        .qlda-noti-backdrop { position:fixed; inset:0; z-index:1068; background:rgba(27,13,49,.38); opacity:0; pointer-events:none; transition:opacity .22s ease; }
        .qlda-noti-backdrop.is-visible { opacity:1; pointer-events:auto; }
        #bellDropdownWrapper .notification.qlda-noti-expanded { top:50%!important; left:50%!important; right:auto!important; bottom:auto!important; transform:translate(-50%,-50%)!important; width:min(890px,calc(100vw - 48px))!important; max-width:none!important; height:min(760px,calc(100vh - 52px))!important; max-height:calc(100vh - 52px)!important; border-radius:22px; box-shadow:0 25px 85px rgba(24,10,53,.32)!important; }
        #bellDropdownWrapper .notification.qlda-noti-expanded::before { display:none; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-surface { height:100%; border-radius:21px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-content { display:flex; flex-direction:column; height:100%; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-header { flex:0 0 auto; padding:22px 28px 19px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-title { font-size:25px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-subtitle { font-size:13.5px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-filter-row { grid-template-columns:43px minmax(0,220px) minmax(0,220px); gap:10px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-view-button { width:43px; }
        #bellDropdownWrapper .qlda-noti-expanded .notification-body { flex:1 1 auto; min-height:0; max-height:none!important; overflow-y:auto; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-group-title { padding:12px 25px 11px; font-size:12.5px; }
        #bellDropdownWrapper .qlda-noti-expanded .notification-item { padding-right:23px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-link { padding:16px 0 16px 25px; gap:16px; }
        #bellDropdownWrapper .qlda-noti-expanded .notification-icon { width:49px; height:49px; font-size:24px; border-radius:14px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-category { font-size:11.5px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-item-title { font-size:15.5px; line-height:1.48; -webkit-line-clamp:3; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-time { font-size:12.5px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-snippet { display:-webkit-box; margin-top:7px; font-size:12.5px; line-height:1.5; color:#82778c; overflow:hidden; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow-wrap:anywhere; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-footer { flex:0 0 auto; padding:12px 27px 15px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-more { min-height:40px; font-size:13px; }
        #bellDropdownWrapper .qlda-noti-close { display:none; width:36px; height:35px; padding:0; align-items:center; justify-content:center; border:1px solid #e7d9f5; border-radius:10px; background:#fff; color:#8a699f; cursor:pointer; transition:background-color .16s,color .16s,border-color .16s; }
        #bellDropdownWrapper .qlda-noti-close i { font-size:21px; }
        #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-close { display:inline-flex; }
        #bellDropdownWrapper .qlda-noti-close:hover { background:#f6edff; color:#6326a5; border-color:#cdb0ed; }
        #bellDropdownWrapper .qlda-noti-close:focus-visible { outline:2px solid #8545c1; outline-offset:2px; }
        /* Detail card is mounted on <body> so the scroll container cannot clip it. */
        .qlda-noti-preview { position:fixed; z-index:2000; width:340px; max-width:calc(100vw - 22px); padding:17px 18px 16px; border:1px solid #e8dff2; border-radius:15px; background:#fff; color:#332940; box-shadow:0 17px 45px rgba(35,19,67,.23); pointer-events:none; animation:qlda-noti-enter .16s ease-out; }
        .qlda-noti-preview-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:10px; }
        .qlda-noti-preview-type { color:#7134a7; font-size:11px; font-weight:850; }
        .qlda-noti-preview-status { color:#785e98; background:#f2eafb; padding:4px 8px; border-radius:50px; font-weight:750; font-size:10px; }
        .qlda-noti-preview-status.is-read { color:#657284; background:#eef1f4; }
        .qlda-noti-preview-title { color:#292137; font-weight:850; font-size:14px; line-height:1.48; overflow-wrap:anywhere; margin-bottom:9px; }
        .qlda-noti-preview-content { font-size:12.7px; color:#5f566b; line-height:1.6; white-space:pre-line; overflow-wrap:anywhere; max-height:150px; overflow:hidden; }
        .qlda-noti-preview-muted { color:#9b92a7; font-style:italic; }
        .qlda-noti-preview-foot { display:flex; flex-wrap:wrap; gap:9px 15px; padding-top:12px; margin-top:12px; border-top:1px solid #f0ebf5; font-size:11.5px; color:#837b8e; }
        .qlda-noti-preview-foot span { display:flex; align-items:center; gap:5px; }
        @keyframes qlda-noti-shimmer { to { background-position-x:-200%; } }
        @keyframes qlda-noti-enter { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:translateY(0); } }
        @media(max-width:575px) {
            #bellDropdownWrapper .notification { position:fixed!important; top:var(--qlda-noti-top,72px)!important; left:8px!important; right:8px!important; width:auto!important; max-width:none!important; }
            #bellDropdownWrapper .notification::before { right:var(--qlda-noti-pointer-right,34px); }
            #bellDropdownWrapper .qlda-noti-header { padding:15px 13px 12px; }
            #bellDropdownWrapper .qlda-noti-tools { gap:7px; }
            #bellDropdownWrapper .qlda-noti-type-wrap { min-width:0; }
            #bellDropdownWrapper .qlda-noti-filter-row { gap:7px; }
            #bellDropdownWrapper .notification-body { max-height:min(57vh,490px); }
            #bellDropdownWrapper .qlda-noti-link { gap:10px; padding-left:13px; }
            #bellDropdownWrapper .qlda-noti-view-menu { left:0; width:min(238px,calc(100vw - 40px)); }
            #bellDropdownWrapper .notification.qlda-noti-expanded { width:calc(100vw - 16px)!important; height:calc(100vh - 24px)!important; max-height:calc(100vh - 24px)!important; top:50%!important; left:50%!important; right:auto!important; transform:translate(-50%,-50%)!important; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-header { padding:17px 14px 13px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-title { font-size:22px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-filter-row { grid-template-columns:39px minmax(0,1fr) minmax(0,1fr); gap:7px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-view-button { width:39px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-link { padding:14px 0 14px 13px; gap:10px; }
            #bellDropdownWrapper .qlda-noti-expanded .notification-item { padding-right:8px; }
            #bellDropdownWrapper .qlda-noti-expanded .notification-icon { width:42px; height:42px; font-size:21px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-item-title { font-size:14px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-group-title { padding:11px 15px 9px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-footer { padding:10px 13px 12px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-heading { flex-wrap:wrap; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-heading-copy { flex-basis:100%; padding-right:36px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-actions { width:100%; justify-content:flex-end; padding-right:39px; }
            #bellDropdownWrapper .qlda-noti-expanded .qlda-noti-close { position:absolute; top:16px; right:13px; }
        }
        @media(prefers-reduced-motion:reduce) {
            #bellDropdownWrapper .qlda-noti-skeleton-icon,#bellDropdownWrapper .qlda-noti-skeleton-line { animation:none; }
            #bellDropdownWrapper .notification .qlda-noti-surface,
            #bellDropdownWrapper .notification .qlda-noti-header,
            #bellDropdownWrapper .notification .qlda-noti-footer,
            #bellDropdownWrapper .notification .qlda-noti-waterfall-step,
            #bellDropdownWrapper .notification .qlda-noti-waterfall-step * { animation:none!important; transition:none!important; }
            #bellDropdownWrapper .notification::before { transition:none; }
            .qlda-noti-preview,.qlda-noti-backdrop { animation:none; transition:none!important; }
        }

        .fs-14 {
            font-size: 14px;
        }

        .ext-error .select2-selection--single {
            border-color: #fd625e !important;
        }

        .open-autocomplete {
            /*overflow: visible !important;*/
            /*position: relative;*/
        }

        .btn-outline-primary {
            gap: 8px;
        }

/*Menu*/
 body[data-style=ios].showMenu .wrapHeader .wrapMenuHeader .listMenuHeader .linkMenuHeader, body[data-style=google].showMenu .wrapHeader .wrapMenuHeader .listMenuHeader .linkMenuHeader{
    color: #4a1387;
}
 body[data-style=ios].showMenu .wrapHeader .wrapMenuHeader .listMenuHeader .itemMenuHeader .btnDropdownMenuSub, body[data-style=google].showMenu .wrapHeader .wrapMenuHeader .listMenuHeader .itemMenuHeader .btnDropdownMenuSub
{
    color: #4a1387;
}
 body[data-style=ios].showMenu .wrapHeader .listMenuHeader.Rootmenu, body[data-style=google].showMenu .wrapHeader .listMenuHeader.Rootmenu{
     justify-content: center;
    align-items: unset;
 } body[data-style=ios].showMenu .wrapHeader .listMenuHeader.Rootmenu .border-right, body[data-style=google].showMenu .wrapHeader .listMenuHeader.Rootmenu .border-right{
     height: 0;
 }


        /* Shared GridView sizing: keep tall scrollable grids above the fixed footer and reserve space for their paging controls. */
        body.qlda-grid-fit-page .qlda-grid-fit-viewport { min-height: 0 !important; box-sizing: border-box !important; overflow: auto !important; }
    </style>
    <asp:ContentPlaceHolder ID="cpHeadVendor" runat="server"></asp:ContentPlaceHolder>
    <asp:ContentPlaceHolder ID="cpHead" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="loadingPage" data-layout="horizontal" data-font="Nunito" data-color="color-1" data-style="ios">
    <form runat="server" id="aspnet" onsubmit="return CMSMasterJs.CheckPageIsValid();">
        <asp:ScriptManager
            ID="scriptMain"
            runat="server"
            EnableCdn="false"
            ScriptMode="Release"
            AjaxFrameworkMode="Enabled"
            LoadScriptsBeforeUI="true">
            <CompositeScript ScriptMode="Release">
                <Scripts>
                    <asp:ScriptReference Path="~/Styles/plugins/jquery/jquery.min.js" />
                    <asp:ScriptReference Path="~/Styles/js/toastr.js" />
                    <asp:ScriptReference Path="~/Styles/js/clipboard.min.js" />
                    <asp:ScriptReference Path="~/Styles/plugins/bootstrap/js/bootstrap.bundle.min.js" />
                    <asp:ScriptReference Path="~/Styles/plugins/simplebar/simplebar.min.js" />
                    <asp:ScriptReference Path="~/Styles/plugins/metismenu/metisMenu.min.js" />
                    <asp:ScriptReference Path="~/Styles/plugins/pace-js/pace.min.js" />
                    <asp:ScriptReference Path="~/Styles/plugins/validationEngine/jquery.validationEngine.js" />
                    <asp:ScriptReference Path="~/Styles/plugins/validationEngine/jquery.validationEngine-vi-VN.js" />
                    <asp:ScriptReference Path="~/Styles/js/latinise.js" />
                    <asp:ScriptReference Path="~/Styles/js/app.js" />
                    <asp:ScriptReference Path="~/Styles/js/main.js" />
                </Scripts>
            </CompositeScript>
        </asp:ScriptManager>

        <SweetSoft:ExtraScriptRegister runat="server" ID="scriptRegister"></SweetSoft:ExtraScriptRegister>
        <input type="file" id="fileAvatar" data-selector="fileAvatar" accept="image/*" class="hidden d-none">
        <input runat="server" id="hdfFolderKey" data-selector="hdfFolderKey" type="hidden" />
        <input type="hidden" runat="server" id="hdfCSRF" data-selector="hdfCSRF" />
        <a data-selector="btnRefreshUser" id="btnRefreshUser" runat="server" onserverclick="btnRefreshUser_ServerClick"></a>
        <!-- Begin page -->
        <div class="wrapperBgPage" style='background-image: url(<%= GetRelativeClientPath("/Styles/images/background.png") %>)'></div>
        <div class="layout-wrapper" id="layout-wrapper">
            <div class="layout-content">
                <!-- ============================================================== -->
                <!-- Start header content here -->
                <!-- ============================================================== -->
                <div class="wrapHeader">
                    <div class="contentHeader">
                        <div class="headerTop">
                            <div class="container-fluid">
                                <div class="wrapperContentTop">
                                    <div class="wrapBtnCtrMenuHeader d-block d-xl-none">
                                        <div class="btnCtrMenu"><i class='bx bx-menu'></i></div>
                                    </div>
                                    <div class="wrapLogoHeader">
                                        <a class="linkLogoHeader" href="<%= GetRelativeClientPath("/EmployeeDashboard") %>" title="Trang chủ">
                                            <img class="imgLogoHeader" src="<%=GetRelativeClientPath("/Styles/images/SweetSoft-logo-light.png") %>" alt="Trang chủ" />
                                        </a>
                                    </div>
                                    <div class="wrapCloseMenuHeaderMobile"></div>
                                    <div class="wrapMenuMainHeader">
                                        <div class="wrapMenuMainContentHeader">
                                            <div class="wrapperMenuTopMobile">
                                                <div class="wrapperBtncloseMobile">
                                                    <div class="icon">
                                                        <i class='mdi mdi-close-circle-outline'></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="wrapSearchMobile d-xl-none p-15 border-bottom d-none">
                                                <div class="input-group d-flex">
                                                    <input name="search-menu" class="form-control" type="text" placeholder="Tìm kiếm danh mục">
                                                    <a class="btn bg-primary" href="javascript:void(0);" type="button" id="button-addon2"><i class='bx bx-search'></i></a>
                                                </div>
                                            </div>
                                            <div class="wrapMenuHeader">
                                                <ul runat="server" id="itemTemplateBasic" visible="false" enableviewstate="false">
                                                    <li class="itemMenuHeader">
                                                        <a class="linkMenuHeader ps-0" href="{0}" title="{1}">
                                                            <span class="ms-1">{1}</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                                <ul runat="server" id="itemTemplateSingle" visible="false" enableviewstate="false">
                                                    <li class="itemMenuHeader">
                                                        <a class="linkMenuHeader" href="{0}" title="{1}">
                                                            <i class="{2} d-none"></i><span class="ms-1">{1}</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                                <ul runat="server" id="itemTemplateMulplite" visible="false" enableviewstate="false">
                                                    <li class="itemMenuHeader menuSub">
                                                        <a class="linkMenuHeader" href="javascript:;" role="button" title="{0}" id="menu-item-{3}">
                                                            <i class="{1}"></i><span class="ms-1">{0}</span>
                                                            <div class="btnDropdownMenuSub"><i class='bx bxs-chevron-down'></i></div>
                                                        </a>
                                                        <div class="wrapMenuHeader" aria-labelledby="menu-item-{3}">
                                                            <ul class="listMenuHeader">
                                                                {2}
                                                            </ul>
                                                        </div>
                                                    </li>
                                                </ul>
                                                <ul runat="server" id="itemTemplateSingleParent" visible="false" enableviewstate="false">
                                                    <li class="itemMenuHeader menuSub">
                                                        <a class="linkMenuHeader" href="{2}" role="button" title="{0}">
                                                            <i class="{1}"></i><span class="ms-1">{0}</span>
                                                        </a>
                                                        
                                                    </li>
                                                </ul>
                                                <ul class="listMenuHeader Rootmenu">
                                                    <%--<li class="itemMenuHeader"><a class="linkMenuHeader" href="<%= GetRelativeClientPath("/") %>" title="Bảng điều khiển">Bảng điều khiển<i class='bx bx-home'></i></a></li>--%>
                                                    <asp:Literal runat="server" ID="ltrMenu" EnableViewState="false"></asp:Literal>
                                                    <li class="btn-show-more d-none"><i class='bx bx-dots-vertical-rounded'></i></li>

                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <asp:UpdatePanel runat="server" ID="pnlInfo" UpdateMode="Conditional">
                                        <ContentTemplate>
                                            <div class="flex justify-content-center align-items-center">
                                                <ul runat="server" visible="false" class="flex justify-content-center align-items-center list-style-none mb-0 me-4">
                                                    <li class="dropdown dropdown-language">
                                                        <button class="btn dropdown-toggle d-block text-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <img runat="server" id="imgLanguage" src="/Administration/styles/images/flags/vi.jpg" alt="Header Language" height="16">
                                                        </button>
                                                        <ul class="dropdown-menu py-0" style="min-width: 50px;">
                                                            <asp:UpdatePanel runat="server" UpdateMode="Conditional">
                                                                <ContentTemplate>
                                                                    <asp:Repeater runat="server" ID="rptLanguages">
                                                                        <ItemTemplate>
                                                                            <li>
                                                                                <asp:LinkButton runat="server" ID="lbtChangeContentLanguage" CssClass="dropdown-item"
                                                                                    CommandName="change-language" CommandArgument='<%# Eval("LangId") %>'
                                                                                    OnCommand="lbtChangeContentLanguage_Command">
                                                                                    <img src='<%# Eval("ImageUrl") %>' alt='<%# Eval("Name") %>' height="16" />
                                                                                </asp:LinkButton>
                                                                            </li>
                                                                        </ItemTemplate>
                                                                    </asp:Repeater>
                                                                </ContentTemplate>
                                                            </asp:UpdatePanel>
                                                        </ul>
                                                    </li>
                                                </ul>
                                                 <div class="wrapperRight">
                                                     <%-- Notification center (giao diện và bộ lọc xử lý phía client). --%>
                                                     <div class="dropdown m-3" id="bellDropdownWrapper">
                                                         <a href="javascript:void(0)" class="dropdown-notification dropdown-toggle position-relative ignore"
                                                            id="bellToggle" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                                            aria-expanded="false" aria-label="Mở thông báo" title="Thông báo">
                                                             <i class="fas fa-bell font-size-22 text-warning" aria-hidden="true"></i>
                                                             <span id="badgeUnread" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                                                   style="display:none;font-size:10px;">0</span>
                                                         </a>
                                                         <div id="notificationViewBackdrop" class="qlda-noti-backdrop" aria-hidden="true"></div>
                                                         <div class="dropdown-menu dropdown-menu-end notification" aria-labelledby="bellToggle">
                                                             <div class="qlda-noti-surface">
                                                             <div class="qlda-noti-content">
                                                             <div class="qlda-noti-header">
                                                                 <div class="qlda-noti-heading">
                                                                     <div class="qlda-noti-heading-copy">
                                                                         <h6 class="qlda-noti-title">Thông báo</h6>
                                                                         <p class="qlda-noti-subtitle" id="notificationSubtitle">Đang kiểm tra thông báo...</p>
                                                                     </div>
                                                                     <div class="qlda-noti-actions" role="group" aria-label="Thao tác thông báo">
                                                                         <%-- Chỉ hiện hành động ngược với bộ lọc hiện tại. --%>
                                                                         <button type="button" id="btnToggleUnread" class="qlda-noti-switch" aria-pressed="false" title="Chỉ xem thông báo chưa đọc">
                                                                             <i id="notificationStatusToggleIcon" class="bx bx-filter-alt" aria-hidden="true"></i>
                                                                             <span id="notificationStatusToggleText">Chưa đọc</span>
                                                                         </button>
                                                                         <button type="button" id="btnMarkAllRead" class="qlda-noti-mark" style="display:none">
                                                                             <i class="bx bx-check-double me-1" aria-hidden="true"></i>Đọc tất cả
                                                                         </button>
                                                                         <button type="button" id="btnCloseNotificationExpanded" class="qlda-noti-close" aria-label="Đóng danh sách thông báo" title="Đóng cửa sổ thông báo">
                                                                             <i class="bx bx-x" aria-hidden="true"></i>
                                                                         </button>
                                                                     </div>
                                                                 </div>
                                                                 <div class="qlda-noti-tools">
                                                                     <div class="qlda-noti-filter-row">
                                                                         <div class="qlda-noti-view-picker" id="notificationViewPicker">
                                                                             <button type="button" id="btnNotificationView" class="qlda-noti-view-button" aria-label="Chọn chế độ xem thông báo" aria-haspopup="true" aria-expanded="false" aria-controls="notificationViewMenu" title="Chọn chế độ xem">
                                                                                 <i id="notificationViewIcon" class="bx bx-layout" aria-hidden="true"></i>
                                                                             </button>
                                                                             <div id="notificationViewMenu" class="qlda-noti-view-menu" role="menu" aria-label="Chế độ xem thông báo" hidden>
                                                                                 <div class="qlda-noti-view-menu-title">Kiểu hiển thị</div>
                                                                                 <button type="button" class="qlda-noti-view-option is-selected" data-view-mode="compact" role="menuitemradio" aria-checked="true">
                                                                                     <i class="bx bx-dock-right" aria-hidden="true"></i><span><strong>Thu gọn</strong><small>Bên phải, xem nhanh</small></span><i class="bx bx-check qlda-noti-view-check" aria-hidden="true"></i>
                                                                                 </button>
                                                                                 <button type="button" class="qlda-noti-view-option" data-view-mode="expanded" role="menuitemradio" aria-checked="false">
                                                                                     <i class="bx bx-expand-alt" aria-hidden="true"></i><span><strong>Xem rộng</strong><small>Giữa màn hình, dễ đọc</small></span><i class="bx bx-check qlda-noti-view-check" aria-hidden="true"></i>
                                                                                 </button>
                                                                             </div>
                                                                         </div>
                                                                         <div class="qlda-noti-type-wrap">
                                                                             <i class="bx bx-filter-alt qlda-noti-filter-icon" aria-hidden="true"></i>
                                                                             <select id="notificationTypeFilter" class="qlda-noti-type" aria-label="Lọc theo loại thông báo">
                                                                                 <option value="all">Mọi loại</option>
                                                                                 <option value="CONG_VIEC">Công việc</option>
                                                                                 <option value="DU_AN">Dự án</option>
                                                                                 <option value="LICH_HOP">Lịch họp</option>
                                                                                 <option value="VAN_DE">Vấn đề</option>
                                                                                 <option value="TAI_LIEU">Tài liệu</option>
                                                                                 <option value="HE_THONG">Hệ thống</option>
                                                                                 <option value="other">Loại khác</option>
                                                                             </select>
                                                                             <i class="bx bx-chevron-down qlda-noti-chevron" aria-hidden="true"></i>
                                                                         </div>
                                                                         <div class="qlda-noti-type-wrap qlda-noti-time-wrap">
                                                                             <i class="bx bx-calendar qlda-noti-filter-icon" aria-hidden="true"></i>
                                                                             <select id="notificationDateFilter" class="qlda-noti-type" aria-label="Lọc thông báo theo khoảng thời gian">
                                                                                 <option value="all">Toàn bộ</option>
                                                                                 <option value="week">Tuần này</option>
                                                                                 <option value="month">Tháng này</option>
                                                                             </select>
                                                                             <i class="bx bx-chevron-down qlda-noti-chevron" aria-hidden="true"></i>
                                                                         </div>
                                                                     </div>
                                                                 </div>
                                                             </div>
                                                             <div class="notification-body" id="notificationList" role="region" aria-label="Danh sách thông báo">
                                                                 <div class="qlda-noti-empty"><div class="qlda-noti-empty-icon"><i class="bx bx-bell-off"></i></div>
                                                                     <strong>Chưa có thông báo</strong><span>Thông báo mới sẽ xuất hiện tại đây.</span>
                                                                 </div>
                                                             </div>
                                                             <div class="qlda-noti-footer" id="notificationFooter" style="display:none">
                                                                 <button type="button" id="btnLoadMore" class="qlda-noti-more">
                                                                     <span id="btnLoadMoreText">Xem thêm thông báo</span>
                                                                     <span id="btnLoadMoreSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none" aria-hidden="true"></span>
                                                                     <i class="bx bx-chevron-down" aria-hidden="true"></i>
                                                                 </button>
                                                                 <div class="qlda-noti-filter-note" id="notificationFilterNote" style="display:none">Bộ lọc chỉ áp dụng cho thông báo đã tải.</div>
                                                             </div>
                                                             </div>
                                                             </div>
