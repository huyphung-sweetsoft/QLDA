<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterTemplate.master.cs" Inherits="SweetSoft.QLDA.BackOffice.MasterPages.MasterTemplate" %>

<%--//-----------------------PROGRAMER LOGS-----------------------------%>
<%--
    Change 01: 18 Oct 2024, Doan - Task 1208486512936003: UI/UX Customization options
--%>
<%@ Import Namespace="SweetSoft.QLDA.Core.Infrastructure" %>
<%@ Import Namespace="SweetSoft.QLDA.Core.Helpers" %>
<%@ Import Namespace="SweetSoft.QLDA.Core.ResourceTexts" %>

<!DOCTYPE html>
<!--
This is a starter template page. Use this page to start your new project from
scratch. This page gets rid of all links and provides the needed markup only.
-->
<html lang="<%= SweetContext.Current.CurrentLanguageCode.Substring(0,2) %>">
<head id="Head1" runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="shortcut icon" href="/favicon.ico">
    <asp:PlaceHolder runat="server">
        <script type="text/javascript">
            var timerStart = Date.now();
            var CMSMasterJs = {
                get HostPath() {
                    return window.location.origin;
                }
            };
            CMSMasterJs.InitNotify = () => {
                if (typeof toastr !== 'undefined') {
                    toastr.options = {
                        'closeButton': true,
                        'debug': false,
                        'newestOnTop': false,
                        'progressBar': false,
                        'positionClass': 'toast-bottom-right',
                        'preventDuplicates': false,
                        'showDuration': '1000',
                        'hideDuration': '1000',
                        'timeOut': '5000',
                        'extendedTimeOut': '1000',
                        'showEasing': 'swing',
                        'hideEasing': 'linear',
                        'showMethod': 'fadeIn',
                        'hideMethod': 'fadeOut',
                    }
                }
            }
            CMSMasterJs.InitNotify();
            var $title = '<%= GetResourceText(BackEndResourceKeys.NOTIFICATION)%>';
            (() => {
                let notifyTimeout;

                CMSMasterJs.ShowNotify = ($message, $type) => {
                    if (!$message || typeof (toastr) === 'undefined')
                        return;

                    if (notifyTimeout) clearTimeout(notifyTimeout);

                    notifyTimeout = setTimeout(() => {
                        toastr.clear();
                        switch ($type) {
                            case 'danger':
                            case 'error':
                                toastr.error($message);
                                break;
                            case 'warning':
                                toastr.warning($message);
                                break;
                            case 'success':
                                toastr.success($message);
                                break;
                            default:
                                toastr.info($message);
                                break;
                        }
                    }, 300);
                };
            })();
        </script>
    </asp:PlaceHolder>

    <%-- Tell the browser to be responsive to screen width --%>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta id="MetaDescription" name="description" content="System Management - Control Panel" />
    <meta id="MetaKeywords" name="keywords" content="System Management - Control Panel" />
    <link id="ImageLink" rel="/styles/images/image-share.png" type="image/jpg" href="/styles/images/image-share.png" />
    <meta name="theme-color" content="#4a1387" />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="System Management - Control Panel">
    <meta property="og:description" content="System Management - Control Panel">
    <meta property="og:image" content="/styles/images/image-share.png">
    <meta property="og:type" content='website' />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="/styles/images/image-share.png">
    <meta name="twitter:title" content="System Management - Control Panel">
    <meta name="twitter:description" content="System Management - Control Panel">
    <meta name="twitter:image" content="/styles/images/image-share.png">

    <!-- Author -->
