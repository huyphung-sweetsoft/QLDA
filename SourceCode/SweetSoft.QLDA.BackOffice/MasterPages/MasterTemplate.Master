                                                    <div class="avatar__image-box flex-center gap-2 cursor-pointer" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <div class="avatar__image">
                                                            <div class="wrapImgResize imgSquare rounded-circle">
                                                                <img runat="server" id="imgAvatar" />
