<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="SubSonicService" type="SubSonic.SubSonicSection, SubSonic" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="SweetSoft.QLDA.BackOffice"
         connectionString="Data Source=LAPTOP-JB85BBR8\SQLEXPRESS;Initial Catalog=SweetSoft_QLDA3;Integrated Security=True;TrustServerCertificate=True" />
  </connectionStrings>
  <SubSonicService defaultProvider="DataAccessProvider">
    <providers>
      <clear />
      <add name="DataAccessProvider"
           type="SubSonic.SqlDataProvider, SubSonic"
           connectionStringName="SweetSoft.QLDA.BackOffice"
           generatedNamespace="SweetSoft.QLDA.DataAccess"
           generateLazyLoads="true" />
    </providers>
  </SubSonicService>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
